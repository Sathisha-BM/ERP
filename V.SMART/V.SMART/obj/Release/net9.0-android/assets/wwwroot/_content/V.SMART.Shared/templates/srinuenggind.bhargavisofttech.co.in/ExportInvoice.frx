  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
 public class ReportScript
 {
  // =========================================================
  // AMOUNT TO WORDS
  // =========================================================

  public static string AmountToWords(decimal amount, string currency)
  {
   long wholePart = (long)Math.Truncate(amount);

   int decimalPart = (int)Math.Round(
    (amount - wholePart) * 100
    );

   // Handle rounding
   if (decimalPart == 100)
   {
    wholePart++;
    decimalPart = 0;
   }

   string currencyName = currency ?? &quot;&quot;;

   currencyName = currencyName.Trim().ToLower();

   string wholeText = NumberToWords(wholePart);

   string result;

   // =====================================================
   // INDIAN RUPEE
   // =====================================================

   if (currencyName.Contains(&quot;rupee&quot;) ||
    currencyName.Contains(&quot;inr&quot;) ||
    currencyName == &quot;rs&quot; ||
    currencyName == &quot;₹&quot;)
   {
    result = wholeText + &quot; Rupees&quot;;

    if (decimalPart &gt; 0)
    {
     result += &quot; and &quot; +
      NumberToWords(decimalPart) +
      &quot; Paise&quot;;
    }
   }

    // =====================================================
    // EURO
    // =====================================================

   else if (currencyName.Contains(&quot;euro&quot;) ||
    currencyName.Contains(&quot;eur&quot;))
   {
    result = wholeText + &quot; Euros&quot;;

    if (decimalPart &gt; 0)
    {
     result += &quot; and &quot; +
      NumberToWords(decimalPart) +
      &quot; Cents&quot;;
    }
   }

    // =====================================================
    // US DOLLAR
    // =====================================================

   else if (currencyName.Contains(&quot;dollar&quot;) ||
    currencyName.Contains(&quot;usd&quot;))
   {
    result = wholeText + &quot; Dollars&quot;;

    if (decimalPart &gt; 0)
    {
     result += &quot; and &quot; +
      NumberToWords(decimalPart) +
      &quot; Cents&quot;;
    }
   }

    // =====================================================
    // POUND
    // =====================================================

   else if (currencyName.Contains(&quot;pound&quot;) ||
    currencyName.Contains(&quot;gbp&quot;))
   {
    result = wholeText + &quot; Pounds&quot;;

    if (decimalPart &gt; 0)
    {
     result += &quot; and &quot; +
      NumberToWords(decimalPart) +
      &quot; Pence&quot;;
    }
   }

    // =====================================================
    // YEN
    // =====================================================

   else if (currencyName.Contains(&quot;yen&quot;) ||
    currencyName.Contains(&quot;jpy&quot;))
   {
    result = wholeText + &quot; Yen&quot;;
   }

    // =====================================================
    // DEFAULT
    // =====================================================

   else
   {
    result = wholeText + &quot; &quot; + currency;

    if (decimalPart &gt; 0)
    {
     result += &quot; and &quot; +
      NumberToWords(decimalPart) +
      &quot; Cents&quot;;
    }
   }

   return result + &quot; Only&quot;;
  }


  // =========================================================
  // NUMBER TO WORDS
  // =========================================================

  public static string NumberToWords(long number)
  {
   if (number == 0)
    return &quot;Zero&quot;;

   if (number &lt; 0)
    return &quot;Minus &quot; + NumberToWords(Math.Abs(number));

   string[] units =
    {
    &quot;&quot;,
    &quot;One&quot;,
    &quot;Two&quot;,
    &quot;Three&quot;,
    &quot;Four&quot;,
    &quot;Five&quot;,
    &quot;Six&quot;,
    &quot;Seven&quot;,
    &quot;Eight&quot;,
    &quot;Nine&quot;,
    &quot;Ten&quot;,
    &quot;Eleven&quot;,
    &quot;Twelve&quot;,
    &quot;Thirteen&quot;,
    &quot;Fourteen&quot;,
    &quot;Fifteen&quot;,
    &quot;Sixteen&quot;,
    &quot;Seventeen&quot;,
    &quot;Eighteen&quot;,
    &quot;Nineteen&quot;
    };

   string[] tens =
    {
    &quot;&quot;,
    &quot;&quot;,
    &quot;Twenty&quot;,
    &quot;Thirty&quot;,
    &quot;Forty&quot;,
    &quot;Fifty&quot;,
    &quot;Sixty&quot;,
    &quot;Seventy&quot;,
    &quot;Eighty&quot;,
    &quot;Ninety&quot;
    };

   // 1 - 19
   if (number &lt; 20)
    return units[number];

   // 20 - 99
   if (number &lt; 100)
   {
    return tens[number / 10] +
     ((number % 10 &gt; 0)
     ? &quot; &quot; + units[number % 10]
     : &quot;&quot;);
   }

   // 100 - 999
   if (number &lt; 1000)
   {
    return units[number / 100] +
     &quot; Hundred&quot; +
     ((number % 100 &gt; 0)
     ? &quot; &quot; + NumberToWords(number % 100)
     : &quot;&quot;);
   }

   // Thousand
   if (number &lt; 100000)
   {
    return NumberToWords(number / 1000) +
     &quot; Thousand&quot; +
     ((number % 1000 &gt; 0)
     ? &quot; &quot; + NumberToWords(number % 1000)
     : &quot;&quot;);
   }

   // Lakh
   if (number &lt; 10000000)
   {
    return NumberToWords(number / 100000) +
     &quot; Lakh&quot; +
     ((number % 100000 &gt; 0)
     ? &quot; &quot; + NumberToWords(number % 100000)
     : &quot;&quot;);
   }

   // Crore
   return NumberToWords(number / 10000000) +
    &quot; Crore&quot; +
    ((number % 10000000 &gt; 0)
    ? &quot; &quot; + NumberToWords(number % 10000000)
    : &quot;&quot;);
  }
 }
}</ScriptText>
