    RenderFragment RenderMenu(CustomScreenSettingVM menu) => builder =>
    {
        // Screen
        if (menu.ScreenId > 0)
        {
            builder.OpenComponent<MudNavLink>(0);
            builder.AddAttribute(1, "Href", menu.Navigation);
            builder.AddAttribute(2, "Match", NavLinkMatch.Prefix);

            if (!string.IsNullOrWhiteSpace(menu.Icon))
                builder.AddAttribute(3, "Icon", Icons.Material.Filled.Description);

            builder.AddAttribute(4, "ChildContent",
                (RenderFragment)(b =>
                {
                    b.AddContent(0, menu.Header);
                }));

            builder.CloseComponent();
            return;
        }

        // Folder / Module
        builder.OpenComponent<MudNavGroup>(10);

        builder.AddAttribute(11, "Title", menu.Header);
        builder.AddAttribute(12, "Expanded", false);
        builder.AddAttribute(13, "Icon", GetMudIcon(menu.Icon));

        builder.AddAttribute(14, "ChildContent",
            (RenderFragment)((childBuilder) =>
            {
                foreach (var child in menu.Children.OrderBy(x => x.Header))
                {
                    childBuilder.AddContent(0, RenderMenu(child));
                }
            }));

        builder.CloseComponent();
    };

