    private readonly SemaphoreSlim _navigationLock = new(1, 1);

    private bool _navigationLoaded;

    private DotNetObjectReference<NavMenu>? _dotNetHelper;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await _navigationLock.WaitAsync();

        try
        {
            if (_navigationLoaded)
                return;


            IsRequired = await MfgQuotationService.BatchNoOption();
            NavigationMenus =await _CustomScreenService.GetNavigationMenuAsync();

            _navigationLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Navigation loading failed: {ex}");

            return;
        }
        finally
        {
            _navigationLock.Release();
        }


        try
        {
            await InvokeAsync(StateHasChanged);

            _dotNetHelper = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "registerNavOutsideClick",
                _dotNetHelper);

            await JS.InvokeVoidAsync(
                "registerScrollHandler",
                _dotNetHelper);
        }
        catch (JSDisconnectedException)
        {
            // Blazor circuit disconnected
        }
        catch (InvalidOperationException)
        {
            // JS interop unavailable
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Navigation JavaScript initialization failed: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task CloseFlyout()
    {
        if (_activeFlyout == null)
            return;

        _activeFlyout = null;

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnScroll()
    {
        if (_activeFlyout == null)
            return;

        _activeFlyout = null;

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "unregisterNavOutsideClick");
        }
        catch
        {
            // Ignore - circuit/JS may already be unavailable
        }

        try
        {
            await JS.InvokeVoidAsync(
                "unregisterScrollHandler");
        }
        catch
        {
            // Ignore - circuit/JS may already be unavailable
        }

        _dotNetHelper?.Dispose();
        _dotNetHelper = null;
    }
