@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider

@inject IMfgQuotationService MfgQuotationService
@inject IJSRuntime JS
@inject UserSession session
@inject ICustomScreenSettingService _CustomScreenService

<div class="vs-nav-shell">

    @if (!DrawerOpen)
    {
        <!-- ══════════════════════════════
        MINI SIDEBAR
        ══════════════════════════════ -->
        <div class="vs-mini-nav">


            @if (!ShowProductionMenu)
            {
                <!-- Home -->
                <div class="vs-mini-item">

                    <button class="vs-mini-btn @(IsActive("/") ? "vs-mini-btn--active" : "")"
                            title="Home"
                            @onclick='() => Navigate("/")'>

                        <MudIcon Icon="@Icons.Material.Filled.Home"
                                 Size="Size.Small" />

                    </button>

                </div>
            }

            <AuthorizeView Roles="Administrator,ERPAdmin,User">

                <Authorized>

                    @if (NavigationMenus == null || !NavigationMenus.Any())//only if condion for checking custom setting is not applied then show default menu 07082026
                    {
                        @if (ShowProductionMenu)
                        {
                            <div class="vs-mini-item">

                                <button class="vs-mini-btn   @(IsActive("/productionLogList") ? "vs-mini-btn--active" : "")"
                                        title="Daily Production Log"
                                        @onclick='() => Navigate("/productionLogList/true")'>

                                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" />

                                </button>

                            </div>
                        }
                        else
                        {
                            <!-- Groups -->
                            @foreach (var group in NavGroups)
                            {
                                var g = group;

                                <div class="vs-mini-item">

                                    <button class="vs-mini-btn
                                       @(_activeFlyout == g.Key
                                                                       ? "vs-mini-btn--open"
                                                                       : "")
                                       @(g.Value.Items.Any(x => IsActive(x.Href))
                                                                       ? "vs-mini-btn--active"
                                                                       : "")"
                                            title="@g.Key"
                                            @onclick="() => ToggleFlyout(g.Key)"
                                            @onclick:stopPropagation>

                                        <MudIcon Icon="@g.Value.MudIcon"
                                                 Size="Size.Small" />

                                    </button>

                                    @if (_activeFlyout == g.Key)
                                    {
                                        <div class="vs-flyout"
                                             @onclick:stopPropagation>

                                            <div class="vs-flyout-title">
                                                @g.Key
                                            </div>

                                            @foreach (var item in g.Value.Items)
                                            {
                                                var i = item;

                                                <a class="vs-flyout-item
                                                      @(IsActive(i.Href)
                                                    ? "vs-flyout-item--active"
                                                    : "")"
                                                   @onclick:preventDefault
                                                   @onclick="() => NavigateAndClose(i.Href)">

                                                    @i.Label

                                                </a>
                                                }

                                        </div>
                                    }

                                </div>
                            }

                        }
                    }
                   

                </Authorized>

            </AuthorizeView>

            <!-- Expand Button -->
            <div class="vs-mini-item vs-mini-dots-wrap">

                <button class="vs-mini-btn vs-mini-btn--dots"
                        title="Expand menu"
                        @onclick="ToggleDrawer">

                    <MudIcon Icon="@Icons.Material.Filled.MoreVert"
                             Size="Size.Small" />

                </button>

            </div>

        </div>
    }
    else
