                        x.ClassId == 2)
                    .ToListAsync();
            }

            if (res == null || !res.Any())
                return;
            if (res != null && res.Any())
            {
                foreach (var itemSub in res)
                {
                    await _unitOfWork.ItemSubs.DeleteAsync(itemSub);
                }

            }
            await _unitOfWork.SaveAsync();

            excelData.Clear();
            processedRows.Clear();
            StateHasChanged();
            await _js.ToastrSuccess("Item Assign deleted successfully.");
        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(ex, $"confirmDelete_Click failed for action");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
        finally
        {
            isProcessing = false;
        }
    

    }
    private void EditRow(ExcelRowData row)
    {
        editingRow = row;
    }
    private void CancelEdit(ExcelRowData row)
    {
        editingRow = null;
    }
    private async Task SaveRowAsync(ExcelRowData row)
    {
        try
        {
            if (!row.Data.TryGetValue(Clean("Id"), out var idValue) ||
                !int.TryParse(idValue, out var itemSubId))
            {
                await _js.ToastrError("ItemSub ID not found.");
                return;
            }

            if (!row.Data.TryGetValue(Clean("Price"), out var priceValue) ||
                !decimal.TryParse(priceValue, out var price))
            {
                await _js.ToastrError("Please enter a valid price.");
                return;
            }

            // Get the existing tracked entity
            var itemSub = await _unitOfWork.ItemSubs
                .GetQueryable()
                .FirstOrDefaultAsync(x => x.Id == itemSubId);

            if (itemSub == null)
            {
                await _js.ToastrError("Item assignment not found.");
                return;
            }

            // Update only the required fields
            itemSub.Rate = price;
            itemSub.ModifiedBy = createdBy;
            itemSub.ModifiedDate = DateTime.Now;

            // Because this entity was loaded from the same DbContext,
            // don't create another ItemSub object.
            await _unitOfWork.ItemSubs.UpdateAsync(itemSub);
            await _unitOfWork.SaveAsync();
            editingRow = null;

            await _js.ToastrSuccess("Item assignment updated successfully.");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(
                ex,
                "Error while updating ItemAssign");

            await _js.ToastrError(
                "Failed to update item assignment.");
        }
    }
    private async Task RemoveRowAsync(ExcelRowData row)
    {
        try
        {
           
            if (!row.Data.TryGetValue(
                    Clean("Id"),
                    out var idValue) ||
                !int.TryParse(idValue, out var itemSubId))
            {
                await _js.ToastrError("ItemSub ID not found.");
                return;
            }

            await _unitOfWork.ItemSubs.DeleteAsync(itemSubId);
            await _unitOfWork.SaveAsync();
            processedRows.Remove(row);

            
            for (int i = 0; i < processedRows.Count; i++)
            {
                processedRows[i].Data[Clean("SlNo")] =
                    (i + 1).ToString();
            }

            if (_selectedCategory == 1)
            {
                OnCustomerChanged();
            }
            else if (_selectedCategory == 2)
            {
                OnVendorChanged();
            }



            await _js.ToastrSuccess(
                "Item assignment deleted successfully.");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(
                ex,
                "Error while deleting ItemAssign");

            await _js.ToastrError(
                "Failed to delete item assignment.");
        }
    }

    private string GetPrice(ExcelRowData row)
    {
        var key = Clean("Price");

        return row.Data.TryGetValue(key, out var value)
            ? value
            : "";
      
    }

    private void SetPrice(ExcelRowData row, string value)
    {
        row.Data[Clean("Price")] = value;
    }
    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(SearchText))
        {
            processedRows = allProcessedRows
                .Select((row, index) =>
                {
                    row.Data[Clean("SlNo")] = (index + 1).ToString();
                    return row;
                })
                .ToList();

            return;
        }

        processedRows = allProcessedRows
            .Where(row =>
                row.Data.Any(x =>
                    x.Value.Contains(
                        SearchText,
                        StringComparison.OrdinalIgnoreCase)))
            .Select((row, index) =>
            {
                row.Data[Clean("SlNo")] = (index + 1).ToString();
                return row;
            })
            .ToList();
    }
