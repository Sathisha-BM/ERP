    private async Task<IEnumerable<CustomerVM>> SearchCustomers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Customers;

        var result = Customers.Where(c =>
            c.CustName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            (c.GSTNo != null &&
             c.GSTNo.Contains(value, StringComparison.OrdinalIgnoreCase)));

        return result;
    }
    private async Task<IEnumerable<VendorVM>> SearchVendor(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Vendors;

        var result = Vendors.Where(c =>
            c.VendorName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            (c.GSTNo != null &&
             c.GSTNo.Contains(value, StringComparison.OrdinalIgnoreCase)));

        return result;
    }
