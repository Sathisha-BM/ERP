    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {

                case "Save":
                    await confirmUpsert_Click(isConfirmed);
                    break;

                case "Delete":
                    await confirmDelete_Click(isConfirmed);
                    break;
               
                case "Print":
                    await confirmPrint_Click(isConfirmed);
                    break;
                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }
    private async Task confirmPrint_Click(bool isConfirmed)
    {
        try
        {
            isProcessing = true;
            await _js.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirmed) return;


            List<Dictionary<string, object>> exportData = new();
            if (processedRows != null
                   && processedRows.Any())
            {
                exportData = GetExportData(
                processedRows.ToList());
            }
            if (!exportData.Any())
                return;

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "Item_Assign", "Item Assign Print");

            var base64 = Convert.ToBase64String(bytes);

            await _js.DownloadExcelAsync(base64, "Item_Assign.xlsx");
        }
        catch (Exception ex)
        {

            throw;
        }
        finally
        {
            isProcessing = false;
        }
    }
    private List<Dictionary<string, object>> GetExportData(
      List<ExcelRowData> data)
    {
        return data.Select(row =>
        {
            var dict = new Dictionary<string, object>();
            if (_selectedCategory == 1)
            {
                dict["Customer"] = SelectedCustomerVM?.CustName ?? "";
            }
            else if (_selectedCategory == 2)
            {
                dict["Vendor"] = SelectedVendorVM?.VendorName ?? "";
            }

            foreach (var header in headers)
            {
                var key = Clean(header);

                if (row.Data.ContainsKey(key))
                {
                    dict[header] = row.Data[key];
                }
                else
                {
                    dict[header] = "";
                }
            }

            return dict;
        }).ToList();
    }
    
