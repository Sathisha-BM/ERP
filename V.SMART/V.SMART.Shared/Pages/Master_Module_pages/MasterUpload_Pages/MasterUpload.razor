    private string GetValue(string columnName, List<string> rowData, Dictionary<string, int> columnIndex)
    {
        var key = Clean(columnName);

        if (columnIndex.TryGetValue(key, out int index))
        {
            if (index < rowData.Count)
                return rowData[index]?.Trim() ?? "";
        }

        return "";
    }

    private async Task ProcessExcelUploadAsync(IBrowserFile file)
    {
        try
        {
            if (file != null)
            {
                SelectedFileName = file.Name;

                using var stream = file.OpenReadStream(10_000_000);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                memoryStream.Position = 0;

                System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
                using var reader = ExcelReaderFactory.CreateReader(memoryStream);
                var result = reader.AsDataSet();

                // Filter out Sheet1 and Sheet2
                SheetNames = result.Tables
                    .Cast<DataTable>()
                    .Select(t => t.TableName)
                    .Where(name => !string.Equals(name, "Sheet1", StringComparison.OrdinalIgnoreCase) &&
                                   !string.Equals(name, "Sheet2", StringComparison.OrdinalIgnoreCase))
                    .ToList();

                // Auto-select sheet based on uploadType if none selected

                if (string.IsNullOrEmpty(SelectedSheet))
                {
                    SelectedSheet = SheetNames.FirstOrDefault(s =>
                        s.Equals("Sheet1", StringComparison.OrdinalIgnoreCase));

                }
                if (string.IsNullOrEmpty(SelectedSheet))
                {
                    await _js.ToastrError("No matching sheet found for selected upload type.");
                    return;
                }

                var table = result.Tables[SelectedSheet];

                headers = table.Rows[0].ItemArray.Select(x => x?.ToString()?.Trim() ?? "").ToList();

                Dictionary<string, int> columnIndex = headers.Select((name, index) => new { name, index })
                .ToDictionary(x => Clean(x.name), x => x.index);

                var normalizedHeaders = headers.Select(Clean).ToList();

                List<string> missingHeaders = uploadType switch
                {
                    "Customer" => CustomerPropertyHeaderMap
                                    .Where(h => !normalizedHeaders.Contains(Clean(h.Value))) // use .Value here
                                    .Select(h => h.Value) // return the header name
                                    .ToList(),

                    "Item" => ItemPropertyHeaderMap
                                    .Where(h => !normalizedHeaders.Contains(Clean(h.Value)))
                                    .Select(h => h.Value)
                                    .ToList(),

                    "Vendor" => VendorPropertyHeaderMap
                                    .Where(h => !normalizedHeaders.Contains(Clean(h.Value)))
                                    .Select(h => h.Value)
                                    .ToList(),
                    "Staff" => StaffPropertyHeaderMap
                                    .Where(h => !normalizedHeaders.Contains(Clean(h.Value)))
                                    .Select(h => h.Value)
                                    .ToList(),
                    "ItemAssign" => ItemAssignHeaderMap                                      //sbm
                   .Where(h => !normalizedHeaders.Contains(Clean(h.Value)))
                   .Select(h => h.Value)
                   .ToList(),
                    _ => new List<string>()
                };


                if (missingHeaders.Any())
                {
                    await _js.ToastrError($"Missing {uploadType} headers: {string.Join(", ", missingHeaders)}");
                    return;
                }

                excelData.Clear();
                itemSubs = null;
                processedRows.Clear();
                StateHasChanged();
                Isdelete = false;

                for (int i = 1; i < table.Rows.Count; i++)
                {
                    var row = table.Rows[i];
                    var rowData = row.ItemArray.Select(x => x?.ToString() ?? "").ToList();
                    excelData.Add(rowData);
                }
                if (excelData != null && excelData.Count > 0)
                {
                    int rowIndex = 0;
                    string createdBy = await _userService.GetUsernameAsync();
                    isDuplicate = false;
                    string gst = "", CurrName = "", type = "", hsn = "", catCode = "", sac = "";
                    int? rmId = null;



                    //Sathish
                    if (uploadType == "Item")
                    {
                        using var stream1 = file.OpenReadStream(50 * 1024 * 1024); // 50MB
                        using var memoryStream1 = new MemoryStream();
                        await stream1.CopyToAsync(memoryStream1);   // ✅ async copy
                        memoryStream1.Position = 0;                // ✅ VERY IMPORTANT
                        itemImagesMap = await _excelTemplateService.ExtractImagesFromExcelAsync(memoryStream1, SelectedSheet);
                    }

                    foreach (var data in excelData)
                    {
                        var row = new ExcelRowData { RowIndex = rowIndex };
                        // Extract values from data and store for debugging/highlighting
                        foreach (var key in columnIndex.Keys)
                            row.Data[key] = GetValue(key, data, columnIndex);

                        switch (uploadType)
                        {

                            case "Customer":

                                //GetCurrency and CurrId
                                CurrName = GetValue("Currency Name", data, columnIndex);
                                gst = GetValue("GST No.", data, columnIndex);
                                Currency existingCurrency = await EnsureCurrencyExists(CurrName.Trim());

                                async Task<Currency> EnsureCurrencyExists(string CurrName)
                                {
                                    if (string.IsNullOrWhiteSpace(CurrName))
                                        return null;

                                    var currency = await _unitOfWork.Currencyis.FirstOrDefaultAsync(r => r.CurrName == CurrName);

                                    if (currency == null)
                                    {
                                        currency = new Currency { CurrName = CurrName, CurrSub = ".", Symbol = "*" };
                                        await _unitOfWork.Currencyis.CreateAsync(currency);
                                        await _unitOfWork.SaveAsync();
                                        await _loggingService.LogUserAction(UserName: await _currentUserService.GetUsernameAsync(),
                                                Machine: _userService.MachineName,
                                                IP_Address: _userService.IpAddress,
                                                screen: "Master Upload",
                                                action: $"While Uploading Created Currency",
                                                additionalInfo: $"CurrencuName: {CurrName}");
                                    }

                                    return currency;
                                }

                                //Get StateName and StatId
                                string StateName = GetValue("StateName", data, columnIndex);
                                State existingState = await EnsureStateExists(StateName.Trim());

                                async Task<State> EnsureStateExists(string statename)
                                {
                                    if (string.IsNullOrWhiteSpace(statename.Trim()))
                                        return null;

                                    var state = await _unitOfWork.States.FirstOrDefaultAsync(s => s.StateName == statename.Trim());

                                    if (state == null)
                                    {
                                        state = new State { StateName = statename.Trim() };
                                        await _unitOfWork.States.CreateAsync(state);
                                        await _unitOfWork.SaveAsync();
                                        await _loggingService.LogUserAction(UserName: await _currentUserService.GetUsernameAsync(),
                                                Machine: _userService.MachineName,
                                                IP_Address: _userService.IpAddress,
                                                screen: "Master Upload",
                                                action: $"While Uploading Created StateName",
                                                additionalInfo: $"StateName: {statename}");
                                    }

                                    return state;
                                }

                                var customer = new Customer
                                {
                                    CustName = GetValue("CustomerName", data, columnIndex).Trim(),
                                    CustAddr = GetValue("CustomerAddress", data, columnIndex),
                                    BusiType = GetValue("BusinessType", data, columnIndex),
                                    GSTNo = gst,
                                    StateName = existingState.StateName,
                                    StateId = existingState?.StateCode ?? 0,
                                    PinCode = GetValue("PinCode", data, columnIndex),
                                    CurrId = existingCurrency?.CurrId ?? 1,
                                    Location = GetValue("Location", data, columnIndex),
                                    Distance = float.TryParse(GetValue("Distance", data, columnIndex), out float dist) ? dist : 0f,
                                    SupTyp = GetValue("Customer SupplyType", data, columnIndex),
                                    PANNo = !string.IsNullOrWhiteSpace(gst) && gst.Length == 15 ? gst.Substring(2, 10) : "",
                                    VendorCode = GetValue("VendorCode", data, columnIndex),
                                    ContactNo = GetValue("Contact No.", data, columnIndex),
                                    OpenBal = decimal.TryParse(GetValue("Opening Balance", data, columnIndex), out var ob) ? ob : 0m,
                                    Email = string.IsNullOrWhiteSpace(GetValue("Email", data, columnIndex)) ? "xyz@gmail.com" : GetValue("Email", data, columnIndex),
                                    Remark = GetValue("Remark", data, columnIndex),
                                    Scope = GetValue("Scope", data, columnIndex),
                                    BankDetails = GetValue("BankDetails", data, columnIndex),
                                    CreatedBy = createdBy,
                                    CreatedDate = DateTime.Now,
                                };


                                var validationContext = new ValidationContext(customer);
                                var results = new List<ValidationResult>();

                                if (!Validator.TryValidateObject(customer, validationContext, results, true))
                                {
                                    foreach (var error in results)
                                    {
                                        var member = error.MemberNames.FirstOrDefault();

                                        if (member != null && CustomerPropertyHeaderMap.ContainsKey(member))
                                        {
                                            var header = CustomerPropertyHeaderMap[member];
                                            row.Errors.Add($"{header}|{error.ErrorMessage}");
                                        }
                                        else
                                        {
                                            row.Errors.Add(error.ErrorMessage);
                                        }
                                    }
                                }

                                processedRows.Add(row);

                                if (row.Errors.Any())
                                    continue;

                                // isDuplicate = await _unitOfWork.Customers.ExistsByNameAsync("CustName", GetValue("CustomerName", data, columnIndex).Trim(), "CustId", null);
                                // if (isDuplicate)
                                // {
                                //     continue;
                                // }
                                // await _unitOfWork.Customers.CreateAsync(customer);
                                var customerName = GetValue(
                                    "CustomerName",
                                    data,
                                    columnIndex
                                )?.Trim();

                                if (string.IsNullOrWhiteSpace(customerName))
                                {
                                    row.Errors.Add("CustomerName|Customer Name is required");
                                    continue;
                                }

                                // Check database
                                isDuplicate = await _unitOfWork.Customers.ExistsByNameAsync(
                                    "CustName",
                                    customerName,
                                    "CustId",
                                    null);

                                if (isDuplicate)
                                {
                                    row.Errors.Add(
                                        $"CustomerName|Customer '{customerName}' already exists");

                                    continue;
                                }

                                // Create
                                await _unitOfWork.Customers.CreateAsync(customer);

                                // IMPORTANT
                                // Save immediately so the next Excel row can detect this customer
                                await _unitOfWork.SaveAsync();


                                break;

                            case "Item":

                                type = GetValue("Type", data, columnIndex);
                                catCode = GetValue("Category", data, columnIndex);
                                hsn = GetValue("HSN Code", data, columnIndex);
                                sac = GetValue("SAC Code", data, columnIndex).ToString();


                                var existingCategory = await EnsureCategoryExists(catCode.Trim());
                                var existingHSN = await EnsureHsnExists(hsn.Trim());
                                var existingSAC = await EnsureHsnExists(sac.Trim());

                                var rawMaterialName = GetValue("Material", data, columnIndex);

                                if (!string.IsNullOrEmpty(rawMaterialName))
                                {
                                    var existingRawMat = await EnsureRawMaterialExists(rawMaterialName.Trim());
                                    rmId = existingRawMat.RMId;
                                }
                                else
                                {
                                    rmId = null;
                                }


                                async Task<Category> EnsureCategoryExists(string Category)
                                {
                                    if (string.IsNullOrWhiteSpace(Category))
                                        return null;

                                    var cate = await _unitOfWork.Categories.FirstOrDefaultAsync(s => s.CategoryName == Category.Trim());

                                    if (cate == null)
                                    {
                                        cate = new Category { CategoryName = Category.Trim() };
                                        await _unitOfWork.Categories.CreateAsync(cate);
                                        await _unitOfWork.SaveAsync(); // Save changes
                                        await _loggingService.LogUserAction(UserName: await _currentUserService.GetUsernameAsync(),
                                                    Machine: _userService.MachineName,
                                                    IP_Address: _userService.IpAddress,
                                                    screen: "Master Upload",
                                                    action: $"While Uploading Created Category",
                                                    additionalInfo: $"CategoryName: {Category.Trim()}");
                                    }

                                    return cate;
                                }
                                async Task<HSNMaster> EnsureHsnExists(string HSN)
                                {
                                    if (string.IsNullOrWhiteSpace(HSN))
                                        return null;

                                    var code = await _unitOfWork.HSNMasters.FirstOrDefaultAsync(s => s.HSNcode == HSN.Trim());

                                    if (code == null && !string.IsNullOrWhiteSpace(HSN))
                                    {
                                        var trimmedHsn = HSN.Trim();

                                        code = new HSNMaster
                                        {

                                            HSNcode = trimmedHsn,
                                            HSNCategoryCode = trimmedHsn.Substring(0, 2),
                                            Required = false,
                                            HSNCategory = ""
                                        };

                                        await _unitOfWork.HSNMasters.CreateAsync(code);
