@page "/logout"
@using Microsoft.Extensions.Configuration
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IDBBackupSetting_Service
@using V.SMART.Shared.Services.Database_Backup

 @inject IConfiguration Configuration

@inject IDatabaseBackupService _backupService
 
@inject CurrentUserService currentUserService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager _nav
@inject ILoggingService LoggingService

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body flex-column">
                <div class="text-center">
                    <img src="/_content/V.SMART.Shared/images/logout.jpg" style="max-height: 5rem;" />
                </div>
                <div class="text-center mt-2">
                    <span class="text-danger fw-bolder">
                        You have successfully logged out.
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {


    // //10082026----------------------------------------------------------
    private bool IsDesktop => Configuration["AppEnvironment"] == "Desktop";
    // //-----------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // =====================================================
            // 1. DATABASE BACKUP
            // =====================================================
            if (IsDesktop)
            {
                try
                {
                    var backupResult = await _backupService.BackupAsync();

                    if (!backupResult.Success)
                    {
                        await LoggingService.LogDeveloperError(new Exception(backupResult.Message), "Database backup failed during user logout.");
                    }
                   
                }
                catch (Exception backupEx)
                {
                    // Backup failure should NOT prevent logout
                    await LoggingService.LogDeveloperError(backupEx, "Exception occurred during database backup on logout.");
                }
            }

            ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsLoggedOut();
            await LoggingService.LogUserAction(UserName: await currentUserService.GetUsernameAsync(), Machine: currentUserService.MachineName, IP_Address: currentUserService.IpAddress, screen: "User Logout", action: $"Log Out",
            additionalInfo: $"");

            _nav.NavigateTo("/login", true);
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the OnInitializedAsync() Method for User");
        }
    }

}

