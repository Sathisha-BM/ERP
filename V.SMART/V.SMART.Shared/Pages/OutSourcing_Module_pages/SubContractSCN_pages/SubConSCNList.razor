    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;


            var exportData = await subConSCNService.GetSubContractScnPendingList(selectedStatus);


            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "SubContractSCNExport", "SubContract SCN's Pending List");

            var base64 = Convert.ToBase64String(bytes);
            await _JS.DownloadExcelAsync(base64, "SubContractSCNExport.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (SubContractSCNExport)");
            await _JS.ToastrError("Error while exporting SubContractSCNExport!");
        }
        finally
        {
            isProcessing = false;
        }
    }
