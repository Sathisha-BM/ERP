@page "/subConScnList"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.ISubContractSCNService
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.SubContractViewModel
@using static V.SMART.Shared.Components.DetailsModal

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ExcelExportService ExcelExportService
@inject ISubConSCNService subConSCNService
@inject NavigationStateService NavigationState

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>
<DetailsModal Title="Subcontract GRN Details"
              Columns="@ProdReturnColumns"
              ColumnFields="@ProdReturnFields"
              HiddenColumns="@ProdReturnHiddenColumns"
              Data="@ProdReturnData"
              IsVisible="@IsProdreturnModalVisible"
              IsVisibleChanged="@((val) => IsProdreturnModalVisible = val)"
              SelectionValidation="SelectionValidationType.Vendor"
              OnSelectedItems="OnGRNSelectedAsync">
</DetailsModal>


<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="SubContract SCN List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@scnBreadcrumbs" />

            <div class="card-body p-4">

                <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>


                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select status of records">
                            <option value="">-- Select Status --</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Short Closed">Short Closed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                     
                        <div class="col-12 col-md-2 ms-md-auto text-end">
                            <button type="button" class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewDc">
                                <i class="bi bi-plus-square me-1"></i> Add New SCN
                            </button>
                        </div>
                    }

                </div>

                @if (SubConSCNVMs.Any())
                {
                    <div class="table-responsive">
                        <QuickGrid Items="SubConSCNVMs.AsQueryable()"
                                    Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Count(c => c.IsVisible) >= 1)
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            case "SCNId":
                                                <PropertyColumn Title="SCN ID" Property="@(c => c.SCNId)" />
                                                break;

                                            case "SCNNo":
                                                <PropertyColumn Title="SCN No" Property="@(c => c.SCNNo+c.Suffix)" Sortable="true" />
                                                break;

                                            case "SCNDate":
                                                <PropertyColumn Title="SCN Date" Property="@(c => c.SCNDate)" Format="dd/MM/yyyy" Sortable="true" />
                                                break;

                                            case "IssueStoreName":
                                                <PropertyColumn Title="Issue Store" Property="@(c => c.IssueStoreName)" />
                                                break;

                                            case "AddStoreName":
                                                <PropertyColumn Title="Add Store" Property="@(c => c.AddStoreName)" />
                                                break;

                                            case "CorrespondenceStatus":
                                                <TemplateColumn Title="Correspondence Status">
                                                    @if (UploadStatus.ContainsKey(context.SCNId) && UploadStatus[context.SCNId])
                                                    {
                                                        <span class="badge bg-success">Uploaded</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Not Uploaded</span>
                                                    }
                                                </TemplateColumn>
                                                break;


                                            case "MainRemark":
                                                <PropertyColumn Title="Main Remark" Property="@(c => c.MainRemark)" />
                                                break;

                                            case "Status":
                                                <TemplateColumn Title="SCN Status" Context="c">
                                                    @if (c.SCNCancel)
                                                    {
                                                        <span class="badge text-bg-danger bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-x-circle me-1"></i> Cancelled
                                                        </span>
                                                    }
                                                    else if (c.ShortClose)
                                                    {
                                                        <span class="badge text-bg-secondary bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-slash-circle me-1"></i> Short Closed
                                                        </span>
                                                    }
                                                    else if (c.SCNTally)
                                                    {
                                                        <span class="badge text-bg-success bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-check-circle me-1"></i> Completed
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-warning bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date" Property="@(c => c.ModifiedDate)" Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <PropertyColumn Title="SCN No" Property="@(c => c.SCNNo)" />
                                <PropertyColumn Title="SCN Date" Property="@(c => c.SCNDate)" Format="dd/MM/yyyy" />
                                <PropertyColumn Title="Vendor Name" Property="@(c => c.VendorName)" Sortable="true" />
                                <PropertyColumn Title="Issue Store" Property="@(c => c.IssueStoreName)" />
                                <PropertyColumn Title="Add Store" Property="@(c => c.AddStoreName)" />
                                <PropertyColumn Title="Main Remark" Property="@(c => c.MainRemark)" />
                            }

                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"DcSubConSCN/update/{c.SCNId}")"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Edit SCN">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }

                                    @if (CanView)
                                    {
                                        <a href="@($"SubconSCN/details/{c.SCNId}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }

                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete SCN"
                                                @onclick="() => HandleDelete(c)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>
                    </div>


                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">

                        <div class="container-fluid">

                            @* <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="fw-semibold small px-1">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>

                                <button class="btn btn-success btn-sm d-flex align-items-center ms-5"
                                        @onclick="HandleExport">

                                    <i class="bi bi-download me-1"></i>
                                    Export SCN's

                                </button>

                            </div> *@
                            <div class="d-flex align-items-center gap-2 justify-content-center  gap-2 flex-wrap">

                                <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="px-3 fw-semibold">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>
                                <!-- From Date -->
                                <div class="d-flex align-items-center gap-1">
                                    <label class="fw-semibold mb-0">From:</label>
                                    <input type="date" @bind="SCNFromDate"
                                           @bind:after="OnDateChanged"
                                           class="form-control form-control-sm" />
                                </div>

                                <!-- To Date -->
                                <div class="d-flex align-items-center gap-1">
                                    <label class="fw-semibold mb-0">To:</label>

                                    <input type="date" @bind="SCNToDate"
                                           @bind:after="OnDateChanged"
                                           class="form-control form-control-sm" />
                                </div>

                                <!-- Pending Details -->
                                <button type="button"
                                        class="btn btn-outline-warning btn-sm shadow-sm"
                                        @onclick="OpenGrnPendingDetails">
                                    <i class="bi bi-hourglass-split me-1"></i>
                                    Purchase GRN Pending Details
                                </button>

                            </div>

                        </div>

                    </div>

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}

@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Sub-Contract SCN";
    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteSCNId = 0;
    private string selectedStatus = "";
    private int screenCode{ get; set; }

    private List<SubConSCNVM> SubConSCNVMs = new();

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;
    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);
    public List<GridColumn> Columns { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    #endregion

    #region === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private DateTime SCNFromDate { get; set; } = DateTime.Today.Month >= 4
    ? new DateTime(DateTime.Today.Year, 4, 1)
    : new DateTime(DateTime.Today.Year - 1, 4, 1);

      private DateTime SCNToDate { get; set; } =
        DateTime.Today;
      private SubConSCNVM SubConSCNVM { get; set; } = new();
        private List<Dictionary<string, object>>? ProdReturnData;
        private bool IsProdreturnModalVisible = false;
            private VendorVM? SelectedVendor;
        private List<string> ProdReturnColumns = new()

             {
                 "Vendor","VendorCode","RefReturnSubId","ReturnNo", "ReturnDate","RCSubId", "RC No.","RC Dt.","POSubId", "PO No.","PO Dt.","ItemId", "ItemCode", "ItemName",
                 "MeasureUnit", "Qty","Unit Price","BalQty.","CostCenterId","ProjectNo"
             };

        private List<string> ProdReturnFields = new()
             {
                 "Vendor","VendorCode","RefReturnSubId", "ReturnNo", "ReturnDate", "RCSubId", "RCNo", "RCDt","POSubId", "PONo", "PODt", "ItemId" ,"ItemCode", "ItemName",
                 "MeasureUnit", "Qty","UnitPrice", "BalQty","CostCenterId" ,"ProjectNo"
             };

        private List<string> ProdReturnHiddenColumns = new() { "VendorCode", "RefReturnSubId", "RCSubId", "POSubId", "ItemId", "CostCenterId" };

    #endregion

    private List<PageHeader.BreadcrumbItem> scnBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "OutSourcing",Url="purchase-home" },
        new PageHeader.BreadcrumbItem { Text = "SubContract",Url="purchase-home" },
        new PageHeader.BreadcrumbItem { Text = "Store Credit Note (SCN)", IsLast = true }
    };

    private Dictionary<int, bool> UploadStatus = new();

    #region

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            screenCode = await subConSCNService.GetScreenCodeByScreenNameAsync(ScreenName);
            UserName = await CurrentUserService.GetUsernameAsync();

            //InstantSearch
            //Important : Deserialize Filter parameter from query string if exists
            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllProuctionAssySCNs();

            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);
            if (saved?.Any() == true)
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(s => s.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion

    #region === Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "SCN ID", Field = "SCNId", IsVisible = false },

                new() { Title = "SCN No", Field = "SCNNo", IsVisible = true },

                new() { Title = "SCN Date", Field = "SCNDate", IsVisible = true },

                new() { Title = "Issue Store", Field = "IssueStoreName", IsVisible = true },
                new() { Title = "Add Store", Field = "AddStoreName", IsVisible = true },

                new() { Title = "Correspondence Status", Field = "CorrespondenceStatus", IsVisible = false },
                
                new() { Title = "SCN Status", Field = "Status", IsVisible = true },

                new() { Title = "Main Remark", Field = "MainRemark", IsVisible = true },

                new() { Title = "Created By", Field = "CreatedBy", IsVisible = false },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = false },

                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }
            };


            if (!Hidden)
            {

            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }
    private void AddNewDc()
    {
        var returnUrl = Uri.EscapeDataString("DcSubConSCN/create/{id}");
        _navigation.NavigateTo($"/Vendor/Select?ReturnUrl={returnUrl}");
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for RouteCardList");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the ItemList HandleColumnChange() Method");
        }
    }

    #endregion

    #region === Data Loading ===

    private async Task LoadAllProuctionAssySCNs()
    {
        try
        {
           var result = await subConSCNService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            SubConSCNVMs = result.scnCompVMs;
            totalItems = result.TotalCount;
            //Sathish
            foreach (var item in SubConSCNVMs)
            {
                UploadStatus[item.SCNId] = await subConSCNService.IsDocumentUploaded(item.SCNId);
            }


        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading Production SCN Assembly");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region == PAGINATION ==

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllProuctionAssySCNs();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Production Assembly SCN");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllProuctionAssySCNs();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in Production Assembly SCN");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllProuctionAssySCNs();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in Production Assembly SCN");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllProuctionAssySCNs();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in Production Assembly SCN");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllProuctionAssySCNs();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in Production Assembly SCN");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllProuctionAssySCNs();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Production Assembly SCN page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion




    #region === Deletion Flow ===

    private async Task HandleDelete(SubConSCNVM sCNVM)
    {
        try
        {
            
            var totalQty = sCNVM.SubConSCNSubVMs.Sum(s => s.AccQty);
            var totalBalQty = sCNVM.SubConSCNSubVMs.Sum(s => s.BalQty);
            if ((totalQty != totalBalQty) || sCNVM.SCNTally)
            {
                await _JS.ToastrError("Oops! You can't delete this SCN because some items have already been processed.");
                return;

            }
            

            var (canDelete, message) = await subConSCNService.CanDeleteSubConSCNAsync(sCNVM.SCNId, screenCode, sCNVM.SCNNo);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }
            ModalTitle = "Are you sure you want to delete this SubCon SCN Component?";
            btnColor = "btn-danger";
            btnText = "Yes, Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            DeleteSCNId = sCNVM.SCNId;
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for SubCon  SCNId: {sCNVM.SCNId}");
            await _JS.ToastrError("Failed to initiate delete SubCon SCN Component.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed) return;

            var deleted = await subConSCNService.DeleteProdAssySCNBySCNIdAsync(DeleteSCNId, screenCode);
            if (deleted)
            {
                await _JS.ToastrSuccess("SubCon SCN Component deleted successfully.");
                await LoadAllProuctionAssySCNs();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("SubCon SCN Component could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting SubCon SCN Component SCNId: {DeleteSCNId}");
            await _JS.ToastrError("Failed to delete SubCon SCN Component.");
        }
        finally
        {
            DeleteSCNId = 0;
            isProcessing = false ;
        }
    }

