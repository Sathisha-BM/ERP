    private async Task OnGRNSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (SubConSCNVM.SubConSCNSubVMs == null)
            SubConSCNVM.SubConSCNSubVMs = new List<SubConSCNSubVM>();

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .Distinct()
                .ToList();

            int storeId = SubConSCNVM.IssueStoreId ?? 0;

            var storeStock = await _unitOfWork.StockAdds.GetQueryable()
                .Where(s => s.StoreId == storeId && itemIds.Contains(s.ItemId))
                .GroupBy(s => s.ItemId)
                .Select(g => new
                {
                    ItemId = g.Key,
                    StockQty = g.Sum(x => x.BalQty)
                })
                .ToDictionaryAsync(x => x.ItemId, x => x.StockQty);


            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefReturnSubId = item.ContainsKey("RefReturnSubId") && item["RefReturnSubId"] != null
                    ? Convert.ToInt32(item["RefReturnSubId"])
                    : (int?)null;

                int? RefPoSubId = item.ContainsKey("POSubId") && item["POSubId"] != null
                    ? Convert.ToInt32(item["POSubId"])
                    : (int?)null;

                int? RefRcSubId = item.ContainsKey("RCSubId") && item["RCSubId"] != null
                    ? Convert.ToInt32(item["RCSubId"])
                    : (int?)null;

                if (SubConSCNVM.SubConSCNSubVMs
                    .Any(x => x.ItemId == itemId && x.RefGRNSubId == RefReturnSubId))
                    continue;

                decimal stockQty = storeStock.ContainsKey(itemId)
                    ? storeStock[itemId]
                    : 0;

                var subVm = new SubConSCNSubVM
                {
                    RefGRNSubId = RefReturnSubId,
                    RefGRNNo = item.ContainsKey("ReturnNo") ? item["ReturnNo"]?.ToString() : "",
                    RefGRNDate = item.ContainsKey("ReturnDate") && item["ReturnDate"] != null
                        ? Convert.ToDateTime(item["ReturnDate"])
                        : null,

                    RcSubId = RefRcSubId,
                    RefRcNo = item.ContainsKey("RCNo") ? item["RCNo"]?.ToString() : "",
                    RefRcDate = item.ContainsKey("RCDt") && item["RCDt"] != null
                        ? Convert.ToDateTime(item["RCDt"])
                        : null,

                    PoSubId = RefPoSubId,
                    RefPoNo = item.ContainsKey("PONo") ? item["PONo"]?.ToString() : "",
                    RefPoDate = item.ContainsKey("PODt") && item["PODt"] != null
                        ? Convert.ToDateTime(item["PODt"])
                        : null,

                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    MeasureUnit = item.ContainsKey("MeasureUnit") ? item["MeasureUnit"]?.ToString() : "",

                    AccQty = item.ContainsKey("BalQty") ? Convert.ToDecimal(item["BalQty"]) : 0,
                    BalQty = item.ContainsKey("BalQty") ? Convert.ToDecimal(item["BalQty"]) : 0,

                    UnitPrice = item.ContainsKey("UnitPrice") ? Convert.ToDecimal(item["UnitPrice"]) : 0,

                    StockQty = stockQty,

                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                            : (int?)null,
                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : "",

                    IsEditable = true
                };

                SubConSCNVM.SubConSCNSubVMs.Add(subVm);
            }

            int slNo = 1;
            foreach (var row in SubConSCNVM.SubConSCNSubVMs)
            {
                row.SlNo = slNo++;
            }

            SubConSCNVM.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            SubConSCNVM.SCNNo = await subConSCNService.GetSCNNumberAsync(SubConSCNVM.Suffix);

            var MapStoreForProdIssue = await subConSCNService.GetMappedStoreForFormAsync("SubConGRNForm");
            if (MapStoreForProdIssue.StoreId > 0)
            {
                SubConSCNVM.IssueStoreId = MapStoreForProdIssue.StoreId;
                SubConSCNVM.IssueStoreName = MapStoreForProdIssue.StoreName;
            }
            else
            {
                SubConSCNVM.IssueStoreId = null;
                SubConSCNVM.IssueStoreName = null;
            }

            var MapStoreFromProdAdd = await subConSCNService.GetMappedStoreForFormAsync("SubConSCNForm");
            if (MapStoreFromProdAdd.StoreId > 0)
            {
                SubConSCNVM.AddStoreId = MapStoreFromProdAdd.StoreId;
                SubConSCNVM.AddStoreName = MapStoreFromProdAdd.StoreName;
            }
            else
            {
                SubConSCNVM.AddStoreId = null;
                SubConSCNVM.AddStoreName = null;
            }
            int VendorCode = selectedItems
                   .Where(i => i.ContainsKey("VendorCode") && i["VendorCode"] != null)
                   .Select(i => Convert.ToInt32(i["VendorCode"]))
                   .FirstOrDefault(id => id > 0);
            SelectedVendor = await subConSCNService.GetVendorByIdAsync(VendorCode);
            if (SelectedVendor != null)
            {
                await ApplyVendorSelectionAsync(SelectedVendor);
            }


            StateHasChanged();
            NavigationState.Set("SubConSCN", SubConSCNVM);
            _navigation.NavigateTo(
                $"/DcSubConSCN/create/{SubConSCNVM.VendorCode}");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnProductionReturnSelectedAsync failed.");
            await _JS.ToastrError("Error processing selected items.");
        }
    }

    private async Task ApplyVendorSelectionAsync(VendorVM? vendor)
    {
        try
        {
            SelectedVendor = vendor;
            SubConSCNVM.VendorCode = vendor?.VendorCode ?? 0;
            SubConSCNVM.VendorName = vendor?.VendorName;
            SubConSCNVM.VendorAddress = vendor?.VendorAddress;
            SubConSCNVM.VendorContactNo = vendor?.ContactNo;

            if (vendor == null)
            {
                return;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyVendorSelectionAsync failed for VendorCode: {vendor?.VendorCode}");
            await _JS.ToastrError("Failed to apply vendor selection. Please try again.");
        }
    }
