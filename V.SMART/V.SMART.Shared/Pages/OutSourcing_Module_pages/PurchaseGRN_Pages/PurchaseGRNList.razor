    private async Task OnPoSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        try
        {
            if (PurchaseGRNVM.PurchaseGRNSubVMs == null)
                PurchaseGRNVM.PurchaseGRNSubVMs = new List<PurchaseGRNSubVM>();
            var MapStoreForDc = await purchaseGrnService.GetMappedStoreForFormAsync("GRNForm");

            if (MapStoreForDc.StoreId > 0)
            {
                PurchaseGRNVM.AddStoreId = MapStoreForDc.StoreId;
                PurchaseGRNVM.StoreName = MapStoreForDc.StoreName;
            }
            if (PurchaseGRNVM.AddStoreId == null || PurchaseGRNVM.AddStoreId.Value == 0)
            {
                await _JS.ToastrWarning("Please select Purchase Store before loading PO items.");
                return;
            }
            PurchaseGRNVM.VendorCode = selectedItems
                     .Where(i => i.ContainsKey("VendorCode") && i["VendorCode"] != null)
                     .Select(i => Convert.ToInt32(i["VendorCode"]))
                     .FirstOrDefault(id => id > 0);

            foreach (var item in selectedItems)
            {
                decimal GetDecimal(string key) =>
                    item.TryGetValue(key, out var val) &&
                    decimal.TryParse(Convert.ToString(val), out var result)
                        ? result
                        : 0;

                int? GetInt(string key) =>
                    item.TryGetValue(key, out var val) &&
                    int.TryParse(Convert.ToString(val), out var result)
                        ? result
                        : (int?)null;

                string GetString(string key) =>
                    item.TryGetValue(key, out var val)
                        ? Convert.ToString(val) ?? string.Empty
                        : string.Empty;

                DateTime? GetDate(string key) =>
                    item.TryGetValue(key, out var val) &&
                    DateTime.TryParse(Convert.ToString(val), out var result)
                        ? result
                        : (DateTime?)null;

                bool GetBoolFromYesNo(string key)
                {
                    if (!item.TryGetValue(key, out var val) || val == null)
                        return false;

                    return Convert.ToString(val)
                        .Trim()
                        .Equals("YES", StringComparison.OrdinalIgnoreCase);
                }

                int itemId = GetInt("ItemId") ?? 0;
                int? poSubId = GetInt("PoSubId");

                decimal qty = GetDecimal("Qty");
                decimal totalQty = GetDecimal("TotalQty");
                decimal lineGross = GetDecimal("LineGross");

                decimal subDiscPercent = GetDecimal("SubDiscPercent");
                decimal subDiscAmt = GetDecimal("SubDiscAmt");
                decimal mainDiscPercent = GetDecimal("MainDiscPercent");
                decimal mainDiscAmt = GetDecimal("MainDiscAmt");

                decimal packingPercent = GetDecimal("PackingPercent");
                decimal packingAmt = GetDecimal("PackingAmt");

                decimal insurancePercent = GetDecimal("InsurancePercent");
                decimal insuranceAmt = GetDecimal("InsuranceAmt");

                decimal freightAmt = GetDecimal("FreightAmt");
                decimal totalBasicAmt = GetDecimal("TotalBasicAmt");
                decimal todayVal = GetDecimal("TodayVal");
                decimal unitPrice = GetDecimal("UnitPrice");

                bool isOpenPo = GetBoolFromYesNo("IsOpenPo");

                decimal stockValue = !isOpenPo
                    ? CalculateLandedStockPrice(
                        qty, totalQty, lineGross,
                        subDiscPercent, subDiscAmt,
                        mainDiscPercent, mainDiscAmt,
                        packingPercent, packingAmt,
                        insurancePercent, insuranceAmt,
                        freightAmt, totalBasicAmt, todayVal)
                    : unitPrice;


                if (PurchaseGRNVM.PurchaseGRNSubVMs
                    .Any(x => x.ItemId == itemId && x.RefPoSubId == poSubId))
                    continue;

                var subVm = new PurchaseGRNSubVM
                {
                    RefPoSubId = poSubId,
                    RefPoNo = GetString("PoNo"),
                    RefPoDate = GetDate("PoDate"),

                    ItemId = itemId,
                    ItemCode = GetString("ItemCode"),
                    ItemName = GetString("ItemName"),
                    MeasureUnit = GetString("UOM"),
                    HSNCode = GetString("HSNCode"),
                    Category = GetString("CategoryName"),

                    DNQty = qty,
                    Qty = qty,
                    BalQty = qty,
                    POBalQty = qty,

                    UnitPrice = stockValue,
                    IsOpenPo = isOpenPo,

                    CostId = GetInt("CostCenterId"),
                    ProjectNo = GetString("ProjectNo"),
                    PoDueDate = GetDate("PoDuedate"),

                    IsEditable = true
                };

                PurchaseGRNVM.PurchaseGRNSubVMs.Add(subVm);
            }

            await ResetSlno();
            StateHasChanged();
            PurchaseGRNVM.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            PurchaseGRNVM.GRNNo = await purchaseGrnService.GetGRNnNumberAsync(PurchaseGRNVM.Suffix);


            NavigationState.Set("PurchaseGRN", PurchaseGRNVM);
            _navigation.NavigateTo(
                $"/purchaseGRN/create/{PurchaseGRNVM.VendorCode}");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
            await _JS.ToastrError("Error processing selected PO items.");
        }
    }
    private decimal CalculateLandedStockPrice(decimal qty, decimal totalQty, decimal itemBasicWithoutDisc, decimal subDiscPercent,
   decimal subDiscAmt, decimal mainDiscPercent, decimal mainDiscAmt, decimal packingPercent,
   decimal packingAmt, decimal insurancePercent, decimal insuranceAmt, decimal freightAmt, decimal totalBasicAmt, decimal todayVal)
    {
        if (qty <= 0) return 0;

        decimal itemBasic = itemBasicWithoutDisc;

        if (subDiscAmt > 0)
            itemBasic -= subDiscAmt;
        else if (subDiscPercent > 0)
            itemBasic -= (itemBasicWithoutDisc * subDiscPercent / 100);

        if (subDiscAmt == 0 && subDiscPercent == 0)
        {
            if (mainDiscAmt > 0 && totalBasicAmt > 0)
            {
                decimal proportion = itemBasicWithoutDisc / totalBasicAmt;
                itemBasic -= proportion * mainDiscAmt;
            }
            else if (mainDiscPercent > 0)
            {
                itemBasic -= (itemBasicWithoutDisc * mainDiscPercent / 100);
            }
        }

        if (packingAmt > 0 && totalBasicAmt > 0)
            itemBasic += (itemBasicWithoutDisc / totalBasicAmt) * packingAmt;
        else if (packingPercent > 0)
            itemBasic += (itemBasicWithoutDisc * packingPercent / 100);

        if (insuranceAmt > 0 && totalBasicAmt > 0)
            itemBasic += (itemBasicWithoutDisc / totalBasicAmt) * insuranceAmt;
        else if (insurancePercent > 0)
            itemBasic += (itemBasicWithoutDisc * insurancePercent / 100);

        if (freightAmt > 0 && totalQty > 0)
            itemBasic += (qty / totalQty) * freightAmt;

        decimal unitPrice = itemBasic / qty;

        if (todayVal > 1)
            unitPrice *= todayVal;

        return unitPrice = Math.Round(unitPrice, 3, MidpointRounding.AwayFromZero);
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in PurchaseGRNVM.PurchaseGRNSubVMs)
            {
