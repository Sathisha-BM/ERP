    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else if (confirmation == "Export")
            {
                isProcessing = true;
                await ExportToExcel(isConfirmed);
            }
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed) return;

            isProcessing = true;

            bool success = await subConDcOutService.DeleteSubconDcByDcIdAsync(DeleteDcID, screenCode);

            if (success)
            {
                await _JS.ToastrSuccess("Subcontract Delivery Challan Deleted successfully.");
                await LoadAllSubconDcDetailsAsync();
            }
            else
            {
                await _JS.ToastrWarning("Subcontract DC Outgoing Delete failed.");
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Subcontract Delivery Challan confirmDelete_Click() method");
            await _JS.ToastrError("An error occurred while handling the Subcontract Delivery Challan confirmDelete_Click() method");
        }
        finally
        {
            DeleteDcID = 0;
            isProcessing = false;
        }
    }

