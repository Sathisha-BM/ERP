        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (SubContractDcExport)");
            await _JS.ToastrError("Error while exporting SubContractDcExport!");
        }
        finally
        {
            isProcessing = false;
        }
