    private async Task OnDCSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (SubConGRNVM.SubConGRNSubVMs == null)
            SubConGRNVM.SubConGRNSubVMs = new List<SubConGRNSubVM>();

        if (SubConDcOutVMs.SubConDcOutSubVMs == null)
            SubConDcOutVMs.SubConDcOutSubVMs = new List<SubConDcOutSubVM>();

        try
        {
            // =============================
            // STEP 1: Collect all DcSubIds
            // =============================
            var dcSubIds = selectedItems
                .Where(x => x.ContainsKey("DcSubId") && x["DcSubId"] != null)
                .Select(x => Convert.ToInt32(x["DcSubId"]))
                .Distinct()
                .ToList();

            // =============================
            // STEP 2: Fetch ALL issued data once
            // =============================
            var allDcIds = await _grnService.GetDcIdsByDcSubIdsAsync(dcSubIds);

            var issuedData = allDcIds.Any()
                ? await _grnService.GetSubConGrnSubVMsByDcIdsAsync(allDcIds)
                : new List<SubConGRNSubVM>();

            var issuedLookup = issuedData
                .GroupBy(x => x.ItemId)
                .ToDictionary(g => g.Key,
                    g => Math.Truncate(g.Sum(x => x.BalQty ?? 0m) * 100) / 100m);

            // =============================
            // STEP 3: Loop items
            // =============================
            foreach (var item in selectedItems)
            {
                int itemId = item.TryGetValue("ItemId", out var itemVal) && itemVal != null ? Convert.ToInt32(itemVal) : 0;
                if (itemId == 0) continue;

                int dcSubId = item.TryGetValue("DcSubId", out var dcSubVal) && dcSubVal != null ? Convert.ToInt32(dcSubVal) : 0;

                decimal balQty = item.TryGetValue("BalQty", out var balVal) && balVal != null ? Convert.ToDecimal(balVal) : 0m;

                int categoryCode = item.TryGetValue("CategoryCode", out var catVal) && catVal != null ? Convert.ToInt32(catVal) : 0;
                string categoryName = item.TryGetValue("CategoryName", out var catNameVal) ? catNameVal?.ToString() ?? "" : "";

                // duplicate
                if (SubConGRNVM.SubConGRNSubVMs
                    .Any(x => x.ItemId == itemId && x.RefDcSubId == dcSubId))
                    continue;

                decimal possibleQty = 0;

                // =============================
                // CALCULATION
                // =============================
                if (!SubConGRNVM.IsManual)
                {
                    if (categoryName == "ASSEMBLY" || categoryName == "SUB-ASSEMBLY")
                    {
                        var bomData = await _grnService.GetAssemblyItemsAsync(itemId);

                        decimal? min = null;

                        foreach (var bom in bomData)
                        {
                            decimal issuedQty = issuedLookup.TryGetValue(bom.ItemId, out var val) ? val : 0;

                            if (bom.UtilQty > 0)
                            {
                                decimal calc = issuedQty / bom.UtilQty.GetValueOrDefault();
                                min = min == null ? calc : Math.Min(min.Value, calc);
                            }
                        }

                        possibleQty = Math.Min(min ?? 0, balQty);
                    }
                    else if (categoryName == "COMPONENT")
                    {
                        var rmItems = await _grnService.GetRawMaterialItemsAsync(itemId);

                        decimal? min = null;

                        foreach (var rm in rmItems)
                        {
                            decimal issuedQty = issuedLookup.TryGetValue(rm.ItemId, out var val) ? val : 0;

                            if (rm.Weight > 0)
                            {
                                decimal calc = issuedQty / rm.Weight;
                                min = min == null ? calc : Math.Min(min.Value, calc);
                            }
                        }

                        possibleQty = Math.Min(min ?? 0, balQty);
                    }
                }
                else
                {
                    possibleQty = balQty;
                }

                // =============================
                // DATE PARSE
                // =============================
                DateTime? dcDate = null;

                if (item.TryGetValue("DcDate", out var dateVal) && dateVal != null)
                {
                    DateTime.TryParseExact(
                        dateVal.ToString(),
                        "dd/MM/yyyy",
                        CultureInfo.InvariantCulture,
                        DateTimeStyles.None,
                        out DateTime parsed);

                    dcDate = parsed;
                }

                // =============================
                // CREATE IN ITEM
                // =============================
                var subVm = new SubConGRNSubVM
                {
                    TransType = item.TryGetValue("TransType", out var tVal) ? tVal?.ToString() ?? "In" : "In",

                    ItemId = itemId,
                    ItemCode = item.TryGetValue("ItemCode", out var codeVal) ? codeVal?.ToString() : null,
                    ItemName = item.TryGetValue("ItemName", out var nameVal) ? nameVal?.ToString() : null,
                    MeasureUnit = item.TryGetValue("MeasureUnit", out var uomVal) ? uomVal?.ToString() : null,

                    CategoryCode = categoryCode,

                    Qty = Round2(possibleQty),
                    BalQty = Round2(balQty),
                    PossibleQty = Round2(possibleQty),

                    UnitPrice = item.TryGetValue("UnitPrice", out var priceVal) && priceVal != null
                                    ? Convert.ToDecimal(priceVal)
                                    : 0m,

                    RefDcSubId = dcSubId,
                    RefDcNo = item.TryGetValue("DcNo", out var dcNoVal) ? dcNoVal?.ToString() : null,
                    RefDCDate = dcDate,

                    CostId = item.TryGetValue("CostCenterId", out var costVal) && costVal != null
                                    ? Convert.ToInt32(costVal)
                                    : (int?)null,

                    ProjectNo = item.TryGetValue("ProjectNo", out var projVal) ? projVal?.ToString() : null,
                    Remarks = item.TryGetValue("Remark", out var remVal) ? remVal?.ToString() : null,

                    IsEditable = true
                };

                SubConGRNVM.SubConGRNSubVMs.Add(subVm);
            }

            // =============================
            // MANUAL MODE OUT ITEMS
            // =============================
            if (SubConGRNVM.IsManual && issuedData.Any())
            {
                foreach (var outItem in issuedData)
                {
                    if (SubConGRNVM.SubConGRNSubVMs
                        .Any(x => x.ItemId == outItem.ItemId && x.RefDcSubId == outItem.RefDcSubId))
                        continue;

                    SubConGRNVM.SubConGRNSubVMs.Add(new SubConGRNSubVM
                    {
                        TransType = "Out",

                        RefDcSubId = outItem.RefDcSubId,

                        ItemId = outItem.ItemId,
                        ItemCode = outItem.ItemCode,
                        ItemName = outItem.ItemName,
                        MeasureUnit = outItem.MeasureUnit,

                        Qty = outItem.Qty,
                        PossibleQty = outItem.BalQty,
                        UnitPrice = outItem.UnitPrice,

                        RefDcNo = outItem.RefDcNo,
                        RefDCDate = outItem.RefDCDate,

                        ProjectNo = outItem.ProjectNo,
                        Remarks = outItem.Remarks,

                        IsEditable = true
                    });
                }
            }

            await ResetSlno();
            SubConGRNVM.VendorCode = selectedItems
                    .Where(i => i.ContainsKey("VendorCode") && i["VendorCode"] != null)
                    .Select(i => Convert.ToInt32(i["VendorCode"]))
                    .FirstOrDefault(id => id > 0);

            if (SubConGRNVM == null)
                SubConGRNVM = new SubConGRNVM();

            SubConGRNVM.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            SubConGRNVM.GRNNo = await _grnService.GetSubconGRNNoAsync(SubConGRNVM.Suffix);

            var MapStoreForProdReturn = await _grnService.GetMappedStoreForFormAsync("SubConGRNForm");

            if (MapStoreForProdReturn.StoreId > 0)
            {
                SubConGRNVM.AddStoreId = MapStoreForProdReturn.StoreId;
                SubConGRNVM.StoreName = MapStoreForProdReturn.StoreName;
            }
            else
            {
                SubConGRNVM.AddStoreId = null;
                SubConGRNVM.StoreName = null;
            }
            NavigationState.Set("SubConGRN", SubConGRNVM);
            _navigation.NavigateTo(
                $"/DcSubConIncoming/create/{SubConGRNVM.VendorCode}");
            StateHasChanged();


        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "OnDCSelectedAsync failed.");
            await _JS.ToastrError("Error processing selected DC items.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in SubConGRNVM.SubConGRNSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _JS.ToastrError("Failed to reset row serial numbers.");
        }
    }
    private decimal Round2(decimal val)
    {
        return Math.Truncate(val * 100) / 100;
    }
