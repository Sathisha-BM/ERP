    private void AddEmoji(string emoji)
    {
        MessageText += emoji;

        showEmojiPicker = false;
    }

    private string GetFileDataUrl(ChatMessageAttachment attachment)
    {
        if (attachment.Image == null || attachment.Image.Length == 0)
            return string.Empty;

        return $"data:{attachment.ContentType};base64,{Convert.ToBase64String(attachment.Image)}";
    }

