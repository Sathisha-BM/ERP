                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

    }
}

@code {

    protected override string ScreenName => "CustomScreenSetting";

    private bool isProcessing = true;
    private int screenCode { get; set; }

    private List<PageHeader.BreadcrumbItem> ScreenSettingBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master",Url="master-home"},
        new PageHeader.BreadcrumbItem { Text = "CustomScreenSetting",Url="settings-master"},
        new PageHeader.BreadcrumbItem { Text = "CustomScreenSetting", IsLast = true }
    };

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private string incomeIcon = "bi bi-graph-up-arrow";

    private CustomScreenSettingVM? rowToDelete;

    CustomScreenSettingVM Header = new();
    CustomScreenSettingVM Document = new();

    List<CustomScreenSettingVM> Headers = new();
    List<CustomScreenSettingVM> Documents = new();

    bool IsHeader = false;
    bool IsDocument = false;
    bool IsEditing = false;

    HashSet<int> ExpandedHeaders = new();
    int? SelectedHeaderId = null;
    int? SelectedDocumentId = null;

    private List<ScreensVM> Screens = new();


    CustomScreenSettingVM? SelectedHeader => SelectedHeaderId.HasValue ? Headers.FirstOrDefault(h => h.CustomId == SelectedHeaderId.Value) : null;
    CustomScreenSettingVM? SelectedDocument => SelectedDocumentId.HasValue ? Documents.FirstOrDefault(d => d.CustomId == SelectedDocumentId.Value) : null;
    IEnumerable<CustomScreenSettingVM> DocumentsUnderSelectedHeader => SelectedHeaderId.HasValue
        ? Documents.Where(d => d.CustomId == SelectedHeaderId.Value)
        : Enumerable.Empty<CustomScreenSettingVM>();



    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            screenCode = await _CustomScreenService.GetScreenCodeByScreenNameAsync(ScreenName);
            Screens = await _CustomScreenService.GetAllScreensAsync();
            await LoadData();

            isProcessing = false;
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Income OnInitializedAsync() Method");
        }
    }

    private async Task LoadData()
    {
        try
        {
            Headers = await _CustomScreenService.GetAllHeadersAsync();
            Documents = await _CustomScreenService.GetAllCustomScreenAsync();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the  LoadData() Method");
        }


    }


    RenderFragment DrawTree(CustomScreenSettingVM node, int level) => builder =>
    {
        int seq = 0;

        bool isExpanded = ExpandedHeaders.Contains(node.CustomId);
        bool isSelected = SelectedHeaderId == node.CustomId;

        var children = Headers
            .Where(x => x.CustomChildId == node.CustomId)
            .OrderBy(x => x.CustomId)
            .ToList();

        bool isFolder = node.ScreenId == 0;

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", level == 0 ? "tree-root" : "tree-child");

        //==================== Tree Item ====================

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", $"tree-item {(isSelected ? "active" : "")}");
        builder.AddAttribute(seq++, "onclick",
            EventCallback.Factory.Create(this, () => ToggleHeader(node.CustomId)));

        // Expand / Collapse Arrow (Folders only)
        if (isFolder && children.Any())
        {
            builder.OpenElement(seq++, "i");
            builder.AddAttribute(seq++, "class",
                isExpanded
                    ? "bi bi-caret-down-fill expand-icon"
                    : "bi bi-caret-right-fill expand-icon");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "style", "display:inline-block;width:16px;");
            builder.CloseElement();
        }

        // Icon
        builder.OpenElement(seq++, "i");

        if (isFolder)
        {
            builder.AddAttribute(seq++, "class",
                isExpanded
                    ? "bi bi-folder2-open folder-icon"
                    : "bi bi-folder-fill folder-icon");
        }
        else
        {
            builder.AddAttribute(seq++, "class", "bi bi-window-stack screen-icon");
            // You can also use:
            // bi-display
            // bi-window
            // bi-layout-text-window
        }

        builder.CloseElement();

        // Name
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "tree-title");
        builder.AddContent(seq++, node.Header);
        builder.CloseElement();

        builder.CloseElement(); // tree-item

        //==================== Children ====================

        if (isFolder && isExpanded && children.Any())
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "tree-indent");

            foreach (var child in children)
            {
                builder.AddContent(seq++, DrawTree(child, level + 1));
            }

            builder.CloseElement();
        }

        builder.CloseElement(); // tree-root
    };

    public void ToggleHeader(int headerId)
    {

        if (ExpandedHeaders.Contains(headerId))
            ExpandedHeaders.Remove(headerId);
        else
            ExpandedHeaders.Add(headerId);

        SelectHeader(headerId);
    }

    public void SelectHeader(int headerId)
    {
        SelectedHeaderId = headerId;
        SelectedDocumentId = null;
        IsHeader = false;
        IsDocument = false;
        IsEditing = false;
        StateHasChanged();
    }

    public void SelectDocument(int documentId)
    {
        SelectedDocumentId = documentId;
        SelectedHeaderId = null;
        IsHeader = false;
        IsDocument = false;
        IsEditing = false;
        StateHasChanged();
    }

    public async Task RefreshTree()
    {
        await LoadData();
        StateHasChanged();
    }

    public void NewHeader()
    {
        Header = new CustomScreenSettingVM();
        IsHeader = true;
        IsDocument = false;
        IsEditing = false;
        SelectedHeaderId = null;
        SelectedDocumentId = null;
    }

    public void CancelEdit()
    {
        IsHeader = false;
        IsDocument = false;
        IsEditing = false;
        if (SelectedHeaderId == null && SelectedDocumentId == null)
        {
            var firstRoot = Headers.FirstOrDefault(h => h.CustomId == null);
            if (firstRoot != null)
                SelectHeader(firstRoot.CustomId);
        }
        StateHasChanged();
    }

    private async Task SaveHeader()
    {
        try
        {

            if (string.IsNullOrWhiteSpace(Header.Header))
                return;

            Header = await _CustomScreenService.UpsertCustomScreenAsync(Header, screenCode);

            Headers = await _CustomScreenService.GetAllHeadersAsync();

            ExpandedHeaders.Add(Header.CustomId);

            int savedId = Header.CustomId;

            Header = new CustomScreenSettingVM();
            IsHeader = false;

            SelectHeader(savedId);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the SaveHeader Method");
        }
    }

    private async Task UpsertScreenSetting()
    {
        try
        {
            isProcessing = true;

            foreach (var screen in Headers)
            {
                await _CustomScreenService.UpsertCustomScreenAsync(screen, screenCode);
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the  UpsertScreenSetting() Method");
        }

    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {

        try
        {
            await JSRuntime.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;
                case "RemoveHeader":
                    await CanRemove(true);
                    break;
                default:
                    await JSRuntime.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action in HandleModalConfirmation: {confirmation}");
            await JSRuntime.ToastrError("An error occurred while processing your action in HandleModalConfirmation. Please try again.");
        }


    }
    private async Task CanRemove(bool isConfirmed)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || SelectedHeader == null)
            {
                await JSRuntime.ToastrInfo("Action was not confirmed.");
                return;
            }

            if (SelectedHeader.CustomId > 0)
            {

                await _CustomScreenService.DeleteHeaderAsync(SelectedHeader.CustomId, screenCode);

                Headers = await _CustomScreenService.GetAllHeadersAsync();
            }
            else
            {
                // Remove only from UI
                Headers.Remove(SelectedHeader);
            }

            SelectedHeaderId = null;
            Header = new CustomScreenSettingVM();

            StateHasChanged();

            await JSRuntime.ToastrSuccess("Header deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CanRemove failed for HeaderId: {SelectedHeader?.CustomId}");

            await JSRuntime.ToastrError("An error occurred while deleting the header.");
        }
    }

    private async Task RemoveRow(CustomScreenSettingVM item)
    {
        try
        {

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";

            showCancelReasonBox = false;

            await JSRuntime.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for GRNSubId: {item?.CustomId}");
            await JSRuntime.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await JSRuntime.ToastrInfo("Action was not confirmed.");
                return;
            }

            if (rowToDelete.CustomId > 0)
            {
                await _CustomScreenService.DeleteAndResequenceAsync(rowToDelete, screenCode);

                await LoadData();

            }
            else
            {
                Documents.Remove(rowToDelete);
                SelectedDocumentId = null;
                StateHasChanged();
            }

            await JSRuntime.ToastrSuccess($" deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for DocId:{Document.CustomId}");
            await JSRuntime.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }
    private void EditHeader()
    {
        if (SelectedHeader == null)
            return;

        Header = new CustomScreenSettingVM
        {
            CustomId = SelectedHeader.CustomId,
            Header = SelectedHeader.Header,
            CustomChildId=SelectedHeader.CustomChildId,
            ScreenId=SelectedHeader.ScreenId,
            CreatedBy = SelectedHeader.CreatedBy,
            CreatedDate = SelectedHeader.CreatedDate,

        };

        IsHeader = true;
        IsDocument = false;
        IsEditing = true;
    }


    private async Task DeleteHeader()
    {
        try
        {

            if (SelectedHeader == null)
                return;


            if (Headers.Any(x => x.CustomChildId == SelectedHeader.CustomId))
            {
                await JSRuntime.ToastrWarning("Please delete all child headers first.");
                return;
            }

            ModalTitle = "Are you sure you want to Delete Header?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "RemoveHeader";
            showCancelReasonBox = false;


            await JSRuntime.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming DeleteHeader ");
            await JSRuntime.ToastrError("An error occurred during DeleteHeader. Please try again.");
        }

    }

    public void NewDocument()
    {
        Document = new CustomScreenSettingVM();
        if (SelectedHeaderId.HasValue)
            Document.CustomChildId = SelectedHeaderId.Value;
        IsDocument = true;
        IsHeader = false;
        IsEditing = false;
        SelectedHeaderId = null;
        SelectedDocumentId = null;
    }

    public void EditDocument()
    {
        if (SelectedDocument != null)
        {
            Document = new CustomScreenSettingVM
            {

                CustomId = SelectedDocument.CustomId,
                ScreenId = SelectedDocument.ScreenId,
                ScreenName = SelectedDocument.ScreenName,
                Navigation = SelectedDocument.Navigation,

            };
            IsDocument = true;
            IsEditing = true;
            StateHasChanged();
        }
    }

    private async Task SaveDocument()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Document.ScreenName) || Document.CustomChildId == 0)
                return;

            Document = await _CustomScreenService.UpsertCustomScreenAsync(Document, screenCode);

            int savedId = Document.ScreenId;

            // Documents = await _CustomScreenService.GetAllHeadersAsync();

            Document = new CustomScreenSettingVM();

            IsDocument = false;
            IsEditing = false;

            await LoadData();

            SelectDocument(savedId);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the SaveDocument Method");
        }
    }
    private Task<IEnumerable<ScreensVM>> SearchScreens(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(Screens.AsEnumerable());

        return Task.FromResult(
            Screens.Where(x =>
                x.ScreenName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                x.ScreenCode.ToString().Contains(value))
            .AsEnumerable());
    }
    private Task ScreenSelected(ScreensVM? screen)
    {
        if (screen == null)
            return Task.CompletedTask;

        Document.ScreenId = screen.Id;
        Document.ScreenName = screen.ScreenName;
        Document.Header = screen.ScreenName;
        Document.Navigation = screen.Navigation;

        if (Documents.Any(x=>x.ScreenId == Document.ScreenId))
        {
            JSRuntime.ToastrWarning("This screen is already added to the list.");
            Document.ScreenId = 0;
            Document.ScreenName = string.Empty;
            Document.Header = string.Empty;
            Document.Navigation = string.Empty;
            
        }
        return Task.CompletedTask;
    }
    private Task OnHeaderChanged()
    {
        var selectedHeader = Headers.FirstOrDefault(x => x.CustomId == Document.CustomChildId);

        if (selectedHeader != null)
        {
            // Store Header Name


            // Store Parent Id (already done by @bind)
            Document.CustomChildId = selectedHeader.CustomId;
        }

        return Task.CompletedTask;
    }
}
