@page "/incomingInspectionReport"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.IIncomingInspectionService
@using V.SMART.Shared.ViewModels.ReportViewModel.InspectionViewModel


@inherits BaseUserRightsComponent

@inject ILoggingService _logs
@inject CurrentUserService _userService
@inject IJSRuntime _js
@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService
@inject ExcelExportService ExcelExportService
@inject IColumnPreferenceService PreferenceService
@inject CurrentUserService CurrentUserService
@inject IUnitOfWork _unitOfWork
@inject IIncomInspectionService _incomInspectionService
@inject InspectionReportState InspectionReportState

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle>
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Incoming Inspection Report"
                        TitleIcon="bi bi-list-check"
                        Breadcrumbs="@IncomingInspectionBreadcrumbs" />

            <!-- FILTER CARD -->
            <div class="row g-3 mt-3">

                <!-- ================= CARD 1 : DATE + NOTE ================= -->
                <div class="col-12 col-lg-4">

                    <div class="card border-0 shadow rounded-3 h-100 overflow-hidden">

                        <!-- HEADER -->
                        <div class="card-header border-0 text-white py-3 px-3"
                             style="background: linear-gradient(135deg, #0a535d, #117a8b);">

                            <div class="d-flex align-items-center">

                                <div class="bg-white bg-opacity-25 rounded-circle p-2 me-2">
                                    <i class="bi bi-calendar3 fs-5"></i>
                                </div>

                                <div>
                                    <div class="fw-bold">
                                        Report Period
                                    </div>

                                    <small class="text-white-50">
                                        Select date range
                                    </small>
                                </div>

                            </div>

                        </div>

                        <!-- BODY -->
                        <div class="card-body p-3">

                            <!-- FROM DATE -->
                            <div class="mb-3">

                                <label class="form-label small fw-semibold text-muted mb-1">
                                    From Date
                                </label>

                                <InputDate class="form-control form-control-sm"
                                           @bind-Value="FromDate" />

                            </div>

                            <!-- TO DATE -->
                            <div class="mb-3">

                                <label class="form-label small fw-semibold text-muted mb-1">
                                    To Date
                                </label>

                                <InputDate class="form-control form-control-sm"
                                           @bind-Value="ToDate" />

                            </div>

                            <!-- NOTE -->
                            <div class="alert alert-info py-2 px-3 mb-0 small">

                                <i class="bi bi-info-circle-fill me-1"></i>

                                <span>
                                    Click on <strong>GRN Number</strong> to open
                                    the Inspection Form.
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================= CARD 2 : TOPIC ================= -->
                <div class="col-12 col-lg-4">

                    <div class="card border-0 shadow rounded-3 h-100 overflow-hidden">

                        <!-- HEADER -->
                        <div class="card-header border-0 text-white py-3 px-3"
                             style="background: linear-gradient(135deg, #141e30, #243b55);">

                            <div class="d-flex align-items-center">

                                <div class="bg-white bg-opacity-25 rounded-circle p-2 me-2">
                                    <i class="bi bi-grid-fill fs-5"></i>
                                </div>

                                <div>

                                    <div class="fw-bold">
                                        Report Type
                                    </div>

                                    <small class="text-white-50">
                                        Select report category
                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- BODY -->
                        <div class="card-body p-3 bg-light">

                            <div class="row g-2">

                                <!-- PURCHASE -->
                                <div class="col-6">

                                    <button type="button"
                                            class="btn w-100 text-start border rounded-3 shadow-sm
