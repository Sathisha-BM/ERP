                                            @onclick='() => OnTopicClick("Purchase")'>

                                        <div class="d-flex align-items-center">

                                            <span class="badge rounded-circle bg-info p-2 me-2">
                                                <i class="bi bi-cart-check"></i>
                                            </span>

                                            <div class="flex-grow-1">

                                                <div class="fw-bold">
                                                    Purchase
                                                </div>

                                            </div>

                                           @*  <span class="badge @(SelectedTopic == "Purchase" ? "bg-white text-primary" : "bg-secondary")">01</span> *@

                                        </div>

                                    </button>

                                </div>


                                <!-- SUB CONTRACT -->
                                <div class="col-6">

                                    <button type="button"
                                            class="btn w-100 text-start border rounded-3 shadow-sm
                                    @(SelectedTopic == "SubContract" ? "btn-primary" : "btn-light")"
                                            @onclick='() => OnTopicClick("SubContract")'>

                                        <div class="d-flex align-items-center">

                                            <span class="badge rounded-circle bg-warning text-dark p-2 me-2">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </span>

                                            <div class="flex-grow-1">

                                                <div class="fw-bold">
                                                    Sub Contract
                                                </div>

                                            </div>

                                           @*  <span class="badge @(SelectedTopic == "SubContract" ? "bg-white text-primary" : "bg-secondary")">02</span> *@

                                        </div>

                                    </button>

                                </div>


                                <!-- PRODUCTION COMP -->
                                <div class="col-6">

                                    <button type="button"
                                            class="btn w-100 text-start border rounded-3 shadow-sm
                                            @(SelectedTopic == "Production_Comp" ? "btn-primary" : "btn-light")"
                                            @onclick='() => OnTopicClick("Production_Comp")'>

                                        <div class="d-flex align-items-center">

                                            <span class="badge rounded-circle bg-success p-2 me-2">
                                                <i class="bi bi-gear-fill"></i>
                                            </span>

                                            <div class="flex-grow-1">

                                                <div class="fw-bold">
                                                    Production Comp
                                                </div>

                                            </div>

                                            @* <span class="badge @(SelectedTopic == "Production_Comp" ? "bg-white text-primary" : "bg-secondary")">03</span> *@

                                        </div>

                                    </button>

                                </div>


                                <!-- LABOUR -->
                                <div class="col-6">

                                    <button type="button"
                                            class="btn w-100 text-start border rounded-3 shadow-sm
                                    @(SelectedTopic == "Labour" ? "btn-primary" : "btn-light")"
                                            @onclick='() => OnTopicClick("Labour")'>

                                        <div class="d-flex align-items-center">

                                            <span class="badge rounded-circle bg-warning text-dark p-2 me-2">
                                                <i class="bi bi-people-fill"></i>
                                            </span>

                                            <div class="flex-grow-1">

                                                <div class="fw-bold">
                                                    Labour
                                                </div>

                                            </div>

                                           @*  <span class="badge @(SelectedTopic == "Labour" ? "bg-white text-primary" : "bg-secondary")">04</span> *@

                                        </div>

                                    </button>

                                </div>


                                <!-- PRODUCTION ASSY -->
                                <div class="col-6">

                                    <button type="button"
                                            class="btn w-100 text-start border rounded-3 shadow-sm
                                    @(SelectedTopic == "Production_Assy" ? "btn-primary" : "btn-light")"
                                            @onclick='() => OnTopicClick("Production_Assy")'>

                                        <div class="d-flex align-items-center">

                                            <span class="badge rounded-circle bg-danger p-2 me-2">
                                                <i class="bi bi-box-seam"></i>
                                            </span>

                                            <div class="flex-grow-1">

                                                <div class="fw-bold">
                                                    Production Assy
                                                </div>

                                            </div>

                                            @* <span class="badge @(SelectedTopic == "Production_Assy" ? "bg-white text-primary" : "bg-secondary")">05</span> *@

                                        </div>

                                    </button>

                                </div>


                                <!-- PRODUCTION LOG -->
                                <div class="col-6">

                                    <button type="button"
                                            class="btn w-100 text-start border rounded-3 shadow-sm
                                            @(SelectedTopic == "Production_Log" ? "btn-primary" : "btn-light")"
                                            @onclick='() => OnTopicClick("Production_Log")'>

                                        <div class="d-flex align-items-center">

                                            <span class="badge rounded-circle bg-dark p-2 me-2">
                                                <i class="bi bi-clipboard-data-fill"></i>
                                            </span>

                                            <div class="flex-grow-1">

                                                <div class="fw-bold">
                                                    Production Log
                                                </div>

                                            </div>

                                           @*  <span class="badge @(SelectedTopic == "Production_Log" ? "bg-white text-primary" : "bg-secondary")">06</span> *@

                                        </div>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ================= CARD 3 : PARTY ================= -->
                <div class="col-12 col-lg-4">

                    <div class="card border-0 shadow rounded-3 h-100 overflow-hidden">

                        <!-- HEADER -->
                        <div class="card-header border-0 text-white py-3 px-3"
                             style="background: linear-gradient(135deg, #b57281, #8f4d5c);">

                            <div class="d-flex align-items-center">

                                <div class="bg-white bg-opacity-25 rounded-circle p-2 me-2">
                                    <i class="bi bi-people-fill fs-5"></i>
                                </div>

                                <div>

                                    <div class="fw-bold">
                                        Select Party Name
                                    </div>

                                    <small class="text-white-50">
                                        Based on selected report type
                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- BODY -->
                        <div class="card-body p-3">

                            <!-- SEARCH -->
                            <div class="input-group input-group-sm mb-2">

                                <span class="input-group-text bg-white">
                                    <i class="bi bi-search text-muted"></i>
                                </span>

                                <input class="form-control"
                                       placeholder="Search Party..."
                                       @bind="partySearch"
                                       @bind:event="oninput" />

                            </div>


                            <!-- PARTY LIST -->
                            <div class="border rounded bg-white overflow-auto"
                                 style="max-height:270px;">

                                <!-- ALL -->
                                <button type="button"
                                        class="btn w-100 text-start border-0 rounded-0
                                        @(SelectedParty == "ALL"
                                        ? "bg-primary text-white fw-bold"
                                        : "bg-white text-dark")"
                                        @onclick='() => SelectParty("ALL")'>

                                    <i class="bi bi-people me-2"></i>
                                    ALL

                                </button>


                                <!-- PARTY NAMES -->
                                @foreach (var party in FilteredPartyNames)
                                {
                                    <button type="button"  class="btn w-100 text-start border-0 rounded-0
                                    @(SelectedParty == party.CustName
                                    ? "bg-primary text-white fw-bold"
                                    : "bg-white text-dark")"
                                    @onclick='() => SelectParty(party.CustName)'>

                                        <i class="bi bi-person me-2"></i>

                                        @party.CustName

                                    </button>
                                 }

                            </div>

                        </div>

                    </div>

                </div>

            </div>
            <!-- TABLE -->
            @if (IsLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-grow text-primary"></div>

                    <span class="ms-3 fw-semibold">
                        Fetching Inspection records...
                    </span>
                </div>
            }
            else if (FilteredInspectionSummaryData != null && FilteredInspectionSummaryData.Any())
            {
                <!-- HEADER -->
                <div class="card-header border-0 py-3 px-4"
                     style="background: linear-gradient(135deg, #eefcff, #d9f7ff);
                                        border-bottom:1px solid #c6eff7;">

                    <div class="row g-3 align-items-center">

                        <!-- TITLE -->
                        <div class="col-12 col-xl-3">
                            <div class="d-flex align-items-center">

                                <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3">
                                    <i class="bi bi-receipt-cutoff text-primary fs-5"></i>
                                </div>

                                <div>
                                    <div class="fw-bold text-dark">
                                        Inspection Report
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- SEARCH -->
                        <div class="col-12 col-xl-3">
                            <div class="input-group shadow-sm rounded-3 overflow-hidden border">

                                <span class="input-group-text bg-white border-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>

                                <input type="text"
                                       class="form-control border-start-0"
                                       placeholder="Search InspectionNo,ItemCode,ItemName,CustName,GRNNo,DCNo"
                                       @bind="searchText"
                                       @bind:event="oninput" />

                            </div>
                        </div>

                        <!-- COLUMN MENU -->
                        <div class="col-12 col-xl-3">

                            <div class="dropdown w-100">

                                <button class="btn btn-outline-primary rounded-3 w-100 fw-semibold shadow-sm dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <i class="bi bi-layout-three-columns me-2"></i>

                                    <span class="d-none d-md-inline">
                                        Manage Columns
                                    </span>

                                    <span class="d-inline d-md-none">
                                        Columns
                                    </span>

                                </button>

                                <ul class="dropdown-menu p-3 shadow border-0 rounded-4"
                                    style="max-height:400px; overflow:auto; min-width:260px;">

                                    @foreach (var col in Columns)
                                    {
                                        <li class="mb-2">

                                            <div class="form-check">

                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@col.IsVisible"
                                                       @onchange="async e =>
                                                       {
                                                           await OnColumnChanged(col, e.Value);
                                                       }" />

                                                <label class="form-check-label small fw-semibold">
                                                    @col.Title
                                                </label>

                                            </div>

                                        </li>
                                    }

                                </ul>

                            </div>

                        </div>

                        <!-- PRINT -->
                        <div class="col-12 col-xl-3">

                            <button class="btn btn-success rounded-3 shadow-sm fw-semibold w-100"
                                    id="btnPrint"
                                    @onclick="Print">

                                <i class="bi bi-file-earmark-excel-fill me-2"></i>
                                Print

                            </button>

                        </div>

                    </div>

                </div>

                <!-- TABLE -->
                <div class="card-body p-2">

                    <div class="table-responsive border rounded-4 overflow-auto"
                         style="max-height:650px;">

                        <table class="table table-hover table-bordered align-middle text-center mb-0"
                               style="min-width:1900px; white-space:nowrap;">

                            <thead class="custom-blue position-sticky top-0 z-3">
                                <tr>
                                    @if (IsColumnVisible("SlNo"))
                                    {
                                        <th>Sl No.</th>
                                    }

                                    @if (IsColumnVisible("CustName"))
                                    {
                                        <th>Customer Name</th>
                                    }
                                    @if (IsColumnVisible("InspectionNo"))
                                    {
                                        <th>Inspection No.</th>
                                    }
                                    @if (IsColumnVisible("InspectionDate"))
                                    {
                                        <th>Inspection Date</th>
                                    }
                                    @if (IsColumnVisible("ItemCode"))
                                    {
                                        <th>Item Code</th>
                                    }
                                    @if (IsColumnVisible("ItemName"))
                                    {
                                        <th>Item Name</th>
                                    }
                                    @if (IsColumnVisible("GRNNo"))
                                    {
                                        <th>GRN No.</th>
                                    }
                                    @if (IsColumnVisible("DCNo"))
                                    {
                                        <th>DC No.</th>
                                    }
                                    @if (IsColumnVisible("DCDate"))
                                    {
                                        <th>DC Date</th>
                                    }
                                    @if (IsColumnVisible("Qty"))
                                    {
                                        <th>Qty</th>
                                    }
                                    @if (IsColumnVisible("AcceptQty"))
                                    {
                                        <th>Accept Qty</th>
                                    }
                                    @if (IsColumnVisible("ReWorkQty"))
                                    {
                                        <th>ReWork Qty</th>
                                    }
                                    @if (IsColumnVisible("RejectQty"))
                                    {
                                        <th>Reject Qty</th>
                                    }
                                    @if (IsColumnVisible("CreatedBy"))
                                    {
                                        <th>Created By</th>
                                    }
                                    @if (IsColumnVisible("CreatedDate"))
                                    {
                                        <th>Created Date</th>
                                    }


                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in FilteredInspectionData)
                                {
                                    <tr>
                                        @if (IsColumnVisible("SlNo"))
                                        {
                                            <td>@item.SlNo</td>
                                        }
                                        @if (IsColumnVisible("CustName"))
                                        {
                                            <td>@item.CustName</td>
                                        }
                                        @if (IsColumnVisible("InspectionNo"))
                                        {
                                            <td>@item.InspectionNo</td>
                                        }
                                        @if (IsColumnVisible("InspectionDate"))
                                        {
                                            <td>@item.InspectionDate?.ToString("dd/MM/yyyy")</td>
                                        }

                                        @if (IsColumnVisible("ItemCode"))
                                        {
                                            <td>@item.ItemCode</td>
                                        }
                                        @if (IsColumnVisible("ItemName"))
                                        {
                                            <td>@item.ItemName</td>
                                        }

                                        @if (IsColumnVisible("GRNNo"))
                                        {
                                            <td>
                                                <button type="button"
                                                        class="btn btn-link p-0 fw-semibold"
                                                        @onclick="() => OpenInspection(item.InspectId)">
                                                    @item.GRNNo
                                                </button>
                                            </td>
                                        }
                                        @if (IsColumnVisible("DCNo"))
                                        {
                                            <td>@item.DCNo</td>
                                        }
                                        @if (IsColumnVisible("DCDate"))
                                        {
                                            <td>@item.DCDate?.ToString("dd/MM/yyyy")</td>
                                        }
                                        @if (IsColumnVisible("Qty"))
                                        {
                                            <td>@item.Qty</td>
                                        }
                                        @if (IsColumnVisible("AcceptQty"))
                                        {
                                            <td>@item.AcceptQty</td>
                                        }
                                        @if (IsColumnVisible("ReWorkQty"))
                                        {
                                            <td>@item.ReWorkQty</td>
                                        }
                                        @if (IsColumnVisible("RejectQty"))
                                        {
                                            <td>@item.RejectQty</td>
                                        }
                                        @if (IsColumnVisible("CreatedBy"))
                                        {
                                            <td>@item.CreatedBy</td>
                                        }
                                        @if (IsColumnVisible("CreatedDate"))
                                        {
                                            <td>@item.CreatedDate?.ToString("dd/MM/yyyy")</td>
                                        }

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <!-- NO DATA -->
                <div class="col-12 mt-4">

                    <div class="card border-0 shadow-sm rounded-4">

                        <div class="card-body text-center py-5">

                            <div class="mb-3">
                                <i class="bi bi-inbox text-secondary"
                                   style="font-size:55px;"></i>
                            </div>

                            <h5 class="fw-bold text-dark">
                                No Data Available
                            </h5>

                            <p class="text-muted mb-0">
                                Select inspectionno, name and date range to load invoice records.
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    </div>
}

@code
{
    protected override string ScreenName => "MaterialIssueNote Report";
    private bool isProcessing = true;
    private string searchText = string.Empty;
    private List<PageHeader.BreadcrumbItem> IncomingInspectionBreadcrumbs { get; set; } = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Reports",Url="reports-home" },
        new PageHeader.BreadcrumbItem { Text = "Inspection",Url="reports-home" },
        new PageHeader.BreadcrumbItem { Text = "Incoming Inspection Report", IsLast = true }
    };
    private List<Customer> Customers = new();
    private List<Vendor> Vendors = new();
    private int SelectedPartyId;

    private List<InspectionVM> PartyNames = new();
    private string SelectedParty = "ALL";
    private string partySearch = "";
    private List<InspectionVM> InspectionData = new();
    // private List<InspectionVM> FilteredInspectionData = new();
    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private string? SelectedEmployee;
    private int? SelectedEmployeeId { get; set; }
    private List<string> Employees = new();
    private string? ToWhom { get; set; }
    private List<InspectionVM> FilteredInspectionSummaryData = new();
    private List<InspectionVM> AllMatIssueNoteSummaryData = new();
    private List<InspectionVM> FilteredMatIssueNoteReportList = new();


    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";
    private bool IsLoading = false;
    public List<InspectionVM> MaterialIssueReportVMs { get; set; } = new();
    private string SelectedTopic = "";
    public DateTime? FromDate = DateTime.Today.AddMonths(-1);
    public DateTime? ToDate = DateTime.Today;
    private string? UserName;
    private int screenCode { get; set; }
    private List<GridColumn> Columns = new();
    private string UserId = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            screenCode = await _incomInspectionService.GetScreenCodeByScreenNameAsync(ScreenName);

            UserName = await CurrentUserService.GetUsernameAsync();

            await LoadEmployees();
            await LoadColumnPreferences(UserName);

            // Restore previous report
            RestoreReportState();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(
                ex,
                "OnInitializedAsync in Inspection Report");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void RestoreReportState()
    {
        if (!InspectionReportState.HasData)
            return;

        InspectionData = InspectionReportState.InspectionData.ToList();

        PartyNames = InspectionReportState.PartyNames.ToList();

        FilteredInspectionSummaryData = InspectionReportState.FilteredInspectionData.ToList();

        SelectedTopic = InspectionReportState.SelectedTopic;

        SelectedParty = InspectionReportState.SelectedParty;

        partySearch = InspectionReportState.PartySearch;

        FromDate = InspectionReportState.FromDate;

        ToDate = InspectionReportState.ToDate;
    }

    private async Task LoadInspectionData()
    {
        var result = await _incomInspectionService.GetInspectionReportAsync(FromDate, ToDate, SelectedTopic);

        InspectionData = result?.ToList() ?? new List<InspectionVM>();

        // Initially show ALL records
        FilteredInspectionSummaryData = InspectionData.ToList();

        // Load unique party names
        PartyNames = InspectionData
            .Where(x => !string.IsNullOrWhiteSpace(x.CustName))
            .GroupBy(x => x.CustName!.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(x => x.First())
            .ToList();

        SelectedParty = "ALL";
    }

    private async Task LoadEmployees()
    {
        try
        {
            var staffList = await _unitOfWork.Staffs.GetAllAsync();

            Employees = staffList
                .Where(x => !string.IsNullOrWhiteSpace(x.StaffName))
                .Select(x => x.StaffName.Trim())
                .Distinct()
                .OrderBy(x => x)
                .ToList();
        }
        catch (Exception ex)
        {
            Employees = new List<string>();

            await _logs.LogDeveloperError(ex, "Error while loading employee names");
        }
    }

    private void OpenInspection(int inspectId)
    {
        _navigation.NavigateTo($"/IncomingInspection/update/{inspectId}?fromReport=true");
    }

    private async Task OnTopicClick(string topic)
    {
        try
        {
            IsLoading = true;

            SelectedTopic = topic;

            SelectedParty = "";
            partySearch = "";

            await LoadPartyNames();

            // Don't show table until party is selected
            FilteredInspectionSummaryData = new List<InspectionVM>();

            SaveReportState();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(
                ex,
                "Error while loading party names");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void SelectParty(string? party)
    {
        SelectedParty = string.IsNullOrWhiteSpace(party)
        ? ""
        : party.Trim();

        if (SelectedParty == "ALL")
        {
            // Show all records for the selected Topic
            FilteredInspectionSummaryData = InspectionData.ToList();
        }
        else
        {
            // Show only selected Party records
            FilteredInspectionSummaryData = InspectionData
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.CustName) &&
                    x.CustName.Trim().Equals(
                        SelectedParty,
                        StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        // Save current selection + table
        SaveReportState();

        StateHasChanged();
    }

    private void SaveReportState()
    {
        InspectionReportState.InspectionData =
            InspectionData?.ToList() ?? new List<InspectionVM>();

        InspectionReportState.PartyNames =
            PartyNames?.ToList() ?? new List<InspectionVM>();

        InspectionReportState.FilteredInspectionData =
            FilteredInspectionData?.ToList() ?? new List<InspectionVM>();

        InspectionReportState.SelectedTopic =
            SelectedTopic;

        InspectionReportState.SelectedParty =
            SelectedParty;

        InspectionReportState.PartySearch =
            partySearch;

        InspectionReportState.FromDate =
            FromDate;

        InspectionReportState.ToDate =
            ToDate;

        InspectionReportState.HasData = true;
    }

    private async Task LoadPartyNames()
    {
        var result = await _incomInspectionService.GetInspectionReportAsync(
            FromDate,
            ToDate,
            SelectedTopic);

        InspectionData = result?.ToList()
            ?? new List<InspectionVM>();

        PartyNames = InspectionData
            .Where(x => !string.IsNullOrWhiteSpace(x.CustName))
            .GroupBy(
                x => x.CustName!.Trim(),
                StringComparer.OrdinalIgnoreCase)
            .Select(x => x.First())
            .ToList();

        // Table must remain empty until party is selected
        FilteredInspectionSummaryData = new List<InspectionVM>();

        SaveReportState();
    }


