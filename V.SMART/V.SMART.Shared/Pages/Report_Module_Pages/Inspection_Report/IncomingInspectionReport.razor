    private bool IsColumnVisible(string field)
    {
        return Columns.Any(x => x.Field == field && x.IsVisible);
    }

    private IEnumerable<InspectionVM> FilteredPartyNames
    {
        get
        {
            return PartyNames
                .Where(x => !string.IsNullOrWhiteSpace(x.CustName))
                .Where(x =>
                    string.IsNullOrWhiteSpace(partySearch) ||
                    x.CustName!.Contains(
                        partySearch,
                        StringComparison.OrdinalIgnoreCase))
                .GroupBy(x => x.CustName)
                .Select(x => x.First());
        }
    }

    IEnumerable<InspectionVM> FilteredInspectionData
    {
        get
        {
            var search = searchText?.Trim();

            var filtered = (FilteredInspectionSummaryData ?? Enumerable.Empty<InspectionVM>())
                .Where(s =>
                    string.IsNullOrWhiteSpace(search)

                    // Customer Name
                    || (!string.IsNullOrWhiteSpace(s.CustName)
                        && s.CustName.Contains(search, StringComparison.OrdinalIgnoreCase))

                    // Inspection No
                    || (!string.IsNullOrWhiteSpace(s.InspectionNo)
                        && s.InspectionNo.Contains(search, StringComparison.OrdinalIgnoreCase))

                    // Item Code
                    || (!string.IsNullOrWhiteSpace(s.ItemCode)
                        && s.ItemCode.Contains(search, StringComparison.OrdinalIgnoreCase))

                    // Item Name
                    || (!string.IsNullOrWhiteSpace(s.ItemName)
                        && s.ItemName.Contains(search, StringComparison.OrdinalIgnoreCase))

                    // GRN No
                    || (!string.IsNullOrWhiteSpace(s.GRNNo)
                        && s.GRNNo.Contains(search, StringComparison.OrdinalIgnoreCase))

                    // DC No
                    || (!string.IsNullOrWhiteSpace(s.DCNo)
                        && s.DCNo.Contains(search, StringComparison.OrdinalIgnoreCase))
                )
                .ToList();

            // Reset Sl No after filtering
            for (int i = 0; i < filtered.Count; i++)
            {
                filtered[i].SlNo = i + 1;
            }

            return filtered;
        }
    }

