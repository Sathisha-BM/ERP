@page "/OperatorSummary"
@using MudBlazor
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.IProductionSummaryService
@using V.SMART.Shared.ViewModels.ReportViewModel.ProductionSummaryVM

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject IExcelTemplateService excelTemplateService
@inject IJSRuntime _JS
@inject NavigationManager _navigation
@inject IOperatorSummaryService _operatorSummaryService
@inject ExcelExportService ExcelExportService
@inject IColumnPreferenceService PreferenceService
@inject CurrentUserService CurrentUserService

<BsModal OnModalConfirmation="confirmation_Click"
         ButtonBootstrapStyle="@(confirmation != "Export" ? "btn-danger" : btnColor)"
         ButtonText="@(confirmation != "Export" ? "Delete" : btnText)"
         Title="@(confirmation != "Export"
                           ? "Are you sure you want to delete this Purchase Sales Track?"
                           : ModalTitle)">
</BsModal>
<style>
    .production-container {
        position: relative;
        min-height: 100vh;
    }

        .production-container::before {
            content: "";
            position: absolute;
            inset: 0;
            background: url('/uploads/production.png') no-repeat center center;
            background-size: 20%;
            opacity: 0.28;
            z-index: 0;
            pointer-events: none;
        }

        .production-container > * {
            position: relative;
            z-index: 1;
        }

</style>


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-4  ">

        <div class="card shadow-sm">

            <PageHeader TitleText="Operator Summary Report"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@OperatorSummaryBreadcrumbs" />


            <div class="card-body p-4">

                <!-- FILTER SECTION -->

                <div class="row g-3 align-items-end mb-4">
                    <!-- FROM DATE -->

                    <div class="col-xl-2 col-lg-3 col-md-6">

                        <label class="form-label fw-bold text-dark">
                            From Date
                        </label>

                        <InputDate class="form-control shadow-sm"
                                   @bind-Value="fromDate" />

                    </div>

                    <!-- TO DATE -->

                    <div class="col-xl-2 col-lg-3 col-md-6">


                        <label class="form-label fw-bold text-dark">
                            To Date
                        </label>


                        <InputDate class="form-control shadow-sm"
                                   @bind-Value="toDate"
                                   @bind-Value:after="LoadData" />



                    </div>


                    <!-- Search -->
                    <div class="col-12 col-lg-3">


                        <div class="input-group w-100">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search text-muted"></i>
                            </span>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Search Here..."
                                   value="@searchText"
                                   @oninput="OnInputChanged" />
                        </div>

                    </div>




                </div>




            </div>

            @if (IsLoading)
            {
                <div class="alert alert-info m-2">
                    Loading...
                </div>
            }
            else
            {
                <div class="table-responsive border rounded" style="max-height:600px; overflow-x:auto; overflow-y:auto; font-family:Arial">

                    @if (FilteredReportList.Any())
                    {
                        <div class="col-12 mt-3 mb-2">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, black); border: 1px solid #e0e6ed;">

                                <div class="card-header bg-primary-subtle text-dark">

                                    <div class="row g-3 align-items-center mb-3">

                                        <!-- Title -->
                                        <div class="col-12 col-lg-3">
                                            <span class="fw-bold fs-6">
                                                Operator Summary Track
                                            </span>
                                        </div>

                                        <div class="col-12 col-lg-3 ">
                                            <div class="dropdown position-relative" style="z-index:1;">
                                                <ColumnMenu Columns="@Columns"
                                                            ScreenName="@ScreenName"
                                                            UserId="@UserName"
                                                            MaxVisible="@int.MaxValue"
                                                            OnChanged="HandleColumnChange" />
                                            </div>
                                        </div>





                                        <!-- Print -->
                                        <div class="col-12 col-lg-3">
                                            <button class="btn btn-outline-primary w-100 text-nowrap"
                                                    @onclick="OnPrintPendingTrack"
                                                    title="Export Report to Excel">
                                                <i class="bi bi-printer me-1"></i> Print
                                            </button>
                                        </div>
                                    </div>



                                </div>

                            </div>
                            <div class="card-body p-2">

                                <div class="table-responsive border rounded" style="max-height:600px; overflow-x:auto; overflow-y:auto;">
                                    <table class="table table-bordered table-sm mb-0 align-middle" style="min-width:1900px; white-space:nowrap;">

                                        <thead class="custom-blue text-center align-middle sticky-top" style="z-index:0;">

                                            <tr>

                                                @foreach (var col in Columns.Where(x => x.IsVisible))
                                                {
                                                    <th style="min-width:@col.Width; class="text-center">
                                                        @col.Title
                                                    </th>
                                                }
                                            </tr>

                                        </thead>

                                        <tbody class="custom-size">

                                            @foreach (var row in FilteredReportList)
                                            {

                                                <tr>

                                                    @foreach (var col in Columns.Where(x => x.IsVisible))
                                                    {
                                                        <td class="@col.Align">
                                                            @switch (col.Field)
                                                            {
                                                                case "SlNo":
                                                                    @row.SlNo
                                                                    break;

                                                                case "Operator":
                                                                    @row.Operator
                                                                    break;
                                                                case "TotalTargetQty":
                                                                    @row.TotalTargetQty
                                                                    break;
                                                                case "OperatorEfficiency":
                                                                    @row.OperatorEfficiency
                                                                    break;
                                                                case "TotalQtyProduced":
                                                                    @row.TotalQtyProduced
                                                                    break;
                                                                case "TotalQtyRejected":
                                                                    @row.TotalQtyRejected
                                                                    break;
                                                                case "OperatorProdForActualMcHrs":
                                                                    @row.OperatorProdForActualMcHrs
                                                                    break;


                                                            }

                                                        </td>
                                                    }
                                                </tr>
                                            }

                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>


                    }
                    else
                    {
                        <tr>
                            <td colspan="9"
                                class="text-center text-muted py-4 production-container  ">
                                No records found
                            </td>
                        </tr>
                    }

                </div>
            }




        </div>
    </div>


}

@code {
    protected override string ScreenName => "OperatorSummary";
    private bool isProcessing = true;
    private DateTime fromDate = DateTime.Today.AddMonths(-1);
    private DateTime toDate = DateTime.Today;
    //Abhishek
    private List<OperationSummaryVM> reportList = new();
    private string searchText = string.Empty;


    private bool IsLoading;
    private List<PageHeader.BreadcrumbItem> OperatorSummaryBreadcrumbs { get; set; } = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Reports",Url="reports-home" },
        new PageHeader.BreadcrumbItem { Text = "Production",Url="reports-home" },
        new PageHeader.BreadcrumbItem { Text = "Operator_Summary Report", IsLast = true }
    };
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = "";
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }
    public List<GridColumn> Columns { get; set; } = new();
    private string? UserName;



    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            await InitializeColumns(IsHidden);
            await LoadData();
            UserName = await CurrentUserService.GetUsernameAsync();
            await LoadColumnPreferences(UserName);

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync in Stock Positions");

        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadData()
    {
        try
        {

            reportList = await _operatorSummaryService.GetOperatorSummary(fromDate, toDate);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task OnPrintPendingTrack()
    {
        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");

    }

    private async Task confirmation_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (isConfirmed && confirmation == "Export")
            {
                await ExportToExcel(isConfirmed);
                confirmation = "";
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Export Purchase Sales Track Data confirmation_Click() method");
            await _JS.ToastrError("An error occurred while handling the Purchase Sales Track confirmation_Click() method");
        }
    }
    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;

            List<Dictionary<string, object>> exportData = new();


            if (FilteredReportList != null
                    && FilteredReportList.Any())
            {
                exportData = GetExportData(
                FilteredReportList.ToList());
            }



            if (!exportData.Any())
                return;

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "Operator_Track", "Operator_Track Report");

            var base64 = Convert.ToBase64String(bytes);

            await _JS.DownloadExcelAsync(base64, "Operator_Summary_Track.xlsx");

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in Purchase_Sales_Track");
            await _JS.ToastrError("Error while exporting Operator_Summary_Track!");
        }
        finally
        {
            isProcessing = false;
        }
    }
    private List<Dictionary<string, object>> GetExportData<T>(List<T> data)
    {
        return data
        .Select(row =>
        {
            var dict = new Dictionary<string, object>();


            foreach (var col in Columns.Where(x => x.IsVisible))
            {
                var prop = typeof(T).GetProperty(col.Field);

                if (prop != null)
                {
                    dict[col.Title] = prop.GetValue(row);
                }
            }



            return dict;
        })
        .ToList();
    }

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
              Columns = new List<GridColumn>
              {
                      new() { Title="SlNo", Field="SlNo", Width="5px", IsVisible = true },

                      new() { Title="Operator", Field="Operator", Width="30px", Align="text-center", IsVisible = true },

                      new() { Title="TotalTargetQty", Field="TotalTargetQty", Width="30px",Align="text-center", IsVisible = true },

                      new() { Title="OperatorEfficiency", Field="OperatorEfficiency", Width="30px",Align="text-center", IsVisible = true },

                      new() { Title="TotalQtyProduced", Field="TotalQtyProduced", Width="30px", Align="text-center", IsVisible = true },

                      new() { Title="TotalQtyRejected", Field="TotalQtyRejected", Width="30px", Align="text-center", IsVisible = true },

                       new() { Title="OperatorProdForActualMcHrs", Field="OperatorProdForActualMcHrs", Width="30px" ,Align="text-start", IsVisible = true},

                     // new() { Title="FinalEfficiency", Field="FinalEfficiency", Width="130px", Align="text-start", IsVisible = false },


              };

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Export Purchase Sales Track confirmation_Click() method");
            await _JS.ToastrError("An error occurred while handling the Purchase Sales Track  confirmation_Click() method");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for Customer List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }
    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {

            Columns = updated;
            await LoadColumnPreferences(UserName);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Purchase Sales Track HandleColumnChange() Method");
        }
    }
    private IEnumerable<OperationSummaryVM> FilteredReportList =>
    (string.IsNullOrWhiteSpace(searchText)
        ? reportList
        : reportList.Where(x =>
            (x.Operator?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (x.OperatorEfficiency?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            x.TotalQtyRejected.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase)
        ))
    .Select((x, index) =>
    {
        x.SlNo = index + 1;
        return x;
    });

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(searchText))
            return;

        if (reportList is null || !reportList.Any())
        {
            await _JS.ToastrWarning("No data available to search.");
            return;
        }

    }

}





