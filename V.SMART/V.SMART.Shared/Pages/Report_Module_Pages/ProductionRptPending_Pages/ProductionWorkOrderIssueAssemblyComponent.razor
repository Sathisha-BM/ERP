                                                                        <th>Trans Type</th>
                                                                }
                                                                @if (IsVisible("RefRcNo"))
                                                                {
                                                                        <th>RefRcNo</th>
                                                                }
                                                                @if (IsVisible("RCDATE"))
                                                                {
                                                                        <th>RCDATE</th>
                                                                }
                                                                @if (IsVisible("ProcessName"))
                                                                {
                                                                        <th>ProcessName</th>
                                                                }
                                                                @if (IsVisible("MachineName"))
                                                                {
                                                                        <th>MachineName</th>
                                                                }
                                                                @if (IsVisible("NoOfItems"))
                                                                {
                                                                        <th>NoOfItems</th>
                                                                }
                                              


                                                        }
                                                }
                                                else if (SelectedType == "Production Assembly")
                                                {
                                                        @if (IsVisible("SlNo"))
                                                        {
                                                                <th>Sl No</th>
                                                        }
                                                        @if (IsVisible("IssueNo"))
                                                        {
                                                                <th>Issue No</th>
                                                        }
                                                        @if (IsVisible("IssueDate"))
                                                        {
                                                                <th>Issue Date</th>
                                                        }
                                                        @if (IsVisible("IssueToWhom"))
                                                        {
                                                                <th>IssueToWhom</th>
                                                        }
                                                        @if (IsVisible("CreatedBy"))
                                                        {
                                                                <th>CreatedBy</th>
                                                        }
                                                        @if (IsVisible("CreatedDate"))
                                                        {
                                                                <th>CreatedDate</th>
                                                        }

                                                        @if (DetailsView)
                                                        {
                                                                @if (IsVisible("CustName"))
                                                                {
                                                                        <th>Ref Customer</th>
                                                                }
                                                                @if (IsVisible("AssyItemCode"))
                                                                {
                                                                        <th>Assembly Item Code</th>
                                                                }
                                                                @if (IsVisible("AssyItemName"))
                                                                {
                                                                        <th>Assembly Item Name</th>
                                                                }
