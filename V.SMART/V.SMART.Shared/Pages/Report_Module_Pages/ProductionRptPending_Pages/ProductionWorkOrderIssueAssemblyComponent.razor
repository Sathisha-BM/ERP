    private List<CategoryQtyChartVM> GetCategoryChartData(
        IEnumerable<dynamic> data,
        Func<dynamic, string?> selector)
    {
        if (data == null)
            return new List<CategoryQtyChartVM>();

        return data
            .Select(x => new
            {
                Category = selector(x),

                Qty = Convert.ToDecimal(x.Qty)
            })
            .Where(x => !string.IsNullOrWhiteSpace(x.Category))
            .GroupBy(x => x.Category!)
            .Select(g => new CategoryQtyChartVM
            {
                Category = g.Key,

                Qty = g.Sum(x => x.Qty)
            })
            .OrderByDescending(x => x.Qty)
            .Take(10)
            .ToList();
    }

