                                                                {
                                                                        <th>Item Name</th>
                                                                }
                                                                @if (IsVisible("CustName"))
                                                                {
                                                                        <th>Ref CustName</th>
                                                                }
                                                                @if (IsVisible("PONo"))
                                                                {
                                                                        <th>Ref PO No</th>
                                                                }
                                                                @if (IsVisible("PODate"))
