                                                                        <th>Item Code</th>
                                                                }
                                                                @if (IsVisible("ItemName"))
                                                                {
                                                                        <th>Item Name</th>
                                                                }
                                                                @if (IsVisible("Qty"))
                                                                {
                                                                        <th>Issue Qty</th>
                                                                }
                                                                @if (IsVisible("BalQty"))
                                                                {
                                                                        <th>Bal Qty</th>
                                                                }
                                                                @if (IsVisible("JobNo"))
                                                                {
                                                                        <th>Ref Job No</th>
                                                                }
                                                                @if (IsVisible("PONo"))
                                                                {
                                                                        <th>Ref PONo</th>
                                                                }
                                                                @if (IsVisible("PODate"))
                                                                {
                                                                        <th>Ref PODate</th>
                                                                }
                                               
                                                                @if (IsVisible("NoOfItems"))
                                                                {
                                                                        <th>NoOfItems</th>
                                                                }
                                               

                                                    
                                                        }
