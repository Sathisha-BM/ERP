    private IEnumerable<ProductionWorkOrderVM> FilteredRatings
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText) || searchText.Length < 3)
                return ProductionWorkOrderIssueList;

            return ProductionWorkOrderIssueList.Where(x =>
                (x.CustName ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                || (x.ItemCode ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                || (x.ItemName ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                || (x.IssueNo ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                || (x.PONo ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)
                   
                || (x.IssueToWhom ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                 || (x.RefRcNo ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                 || (x.MachineName ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                 || (x.ProcessName ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                  || (x.RefGrnNo ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)


                  || (x.RefIssueNo ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)


                  || (x.JobNo ?? string.Empty)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)


            );
        }
    }

    private Task<IEnumerable<string>> SearchCustomers(
      string? value,
      CancellationToken cancellationToken)
    {
        IEnumerable<string> result = Parties
            .Where(x => !string.IsNullOrWhiteSpace(x.PartyName))
            .Select(x => x.PartyName);

        if (!string.IsNullOrWhiteSpace(value))
        {
            result = result.Where(x =>
                x.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(result);
    }



    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;

            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo(
                    "/access-denied"
                );

                return;
            }

            UserName =  await CurrentUserService.GetUsernameAsync();

            ToDate = DateTime.Today;

            FromDate = DateTime.Today.AddMonths(-1);

            SelectedType = "Production Component";
            await LoadVendorsAsync();

        }
        catch (Exception ex)
        {
            await LoggingService
                .LogDeveloperError(ex,"Error while loading Production Work Order Issue screen." );
        }
        finally
        {
            isProcessing = false;
        }
    }



    private async Task OnPartyTypeChanged(string value)
    {
        SelectedType = value;
        ProductionWorkOrderIssueList.Clear();
        DetailsView = false;
        ShowCharts = false;
        ShowDetailsView = false;

        Parties.Clear();

        SelectedPartyCode = null;
        SelectedParty = null;

        
        ShowRatings = false;
    
        await InitializeColumns();
        await LoadVendorsAsync();

    }

    private async Task LoadVendorsAsync()
    {
        try
        {
           var customers = await ProductionWorkOrderIssueAssemblyComponentService
                .GetAllCustomerAsync(
                    SelectedType,
                    FromDate!.Value,
                    ToDate!.Value);

            Parties = customers?
                .OfType<CustomerVM>()
                .Where(x => !string.IsNullOrWhiteSpace(x.CustName))
                .DistinctBy(x => x.CustName)
                .Select(x => new PartyVM
                {
                    PartyName = x.CustName
                })
                .OrderBy(x => x.PartyName)
                .ToList()
                ?? new List<PartyVM>();

            if (Parties.Any())
            {
                Parties.Insert(0, new PartyVM
                {
                    PartyCode = 0,
                    PartyName = "All Parties"
                });
            }

        }
        catch (Exception ex)
        {
            
            throw;
        }
    }

  


    private async Task OnPartyChanged(string? party)
    {
        try
        {
            isProcessing = true;

            DetailsView = false;
            ShowCharts = false;

            SelectedParty = party;

            // No party selected
            if (string.IsNullOrWhiteSpace(SelectedParty))
            {
                ProductionWorkOrderIssueList =
                    new List<ProductionWorkOrderVM>();

                ShowRatings = false;
                ShowDetailsView = false;

                return;
            }

            // Specific IssueToWhom selected
            ShowDetailsView = true;

            ProductionWorkOrderIssueList =
            await ProductionWorkOrderIssueAssemblyComponentService
            .GetProductionWorkOrderIssueAsync(
             DetailsView,
             SelectedType,
             SelectedParty,
             FromDate,
             ToDate);

            ShowRatings =
                ProductionWorkOrderIssueList?.Any() == true;
        }
        catch (Exception ex)
        {
            ProductionWorkOrderIssueList =
                new List<ProductionWorkOrderVM>();

            ShowRatings = false;

            await LoggingService.LogDeveloperError(
                ex,
                "Error loading Production WorkOrder Issue");
        }
        finally
        {
            isProcessing = false;
        }
    }
  




