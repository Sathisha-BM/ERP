    private async Task OnPrintPendingTrack()
    {
        try
        {
            var data = FilteredRatings?.ToList();

            // ============================================================
            // VALIDATE DATA
            // ============================================================

            if (data == null || !data.Any())
            {
                await _JS.InvokeVoidAsync(
                    "alert",
                    "No data found to export.");

                return;
            }

            // ============================================================
            // VALIDATE PRODUCTION TYPE
            // ============================================================

            if (SelectedType != "Production Component" &&
                SelectedType != "Production Assembly")
            {
                await _JS.InvokeVoidAsync(
                    "alert",
                    "Invalid production type.");

                return;
            }

            // ============================================================
            // PRODUCTION COMPONENT
            // ============================================================

            if (SelectedType == "Production Component")
            {
                // --------------------------------------------------------
                // HEADERS
                // --------------------------------------------------------

                var headers = new List<string>();

                if (IsVisible("SlNo"))
                    headers.Add("Sl No");

                if (IsVisible("IssueNo"))
                    headers.Add("Issue No");

                if (IsVisible("IssueDate"))
                    headers.Add("Issue Date");

                if (IsVisible("IssueToWhom"))
                    headers.Add("Issue To Whom");

                if (IsVisible("CreatedBy"))
                    headers.Add("Created By");

                if (IsVisible("CreatedDate"))
                    headers.Add("Created Date");

                if (DetailsView)
                {
                    if (IsVisible("ItemCode"))
                        headers.Add("Item Code");

                    if (IsVisible("ItemName"))
                        headers.Add("Item Name");

                    @if (IsVisible("CustName"))
                    {
                        headers.Add("Ref CustName");
                        
                    }
                    if (IsVisible("PONo"))
                        headers.Add("Ref PO No");

                    if (IsVisible("PODate"))
                        headers.Add("Ref PO Date");

                    if (IsVisible("Qty"))
                        headers.Add("Issue Qty");

                    if (IsVisible("BalQty"))
                        headers.Add("Bal Qty");

                    if (IsVisible("TransType"))
                        headers.Add("Trans Type");

                    if (IsVisible("RefRcNo"))
                        headers.Add("RefRcNo");

                    if (IsVisible("RCDATE"))
                        headers.Add("RCDATE");

                    if (IsVisible("ProcessName"))
                        headers.Add("Process Name");

                    if (IsVisible("MachineName"))
                        headers.Add("Machine Name");

                    if (IsVisible("NoOfItems"))
                        headers.Add("No Of Items");


                }

                // --------------------------------------------------------
                // CHECK HEADERS
                // --------------------------------------------------------

                if (headers.Count == 0)
                {
                    await _JS.InvokeVoidAsync(
                        "alert",
                        "No visible columns found.");

                    return;
                }

                // --------------------------------------------------------
                // CREATE EXPORT DATA
                // --------------------------------------------------------

                var exportRows = new List<Dictionary<string, object?>>();

                foreach (var x in data)
                {
                    var row = new Dictionary<string, object?>();

                    if (IsVisible("SlNo"))
                        row["SlNo"] = exportRows.Count + 1;

                    if (IsVisible("IssueNo"))
                        row["IssueNo"] = x.IssueNo;

                    if (IsVisible("IssueDate"))
                        row["IssueDate"] = x.IssueDate;

                    if (IsVisible("IssueToWhom"))
                        row["IssueToWhom"] = x.IssueToWhom;

                    if (IsVisible("CreatedBy"))
                        row["CreatedBy"] = x.CreatedBy;

                    if (IsVisible("CreatedDate"))
                        row["CreatedDate"] = x.CreatedDate;

                    if (DetailsView)
                    {
                        if (IsVisible("ItemCode"))
                            row["ItemCode"] = x.ItemCode;

                        if (IsVisible("ItemName"))
                            row["ItemName"] = x.ItemName;

                        if (IsVisible("CustName"))
                            row["CustName"] = x.CustName;

                        if (IsVisible("PONo"))
                            row["PONo"] = x.PONo;

                        if (IsVisible("PODate"))
                            row["PODate"] = x.PODate;

                        if (IsVisible("Qty"))
                            row["Qty"] = x.Qty;

                        if (IsVisible("BalQty"))
                            row["BalQty"] = x.BalQty;

                        if (IsVisible("TransType"))
                        {
                            row["TransType"] = x.TransType == "InCode"
                                ? $"<span class=\"text-success fw-bold\">{x.TransType}</span>"
                                : x.TransType == "OutCode"
                                    ? $"<span class=\"text-danger fw-bold\">{x.TransType}</span>"
                                    : x.TransType;
                        }

                        if (IsVisible("RefRcNo"))
                            row["RefRcNo"] = x.RefRcNo;

                        if (IsVisible("RCDATE"))
                            row["RCDATE"] = x.RCDATE;

                        if (IsVisible("ProcessName"))
                            row["ProcessName"] = x.ProcessName;

                        if (IsVisible("MachineName"))
                            row["MachineName"] = x.MachineName;


                        if (IsVisible("NoOfItems"))
                            row["NoOfItems"] = x.NoOfItems;


                    }

                    exportRows.Add(row);
                }

                // --------------------------------------------------------
                // CREATE OBJECTS WITH ONLY VISIBLE PROPERTIES
                // --------------------------------------------------------

                var exportData = CreateExportObjects(
                    exportRows,
                    headers.Count);

                // --------------------------------------------------------
                // CREATE EXCEL
                // --------------------------------------------------------

                var fileBytes =
                    await excelTemplateService.CreateTemplateAsync(
                        sheetName: "Production Component",
                        headers: headers.ToArray(),
                        sampleData: exportData);

                // --------------------------------------------------------
                // DOWNLOAD
                // --------------------------------------------------------

                await _JS.InvokeVoidAsync(
                    "downloadExcelFile",
                    Convert.ToBase64String(fileBytes),
                    "Production_Workorder_Component Issue.xlsx");

                return;
            }

            // ============================================================
            // PRODUCTION ASSEMBLY
            // ============================================================

            if (SelectedType == "Production Assembly")
            {
                // --------------------------------------------------------
                // HEADERS
                // --------------------------------------------------------

                var headers = new List<string>();

                if (IsVisible("SlNo"))
                    headers.Add("Sl No");

                if (IsVisible("IssueNo"))
                    headers.Add("Issue No");

                if (IsVisible("IssueDate"))
                    headers.Add("Issue Date");

                if (IsVisible("IssueToWhom"))
                    headers.Add("Issue To Whom");

                if (IsVisible("CreatedBy"))
                    headers.Add("Created By");

                if (IsVisible("CreatedDate"))
                    headers.Add("Created Date");

                if (DetailsView)
                {
                    if (IsVisible("CustName"))
                        headers.Add("Ref Customer");

                    if (IsVisible("AssyItemCode"))
                        headers.Add("Assembly Item Code");

                    if (IsVisible("AssyItemName"))
                        headers.Add("Assembly Item Name");

                    if (IsVisible("ItemCode"))
                        headers.Add("Item Code");

                    if (IsVisible("ItemName"))
                        headers.Add("Item Name");

                    if (IsVisible("Qty"))
                        headers.Add("Issue Qty");

                    if (IsVisible("BalQty"))
                        headers.Add("Bal Qty");

                    if (IsVisible("JobNo"))
                        headers.Add("Ref Job No");

                    if (IsVisible("PONo"))
                        headers.Add("Ref PO No");

                    if (IsVisible("PODate"))
                        headers.Add("Ref PO Date");

                    if (IsVisible("IssueToWhom"))
                        headers.Add("Issue To Whom");

                    if (IsVisible("NoOfItems"))
                        headers.Add("No Of Items");

                    if (IsVisible("CreatedBy"))
                        headers.Add("Created By");

                    if (IsVisible("CreatedDate"))
                        headers.Add("Created Date");
                }

                // --------------------------------------------------------
                // CHECK HEADERS
                // --------------------------------------------------------

                if (headers.Count == 0)
                {
                    await _JS.ToastrWarning("No visible columns found.");

                    return;
                }

                // --------------------------------------------------------
                // CREATE EXPORT DATA
                // --------------------------------------------------------

                var exportRows = new List<Dictionary<string, object?>>();

                foreach (var x in data)
                {
                    var row = new Dictionary<string, object?>();

                    if (IsVisible("SlNo"))
                        row["SlNo"] = exportRows.Count + 1;

                    if (IsVisible("IssueNo"))
                        row["IssueNo"] = x.IssueNo;

                    if (IsVisible("IssueDate"))
                        row["IssueDate"] = x.IssueDate;

                    if (IsVisible("IssueToWhom"))
                        row["IssueToWhom"] = x.IssueToWhom;

                    if (IsVisible("CreatedBy"))
                        row["CreatedBy"] = x.CreatedBy;

                    if (IsVisible("CreatedDate"))
                        row["CreatedDate"] = x.CreatedDate;

                    if (DetailsView)
                    {
                        if (IsVisible("CustName"))
                            row["CustName"] = x.CustName;

                        if (IsVisible("AssyItemCode"))
                            row["AssyItemCode"] = x.AssyItemCode;

                        if (IsVisible("AssyItemName"))
                            row["AssyItemName"] = x.AssyItemName;

                        if (IsVisible("ItemCode"))
                            row["ItemCode"] = x.ItemCode;

                        if (IsVisible("ItemName"))
                            row["ItemName"] = x.ItemName;

                        if (IsVisible("Qty"))
                            row["Qty"] = x.Qty;

                        if (IsVisible("BalQty"))
                            row["BalQty"] = x.BalQty;

                        if (IsVisible("JobNo"))
                            row["JobNo"] = x.JobNo;

                        if (IsVisible("PONo"))
                            row["PONo"] = x.PONo;

                        if (IsVisible("PODate"))
                            row["PODate"] = x.PODate;

                        if (IsVisible("IssueToWhom"))
                            row["IssueToWhom"] = x.IssueToWhom;

                        if (IsVisible("NoOfItems"))
                            row["NoOfItems"] = x.NoOfItems;

                        if (IsVisible("CreatedBy"))
                            row["CreatedBy"] = x.CreatedBy;

                        if (IsVisible("CreatedDate"))
                            row["CreatedDate"] = x.CreatedDate;
                    }

                    exportRows.Add(row);
                }

                // --------------------------------------------------------
                // CREATE OBJECTS WITH ONLY VISIBLE PROPERTIES
                // --------------------------------------------------------

                var exportData = CreateExportObjects(
                    exportRows,
                    headers.Count);

                // --------------------------------------------------------
                // CREATE EXCEL
                // --------------------------------------------------------

                var fileBytes =
                    await excelTemplateService.CreateTemplateAsync(
                        sheetName: "Production Assembly",
                        headers: headers.ToArray(),
                        sampleData: exportData);

                // --------------------------------------------------------
                // DOWNLOAD
                // --------------------------------------------------------

                await _JS.InvokeVoidAsync(
                    "downloadExcelFile",
                    Convert.ToBase64String(fileBytes),
                    "Production_Workorder_Assembly Issue.xlsx");

                return;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "Error in OnPrintPendingTrack()");
        }
    }

    private List<object> CreateExportObjects(
    List<Dictionary<string, object?>> rows,
    int totalColumns)
    {
        var result = new List<object>();

        if (rows == null || rows.Count == 0)
            return result;

        // Get property names from first row
        var propertyNames = rows[0].Keys.ToList();

        // Create dynamic runtime type
        var assemblyName =
            new System.Reflection.AssemblyName(
                "DynamicExcelExportAssembly");

        var assemblyBuilder =
            System.Reflection.Emit.AssemblyBuilder.DefineDynamicAssembly(
                assemblyName,
                System.Reflection.Emit.AssemblyBuilderAccess.Run);

        var moduleBuilder =
            assemblyBuilder.DefineDynamicModule(
                "DynamicExcelExportModule");

        var typeBuilder =
            moduleBuilder.DefineType(
                "DynamicExportRow_" + Guid.NewGuid().ToString("N"),
                System.Reflection.TypeAttributes.Public |
                System.Reflection.TypeAttributes.Class);

        // ------------------------------------------------------------
        // CREATE ONLY REQUIRED PROPERTIES
        // ------------------------------------------------------------

        foreach (var propertyName in propertyNames)
        {
            // Find actual value from first row
            object? sampleValue = null;

            foreach (var row in rows)
            {
                if (row.TryGetValue(propertyName, out var value) &&
                    value != null)
                {
                    sampleValue = value;
                    break;
                }
            }

            Type propertyType;

            if (sampleValue != null)
            {
                propertyType = sampleValue.GetType();

                // Nullable handling is not needed for most values,
                // because Excel can accept the underlying value.
                if (propertyType.IsValueType)
                {
                    propertyType = Nullable.GetUnderlyingType(propertyType)
                        ?? propertyType;
                }
            }
            else
            {
                propertyType = typeof(string);
            }

            // --------------------------------------------------------
            // PROPERTY
            // --------------------------------------------------------

            var fieldBuilder =
                typeBuilder.DefineField(
                    "_" + propertyName,
                    propertyType,
                    System.Reflection.FieldAttributes.Private);

            var propertyBuilder =
                typeBuilder.DefineProperty(
                    propertyName,
                    System.Reflection.PropertyAttributes.None,
                    propertyType,
                    null);

            // --------------------------------------------------------
            // GETTER
            // --------------------------------------------------------

            var getterBuilder =
                typeBuilder.DefineMethod(
                    "get_" + propertyName,
                    System.Reflection.MethodAttributes.Public |
                    System.Reflection.MethodAttributes.SpecialName |
                    System.Reflection.MethodAttributes.HideBySig,
                    propertyType,
                    Type.EmptyTypes);

            var getterIL =
                getterBuilder.GetILGenerator();

            getterIL.Emit(
                System.Reflection.Emit.OpCodes.Ldarg_0);

            getterIL.Emit(
                System.Reflection.Emit.OpCodes.Ldfld,
                fieldBuilder);

            getterIL.Emit(
                System.Reflection.Emit.OpCodes.Ret);

            // --------------------------------------------------------
            // SETTER
            // --------------------------------------------------------

            var setterBuilder =
                typeBuilder.DefineMethod(
                    "set_" + propertyName,
                    System.Reflection.MethodAttributes.Public |
                    System.Reflection.MethodAttributes.SpecialName |
                    System.Reflection.MethodAttributes.HideBySig,
                    null,
                    new[] { propertyType });

            var setterIL =
                setterBuilder.GetILGenerator();

            setterIL.Emit(
                System.Reflection.Emit.OpCodes.Ldarg_0);

            setterIL.Emit(
                System.Reflection.Emit.OpCodes.Ldarg_1);

            setterIL.Emit(
                System.Reflection.Emit.OpCodes.Stfld,
                fieldBuilder);

            setterIL.Emit(
                System.Reflection.Emit.OpCodes.Ret);

            propertyBuilder.SetGetMethod(getterBuilder);
            propertyBuilder.SetSetMethod(setterBuilder);
        }

        // ------------------------------------------------------------
        // CREATE TYPE
        // ------------------------------------------------------------

        var dynamicType =
            typeBuilder.CreateType();

        if (dynamicType == null)
            return result;

        // ------------------------------------------------------------
        // CREATE OBJECT FOR EACH ROW
        // ------------------------------------------------------------

        foreach (var row in rows)
        {
            var obj =
                Activator.CreateInstance(dynamicType);

            if (obj == null)
                continue;

            foreach (var propertyName in propertyNames)
            {
                var property =
                    dynamicType.GetProperty(propertyName);

                if (property == null)
                    continue;

                row.TryGetValue(
                    propertyName,
                    out var value);

                if (value == null)
                {
                    continue;
                }

                try
                {
                    var targetType =
                        property.PropertyType;

                    if (value.GetType() != targetType)
                    {
                        if (Nullable.GetUnderlyingType(targetType) != null)
                        {
                            targetType =
                                Nullable.GetUnderlyingType(targetType)!;
                        }

                        value =
                            Convert.ChangeType(
                                value,
                                targetType);
                    }

                    property.SetValue(
                        obj,
                        value);
                }
                catch
                {
                    // If conversion fails, keep default value
                }
            }

            result.Add(obj);
        }

        return result;
    }

