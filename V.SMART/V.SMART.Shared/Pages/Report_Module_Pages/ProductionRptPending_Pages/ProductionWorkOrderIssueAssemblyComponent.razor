@page "/ProductionWorkOrderIssueAssemblyComponent"

@using ApexCharts
@using MudBlazor
@using System.Text
@using System.Net
@using V.SMART.Shared.BusinessLayer.BusinessService.ReportService.TrackReportService
@using V.SMART.Shared.ViewModels.AccountsViewModel
@using V.SMART.Shared.ViewModels.ReportViewModel.PoPendingModel
@using V.SMART.Shared.ViewModels.ReportViewModel.ProductionWorkOrder
@using VSmartGridColumn = V.SMART.Shared.ViewModels.GridColumn

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IProductionWorkOrderIssueAssemblyComponentService ProductionWorkOrderIssueAssemblyComponentService
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService




<style>
    .trans-in {
        background: #198754;
        color: white;
        padding: 4px 14px;
        border-radius: 20px;
        font-weight: 600;
        display: inline-block;
        min-width: 60px;
        text-align: center;
    }

    .trans-out {
        background: #dc3545;
        color: white;
        padding: 4px 14px;
        border-radius: 20px;
        font-weight: 600;
        display: inline-block;
        min-width: 60px;
        text-align: center;
    }

    .column-menu-up .dropdown-menu {
        top: auto !important;
        bottom: 100% !important;
        transform: none !important;
        margin-bottom: 4px !important;
    }

    .production-page {
        min-height: 100vh;
        background: linear-gradient( 135deg, #f4f7fb 0%, #eef3f8 100% );
    }

    .main-card {
        background: white;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 12px 45px rgba(15, 32, 39, .10);
    }

    /* HERO */

    .production-banner {
        margin: 20px;
        padding: 30px;
        border-radius: 20px;
        color: white;
        background: linear-gradient( 120deg, #0f2027, #203a43, #2c5364 );
        position: relative;
        overflow: hidden;
    }

        .production-banner::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: -90px;
            top: -130px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }

    .banner-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        font-size: 32px;
        margin-right: 20px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.18);
    }

    .banner-badge {
        display: inline-block;
        padding: 5px 12px;
        margin-bottom: 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        border-radius: 50px;
        background: rgba(255,255,255,.13);
    }

    .date-card {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 17px;
        border-radius: 15px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.15);
    }

    .date-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 21px;
        background: rgba(255,255,255,.16);
    }

    /* FILTER */

    .filter-card {
        margin: 20px;
        border-radius: 20px;
        background: white;
        border: 1px solid #e8edf3;
        box-shadow: 0 8px 28px rgba(0,0,0,.05);
    }

    .filter-card-header {
        padding: 20px 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #edf0f4;
    }

        .filter-card-header h5 {
            margin: 0;
            color: #183b4e;
            font-weight: 700;
        }

        .filter-card-header span {
            font-size: 13px;
            color: #7a8793;
        }

    .filter-status {
        color: #198754;
        font-weight: 600;
        font-size: 13px;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        display: inline-block;
        border-radius: 50%;
        background: #20c997;
        margin-right: 6px;
    }

    .filter-card-body {
        padding: 25px;
    }

    .filter-label {
        display: block;
        margin-bottom: 8px;
        font-weight: 700;
        font-size: 13px;
        color: #34495e;
    }

    .production-input {
        height: 46px;
        border-radius: 11px;
        border: 1px solid #dce3ea;
    }

        .production-input:focus {
            border-color: #2c5364;
            box-shadow: 0 0 0 .18rem rgba(44,83,100,.12);
        }

    /* RADIO */

    .production-radio-group {
        display: flex;
        gap: 12px;
    }

    .production-radio {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 13px;
        cursor: pointer;
        border-radius: 12px;
        border: 1px solid #dce3ea;
        transition: all .25s ease;
        background: #f9fbfc;
    }

        .production-radio:hover {
            transform: translateY(-2px);
            border-color: #2c5364;
            box-shadow: 0 7px 16px rgba(44,83,100,.10);
        }

        .production-radio strong {
            display: block;
            font-size: 13px;
            color: #263746;
        }

        .production-radio small {
            display: block;
            font-size: 11px;
            color: #84919c;
        }

    .radio-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: white;
    }

    .component {
        background: linear-gradient( 135deg, #007bff, #00a8ff );
    }

    .assembly {
        background: linear-gradient( 135deg, #f59e0b, #ef4444 );
    }

    /* BUTTON */

    .load-button {
        height: 46px;
        border: 0;
        color: white;
        font-weight: 700;
        border-radius: 11px;
        background: linear-gradient( 135deg, #0f2027, #2c5364 );
        transition: all .25s ease;
    }

        .load-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(15,32,39,.25);
        }

    /* LIST */

    .list-card {
        margin: 20px;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #e7edf2;
    }

    .list-toolbar {
        padding: 20px 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        background: linear-gradient( 90deg, #f8fafc, #ffffff );
        border-bottom: 1px solid #e8edf2;
    }

    .list-title {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .list-title-icon {
        width: 47px;
        height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: white;
        background: linear-gradient( 135deg, #0f766e, #14b8a6 );
    }

    .list-title h5 {
        margin: 0;
        font-weight: 700;
        color: #263746;
    }

    .list-title span {
        font-size: 12px;
        color: #84919c;
    }

    .toolbar-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .search-box {
        position: relative;
        width: 245px;
    }

        .search-box i {
            position: absolute;
            left: 13px;
            top: 13px;
            color: #84919c;
        }

        .search-box input {
            padding-left: 38px;
            height: 43px;
            border-radius: 11px;
        }

    .detail-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .detail-toggle input {
            display: none;
        }

    .toggle-slider {
        width: 39px;
        height: 21px;
        position: relative;
        border-radius: 20px;
        background: #cbd5df;
        transition: .25s;
    }

        .toggle-slider::before {
            content: "";
            position: absolute;
            width: 15px;
            height: 15px;
            left: 3px;
            top: 3px;
            border-radius: 50%;
            background: white;
            transition: .25s;
        }

    .detail-toggle input:checked + .toggle-slider {
        background: #198754;
    }

        .detail-toggle input:checked + .toggle-slider::before {
            transform: translateX(18px);
        }

    .export-button {
        height: 43px;
        padding: 0 17px;
        border: 0;
        border-radius: 10px;
        color: white;
        font-weight: 700;
        background: linear-gradient( 135deg, #198754, #20c997 );
    }

    .production-table-container {
        min-height: 300px;
    }

    .empty-state {
        text-align: center;
        padding: 70px 20px;
    }

    .empty-icon {
        width: 75px;
        height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto auto 18px;
        border-radius: 22px;
        font-size: 32px;
        color: #2c5364;
        background: #edf4f7;
    }

    .empty-state h5 {
        font-weight: 700;
        color: #34495e;
    }

    .empty-state p {
        color: #87939e;
    }

    .production-table thead {
        background: #203a43;
        color: white;
    }

    .production-table th {
        padding: 14px;
    }

    .pending-badge {
        padding: 5px 11px;
        border-radius: 50px;
        color: #b45309;
        background: #fff3cd;
        font-size: 11px;
        font-weight: 700;
    }

    @@media(max-width: 992px) {

        .production-radio-group {
            flex-direction: column;
        }

        .toolbar-actions {
            width: 100%;
        }

        .search-box {
            width: 100%;
        }
    }

    @@media(max-width: 576px) {

        .production-banner {
            padding: 22px;
        }

        .banner-icon {
            width: 55px;
            height: 55px;
            font-size: 24px;
        }

        .filter-card-header {
            align-items: flex-start;
            gap: 10px;
            flex-direction: column;
        }


    }

</style>
@if (isProcessing)
{
        <ProcessingOverlay Visible="@isProcessing"
                           Message="Loading production work order details..." />
}
else if (!CanView)
{
        <RedirectToLogin />
}
else
{

        <div class="container-fluid px-2 px-md-4 mt-4">


                <!-- PAGE HEADER -->
                <PageHeader TitleText="Production Work Order Issue"
                            TitleIcon="bi bi-gear-wide-connected"
                            Breadcrumbs="@ProductionBreadcrumbs" />

                 <div class="card shadow-lg border-0">

                    <!-- Top Banner -->
                    <div class="card-body">

                    <div class="rounded-3 p-4 text-white"
                         style="background: @(DateTime.Today == new DateTime(2026, 8, 15)
                                                       ? "linear-gradient(120deg, #FF9933 0%, #d97720 35%, #ffffff 50%, #3a8f3a 70%, #138808 100%);"
                                                       : "linear-gradient(120deg, #0b3c5d, #1d70a2, #328cc1);");">
                    

                        <div class="row align-items-center">

                                <div class="col-lg-8">



                                    <h2 class="fw-bold mb-2"
                                        style="font-family: Georgia, serif;">
                                       <i class="bi bi-gear-wide-connected me-2"></i>
                                        Production WorkOrder Issue
                                    </h2>
                                          
                                    <p class="mb-0">
                                            Assembly / Component.
                                    </p>

                                </div>

                                <div class="col-lg-4 text-end">


                      

                                    <small>
                                        <i class="bi bi-calendar-event me-1"></i>
                                        @DateTime.Now.ToString("dd MMM yyyy")
                                    </small>

                                </div>

                            </div>

                        </div>

                    </div>

                   @*  <!-- FILTER SECTION -->
                <div class="filter-card"> *@

            
                   <!-- Filter -->
                     <div class="card-body bg-light border-top">

                           <div class="row align-items-center gy-3">

                        <!-- FROM DATE -->
                        <div class="col-12 col-md-6 col-xl-2">

                            <label class="form-label fw-bold text-dark">
                                <i class="bi bi-calendar2-week-fill text-primary me-2"></i>
                                From Date
                            </label>

                            <input type="date"
                                   class="form-control production-input"
                                   @bind="FromDate" />

                        </div>

                        <!-- TO DATE -->
                        <div class="col-12 col-md-6 col-xl-2">

                            <label class="form-label fw-bold text-dark">
                                <i class="bi bi-calendar2-week-fill text-primary me-2"></i>
                                To Date
                            </label>

                            <input type="date"
                                   class="form-control production-input @(ToDate < FromDate ? "is-invalid" : "")"
                                   @bind="ToDate"
                                   @bind:after="ValidateDateRange" />

                    @if (ToDate < FromDate)
                            {
                                    <div class="text-danger fw-bold mt-1">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                        To Date cannot be less than From Date.
                                    </div>
                            }

                        </div>

                                <!-- ISSUE TYPE -->
                                <div class="col-12 col-xl-4">

                                    <label class="form-label fw-bold text-primary">

                                        <i class="bi bi-diagram-3-fill me-1"></i>

                                        Production Issue Type

                                    </label>

                                    <InputRadioGroup TValue="string"
                                                        Value="@SelectedType"
                                                        ValueChanged="@OnPartyTypeChanged"
                                                        ValueExpression="() => SelectedType">

                                        <div class="production-radio-group">

                                            <label class="production-radio">

                                                <InputRadio Value="@("Production Component")" />

                                                <span class="radio-icon component">

                                                    <i class="bi bi-cpu"></i>

                                                </span>

                                                <span>

                                                    <strong>
                                                        Component Issue
                                                    </strong>

                                                    <small>
                                                        Production components
                                                    </small>

                                                </span>

                                            </label>

                                            <label class="production-radio">

                                                <InputRadio Value="@("Production Assembly")" />

                                                <span class="radio-icon assembly">

                                                    <i class="bi bi-gear-fill"></i>

                                                </span>

                                                <span>

                                                    <strong>
                                                        Assembly Issue
                                                    </strong>

                                                    <small>
                                                        Assembly materials
                                                    </small>

                                                </span>

                                            </label>

                                        </div>

                                    </InputRadioGroup>

                                </div>

                                <div class="col-12 col-xl-4">

                                    <label class="form-label fw-bold text-success mb-2">
                                        <i class="bi bi-person-badge-fill me-2"></i>
                                         IssueToWhom
                                    </label>

                            <MudAutocomplete T="string"
                                             Label="Select Party"
                                             Value="@SelectedParty"
                                             ValueChanged="@OnPartyChanged"
                                             SearchFunc="@SearchCustomers"
                                             ToStringFunc="@(s => s ?? "")"
                                             Variant="Variant.Outlined"
                                             Dense="true"
                                             Margin="Margin.Dense"
                                             OpenIcon="@Icons.Material.Filled.ArrowDropDown"
                                             CloseIcon="@Icons.Material.Filled.ArrowDropUp"
                                             ShowProgressIndicator="true"
                                             MinCharacters="0"
                                             OpenOnFocus="true"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="true"
                                             CoerceValue="false"
                                             Placeholder="Select Party"
                                             Clearable="true"
                                             Style="width:100%;" />
                                </div>
                            </div>

                    </div>


                <div class="container-fluid">
                <!-- HEADER CARD -->
                    <div class="card border-0 shadow-sm rounded-3 mb-3 bg-primary bg-opacity-10">

                    <div class="card-body p-3">

                        <div class="row g-2 align-items-center">

                            <!-- TITLE -->
                            <div class="col-12 col-xl-4">

                                <div class="d-flex align-items-center">

                                    <div class="bg-primary text-white rounded-3
                                            d-flex align-items-center justify-content-center
                                            flex-shrink-0 me-2"
                                         style="width:45px;height:45px;">

                                        <i class="bi bi-clipboard-data fs-5"></i>

                                    </div>

                                    <div>
                                        <h5 class="mb-0 fw-bold">
                                            Production WorkOrder Issue List
                                        </h5>

                                        <small class="text-muted">
                                                Track and manage production work order issues
                                        </small>
                                    </div>

                                </div>

                            </div>


                            <!-- TOOLBAR -->
                            <div class="col-12 col-xl-8">

                                <div class="d-flex flex-wrap flex-xl-nowrap
                                        justify-content-xl-end
                                        align-items-center gap-2">
                            @if (ShowDetailsView)
                                {
                                        <!-- SEARCH -->
                                        <div class="input-group"
                                        style="min-width:200px; max-width:300px;">

                                            <span class="input-group-text bg-white">
                                                <i class="bi bi-search"></i>
                                            </span>

                                            <input type="text"
                                            class="form-control"
                                            placeholder="Search Here..."
                                            @bind="searchText"
                                            @bind:event="oninput" />

                                        </div>

                                        <!-- COLUMN MENU -->
                                        <div class="flex-shrink-0 column-menu-up">
                                            <ColumnMenu Columns="Columns"
                                            ScreenName="@ScreenName"
                                            UserId="@UserName"
                                            MaxVisible="int.MaxValue"
                                            OnChanged="HandleColumnChange" />
                                        </div>


                                        <!-- DETAIL VIEW -->
                                        <div class="form-check form-switch
                                        d-flex align-items-center
                                        flex-shrink-0 mb-0">

                                            <input class="form-check-input"
                                            type="checkbox"
                                            checked="@DetailsView"
                                            @onchange="OnDetailViewChanged" />

                                            <label class="form-check-label ms-2 text-nowrap">
                                                Detail View
                                            </label>

                                        </div>


                                            @if (DetailsView)
                                            {
                                                    <button type="button"
                                                            class="btn btn-light text-primary fw-semibold me-2 shadow-sm"
                                                            @onclick="ToggleCharts">

                                                        <i class="bi @(ShowCharts ? "bi-x-circle" : "bi-bar-chart-line") me-1"></i>

                                                        @(ShowCharts ? "Close Graphs" : "Graphs")
                                                    </button>
                                            }



                                        <!-- EXPORT -->
                                        <button type="button"
                                        class="btn btn-success
                                            d-flex align-items-center
                                            text-nowrap flex-shrink-0"
                                        @onclick="OnPrintPendingTrack">

                                            <i class="bi bi-file-earmark-excel-fill me-1"></i>
                                            Export Excel

                                        </button>
                                }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
                

                        <div class="table-responsive">

                        @if (FilteredRatings.Any())
                        {
                                    <div class="table-responsive border rounded" style="max-height:600px; overflow-x:auto; overflow-y:auto;">

                                        <table class="table table-bordered table-sm mb-0 align-middle" style="min-width:1500px; white-space:nowrap;">

                                            <thead class="custom-blue text-center align-middle sticky-top">
                                        
                                                <tr>

                                                @if (SelectedType == "Production Component")
                                                {
                                                        @if (IsVisible("SlNo"))
                                                        {
                                                                <th>Sl No</th>
                                                        }
                                                        @if (IsVisible("IssueNo"))
                                                        {
                                                                <th>Issue No</th>
                                                        }
                                                        @if (IsVisible("IssueDate"))
                                                        {
                                                                <th>Issue Date</th>
                                                        }
