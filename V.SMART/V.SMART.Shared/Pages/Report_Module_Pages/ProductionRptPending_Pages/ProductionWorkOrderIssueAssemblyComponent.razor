    private bool TryGetIssueDate(
        object? value,
        out DateTime date)
    {
        date = default;

        if (value == null)
            return false;

        if (value is DateTime dt)
        {
            date = dt;
            return true;
        }

        if (value is DateTime?)
        {
            var nullableDate = (DateTime?)value;

            if (nullableDate.HasValue)
            {
                date = nullableDate.Value;
                return true;
            }
        }

        return DateTime.TryParse(
            value.ToString(),
            out date);
    }


