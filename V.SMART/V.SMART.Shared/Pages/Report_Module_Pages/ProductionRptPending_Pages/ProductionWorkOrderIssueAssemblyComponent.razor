        if (FilteredRatings == null || !FilteredRatings.Any())
            return new List<TransactionChartVM>();

        return FilteredRatings
            .GroupBy(x =>
                string.IsNullOrWhiteSpace(x.TransType)
                    ? "Unknown"
                    : x.TransType)
            .Select(g => new TransactionChartVM
            {
                TransType = g.Key,

                Qty = g.Sum(x =>
                    Convert.ToDecimal(x.Qty)),

                Count = g.Count()
            })
            .OrderByDescending(x => x.Qty)
            .ToList();
    }


