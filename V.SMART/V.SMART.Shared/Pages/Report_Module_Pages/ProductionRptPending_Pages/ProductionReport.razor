        }
    }


    private decimal TotalReworkQty
    {
        get
        {
            var data =
                FilteredProductionDetails;


            if (selectedReportType ==
                "PRODUCTIONISSUE")
            {
                return data
                    .Where(x =>
                        string.Equals(
                            x.TransType,
                            "In",
                            StringComparison.OrdinalIgnoreCase))
                    .Sum(x =>
                        x.ReworkQty);
            }


            return data.Sum(
                x => x.ReworkQty);
        }
    }


    private decimal TotalQty =>
        TotalAcceptedQty +
        TotalRejectedQty +
        TotalReworkQty;


    // =============================================================
    // PERCENTAGES
    // =============================================================

    private decimal AcceptedPercentage =>
        TotalQty == 0
            ? 0
            : TotalAcceptedQty /
              TotalQty *
              100;


    private decimal RejectedPercentage =>
        TotalQty == 0
            ? 0
            : TotalRejectedQty /
              TotalQty *
              100;


    private decimal ReworkPercentage =>
        TotalQty == 0
            ? 0
            : TotalReworkQty /
              TotalQty *
              100;


    // =============================================================
    // CHART TITLE
    // =============================================================

    private string ChartTitle
    {
        get
        {
            return selectedReportType switch
            {
                "DAILY" =>
                    "Daily Production - Accepted / Rejected / Rework",

                "SUBCONTRACT" =>
                    "Sub Contract - Accepted / Rejected / Rework",

                "PRODUCTIONISSUE" =>
                    "Production Component - Accepted / Rejected / Rework",

                _ =>
                    "Production Summary"
            };
        }
    }


    // =============================================================
    // PIE CHART STYLE
    // =============================================================

    private string PieChartStyle
    {
        get
        {
            decimal accepted =
                AcceptedPercentage;

            decimal rejected =
                RejectedPercentage;

            decimal rejectedEnd =
                accepted +
                rejected;


            string a =
                accepted.ToString(
                    CultureInfo.InvariantCulture);


            string r =
                rejectedEnd.ToString(
                    CultureInfo.InvariantCulture);


            return
                $"background: conic-gradient(" +
                $"#198754 0% {a}%," +
                $"#dc3545 {a}% {r}%," +
                $"#ffc107 {r}% 100%);";
        }
    }



    // =============================================================
    // AFTER RENDER
    // =============================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender)
        {
            /*
            * IMPORTANT:
             * JS localStorage is loaded after the component
             * becomes interactive.
             */

    await LoadColumnSettings();

            await InvokeAsync(
                StateHasChanged);
        }


        if (!chartRenderPending)
        {
            return;
        }


        if (selectedChartType == "PIE")
        {
            chartRenderPending =
                false;

            return;
        }


        if (!FilteredProductionDetails.Any())
        {
            chartRenderPending =
                false;

            return;
        }


        chartRenderPending =
            false;


        await DrawSelectedChart();
    }


