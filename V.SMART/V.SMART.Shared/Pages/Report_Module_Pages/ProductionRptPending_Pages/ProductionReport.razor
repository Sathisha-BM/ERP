    {
        return CurrentColumns.TryGetValue(
            column,
            out bool visible)
            && visible;
    }


    private async Task ToggleColumn(
        string column,
        ChangeEventArgs e)
    {
        if (!CurrentColumns.ContainsKey(column))
        {
            return;
        }


        bool value = false;


        if (e.Value is bool boolValue)
        {
            value = boolValue;
        }
        else
        {
            bool.TryParse(
                e.Value?.ToString(),
                out value);
        }


        CurrentColumns[column] =
            value;


        // SAVE IMMEDIATELY
        await SaveColumnSettings();


        await InvokeAsync(
            StateHasChanged);
    }


