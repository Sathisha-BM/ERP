@page "/ProductionReport"
@rendermode InteractiveServer

@using System
@using System.Collections.Generic
@using System.Linq
@using System.Globalization
@using System.IO
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using ClosedXML.Excel


@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.ITrackReportService
@using V.SMART.Shared.ViewModels.ReportViewModel.ProdAssStatusVM
@inherits BaseUserRightsComponent
@inject IProductionReportService ProductionReportService
@inject NavigationManager _navigation
@inject IJSRuntime JS


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-4 mt-4">

        <div class="card shadow-sm border-1">

            <PageHeader TitleText="@PageTitle"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@PoBreadcrumbs" />

            <div class="card-body">

                <!-- ===================================================== -->
                <!-- FILTER SECTION -->
                <!-- ===================================================== -->

                <div class="row g-3 mb-4 align-items-end">

                    <!-- FROM DATE -->
                    <div class="col-12 col-md-2">

                        <label class="fw-bold mb-2">
                            From Date
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="FromDate"
                                   @bind-Value:after="OnFromDateChanged" />

                    </div>


                    <!-- TO DATE -->
                    <div class="col-12 col-md-2">

                        <label class="fw-bold mb-2">
                            To Date
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="ToDate"
                                   @bind-Value:after="OnToDateChanged" />

                    </div>


                    <!-- SEARCH -->
                    <div class="col-12 col-md-3">

                        <label class="fw-bold mb-2">
                            Search
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Search..."
                               @bind="searchText"
                               @bind:event="oninput"
                               @bind:after="OnSearchChanged" />

                    </div>


                    <!-- REPORT TYPE -->
                    <div class="col-12 col-md-4">

                        <label class="fw-bold mb-2 d-block">
                            Report Type
                        </label>

                        <div class="report-type-options">

                            <label class="radio-option">

                                <input type="radio"
                                       name="reportType"
                                       value="DAILY"
                                       checked="@(selectedReportType == "DAILY")"
                                       @onchange="ReportTypeChanged" />

                                <span>
                                    Daily Production
                                </span>

                            </label>


                            <label class="radio-option">

                                <input type="radio"
                                       name="reportType"
                                       value="SUBCONTRACT"
                                       checked="@(selectedReportType == "SUBCONTRACT")"
                                       @onchange="ReportTypeChanged" />

                                <span>
                                    Sub Contract
                                </span>

                            </label>


                            <label class="radio-option">

                                <input type="radio"
                                       name="reportType"
                                       value="PRODUCTIONISSUE"
                                       checked="@(selectedReportType == "PRODUCTIONISSUE")"
                                       @onchange="ReportTypeChanged" />

                                <span>
                                    Production Component
                                </span>

                            </label>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- COLUMN MENU -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-1 d-flex justify-content-end">

                        <div class="dropdown">

                            <button class="btn btn-outline-primary dropdown-toggle column-button"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside">

                                <i class="bi bi-layout-three-columns me-1"></i>

                                Columns

                            </button>


                            <div class="dropdown-menu dropdown-menu-end p-3 column-menu">

                                <div class="d-flex justify-content-between mb-2">

                                    <strong>
                                        Select Columns
                                    </strong>

                                    <button type="button"
                                            class="btn btn-sm btn-link p-0"
                                            @onclick="SelectAllColumns">

                                        Select All

                                    </button>

                                </div>


                                <hr />


                                @foreach (var column in CurrentColumns)
                                {
                                    <div class="form-check mb-2">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="@($"col_{column.Key}")"
                                               checked="@column.Value"
                                               @onchange="e => ToggleColumn(column.Key, e)" />

                                        <label class="form-check-label"
                                               for="@($"col_{column.Key}")">

                                            @column.Key

                                        </label>

                                    </div>
                                }


                                <hr />


                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary w-100"
                                        @onclick="ResetColumns">

                                    Reset Columns

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ===================================================== -->
                <!-- LOADING -->
                <!-- ===================================================== -->
                @if (isProcessing)
                {
                    <div class="text-center p-4">

                        <div class="spinner-border text-primary"
                             role="status">

                            <span class="visually-hidden">
                                Loading...
                            </span>

                        </div>

                        <div class="mt-2">
                            Loading data...
                        </div>

                    </div>
                }


                <!-- ===================================================== -->
                <!-- DAILY PRODUCTION -->
                <!-- ===================================================== -->
                @if (!isProcessing && selectedReportType == "DAILY")
                {
                    @if (FilteredProductionDetails.Any())
                    {
                        <div class="table-responsive border rounded production-table">

                            <table class="table table-bordered table-sm mb-0 align-middle"
                                   style="min-width:1900px; white-space:nowrap;">

                                <thead class="custom-blue text-center align-middle sticky-top">

                                    <tr>

                                        @foreach (var column in DailyColumns)
                                        {
                                            if (IsColumnVisible(column.Key))
                                            {
                                                <th>
                                                    @column.Key
                                                </th>
                                            }
                                        }

                                    </tr>

                                </thead>


                                <tbody>

                                    @{
                                        int displaySlNo = 1;
                                    }

                                    @foreach (var item in FilteredProductionDetails)
                                    {
                                        <tr>

                                            @if (IsColumnVisible("Sl No"))
                                            {
                                                <td>@displaySlNo</td>
                                            }

                                            @if (IsColumnVisible("Production Date"))
                                            {
                                                <td>
                                                    @item.ProductionDate.ToString("dd/MM/yyyy")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Production No"))
                                            {
                                                <td>@item.ProductionNo</td>
                                            }

                                            @if (IsColumnVisible("Customer"))
                                            {
                                                <td>@item.Customer</td>
                                            }

                                            @if (IsColumnVisible("Route Card"))
                                            {
                                                <td>@item.RouteCardNo</td>
                                            }

                                            @if (IsColumnVisible("PO No"))
                                            {
                                                <td>@item.PONo</td>
                                            }

                                            @if (IsColumnVisible("PO Line No"))
                                            {
                                                <td>@item.POLineNo</td>
                                            }

                                            @if (IsColumnVisible("PO Date"))
                                            {
                                                <td>@FormatDate(item.PODate)</td>
                                            }

                                            @if (IsColumnVisible("Mfg / Labour"))
                                            {
                                                <td>

                                                    @if (item.MfgOrLab == "Manufacturing")
                                                    {
                                                        <span class="badge bg-success">
                                                            Manufacturing
                                                        </span>
                                                    }
                                                    else if (item.MfgOrLab == "Labour")
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            Labour
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @item.MfgOrLab
                                                    }

                                                </td>
                                            }

                                            @if (IsColumnVisible("Entry Type"))
                                            {
                                                <td>@item.EntryType</td>
                                            }

                                            @if (IsColumnVisible("Item Code"))
                                            {
                                                <td>@item.ItemCode</td>
                                            }

                                            @if (IsColumnVisible("Process"))
                                            {
                                                <td>@item.Process</td>
                                            }

                                            @if (IsColumnVisible("Shift"))
                                            {
                                                <td>@item.Shift</td>
                                            }

                                            @if (IsColumnVisible("Machine"))
                                            {
                                                <td>@item.Machine</td>
                                            }

                                            @if (IsColumnVisible("From Time"))
                                            {
                                                <td>@FormatTime(item.FromTime)</td>
                                            }

                                            @if (IsColumnVisible("To Time"))
                                            {
                                                <td>@FormatTime(item.ToTime)</td>
                                            }

                                            @if (IsColumnVisible("Worked Hrs"))
                                            {
                                                <td class="text-end">
                                                    @item.WorkedHours.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Operator"))
                                            {
                                                <td>@item.Operator</td>
                                            }

                                            @if (IsColumnVisible("Target Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.TargetQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Expected Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.ExpectedTargetQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Issued Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.IssuedQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Produceable Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.ProduceableQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Accepted Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.AcceptedQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Rejected Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.RejectedQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Rework Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.ReworkQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Bal Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.BalQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Remarks"))
                                            {
                                                <td>@item.LogDetail</td>
                                            }

                                            @if (IsColumnVisible("Idle Time"))
                                            {
                                                <td class="text-end">
                                                    @item.MachineIdleTime.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Operator Efficiency"))
                                            {
                                                <td class="text-end">
                                                    @item.OperatorEfficiency.ToString("0.00") %
                                                </td>
                                            }

                                        </tr>

                                        displaySlNo++;
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-4">
                            No Daily Production records found.
                        </div>
                    }
                }


                <!-- ===================================================== -->
                <!-- SUB CONTRACT -->
                <!-- ===================================================== -->
                @if (!isProcessing && selectedReportType == "SUBCONTRACT")
                {
                    @if (FilteredProductionDetails.Any())
                    {
                        <div class="table-responsive border rounded production-table">

                            <table class="table table-bordered table-sm mb-0 align-middle"
                                   style="min-width:1800px; white-space:nowrap;">

                                <thead class="custom-blue text-center sticky-top">

                                    <tr>

                                        @foreach (var column in SubContractColumns)
                                        {
                                            if (IsColumnVisible(column.Key))
                                            {
                                                <th>
                                                    @column.Key
                                                </th>
                                            }
                                        }

                                    </tr>

                                </thead>


                                <tbody>

                                    @{
                                        int displaySlNo = 1;
                                    }

                                    @foreach (var item in FilteredProductionDetails)
                                    {
                                        <tr>

                                            @if (IsColumnVisible("Sl No"))
                                            {
                                                <td>@displaySlNo</td>
                                            }

                                            @if (IsColumnVisible("DC Date"))
                                            {
                                                <td>
                                                    @item.ProductionDate.ToString("dd/MM/yyyy")
                                                </td>
                                            }

                                            @if (IsColumnVisible("DC No"))
                                            {
                                                <td>@item.ProductionNo</td>
                                            }

                                            @if (IsColumnVisible("Vendor"))
                                            {
                                                <td>@item.Customer</td>
                                            }

                                            @if (IsColumnVisible("PO No"))
                                            {
                                                <td>@item.PONo</td>
                                            }

                                            @if (IsColumnVisible("PO Date"))
                                            {
                                                <td>@FormatDate(item.PODate)</td>
                                            }

                                            @if (IsColumnVisible("Trans Type"))
                                            {
                                                <td>

                                                    @if (item.TransType == "In")
                                                    {
                                                        <span class="badge bg-success">
                                                            In
                                                        </span>
                                                    }
                                                    else if (item.TransType == "Out")
                                                    {
                                                        <span class="badge bg-danger">
                                                            Out
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @item.TransType
                                                    }

                                                </td>
                                            }

                                            @if (IsColumnVisible("Route Card No"))
                                            {
                                                <td>@item.RouteCardNo</td>
                                            }

                                            @if (IsColumnVisible("Item Code"))
                                            {
                                                <td>@item.ItemCode</td>
                                            }

                                            @if (IsColumnVisible("Process"))
                                            {
                                                <td>@item.Process</td>
                                            }

                                            @if (IsColumnVisible("Machine"))
                                            {
                                                <td>@item.Machine</td>
                                            }

                                            @if (IsColumnVisible("Issued Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.IssuedQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("GRN No"))
                                            {
                                                <td>@item.GRNNo</td>
                                            }

                                            @if (IsColumnVisible("Produceable Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.ProduceableQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("SCN No"))
                                            {
                                                <td>@item.SCNNo</td>
                                            }

                                            @if (IsColumnVisible("Accepted Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.AcceptedQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Rejected Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.RejectedQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Rework Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.ReworkQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Bal Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.BalQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Remarks"))
                                            {
                                                <td>@item.LogDetail</td>
                                            }

                                            @if (IsColumnVisible("Status"))
                                            {
                                                <td>

                                                    @if (item.Status == "Cancelled")
                                                    {
                                                        <span class="badge bg-danger">
                                                            Cancelled
                                                        </span>
                                                    }
                                                    else if (item.Status == "Short Closed")
                                                    {
                                                        <span class="badge bg-secondary">
                                                            Short Closed
                                                        </span>
                                                    }
                                                    else if (item.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            Pending
                                                        </span>
                                                    }
                                                    else if (item.Status == "Complete")
                                                    {
                                                        <span class="badge bg-success">
                                                            Complete
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @item.Status
                                                    }

                                                </td>
                                            }

                                        </tr>

                                        displaySlNo++;
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-4">
                            No Sub Contract records found.
                        </div>
                    }
                }


                <!-- ===================================================== -->
                <!-- PRODUCTION COMPONENT -->
                <!-- ===================================================== -->
                @if (!isProcessing &&  selectedReportType == "PRODUCTIONISSUE")
                {
                    @if (FilteredProductionDetails.Any())
                    {
                        <div class="table-responsive border rounded production-table">

                            <table class="table table-bordered table-sm mb-0 align-middle"
                                   style="min-width:1800px; white-space:nowrap;">

                                <thead class="custom-blue text-center sticky-top">

                                    <tr>

                                        @foreach (var column in ProductionIssueColumns)
                                        {
                                            if (IsColumnVisible(column.Key))
                                            {
                                                <th>
                                                    @column.Key
                                                </th>
                                            }
                                        }

                                    </tr>

                                </thead>


                                <tbody>

                                    @{
                                        int displaySlNo = 1;
                                    }

                                    @foreach (var item in FilteredProductionDetails)
                                    {
                                        <tr>

                                            @if (IsColumnVisible("Sl No"))
                                            {
                                                <td>@displaySlNo</td>
                                            }

                                            @if (IsColumnVisible("Issue Date"))
                                            {
                                                <td>
                                                    @item.ProductionDate.ToString("dd/MM/yyyy")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Issue No"))
                                            {
                                                <td>@item.ProductionNo</td>
                                            }

                                            @if (IsColumnVisible("Customer"))
                                            {
                                                <td>@item.Customer</td>
                                            }

                                            @if (IsColumnVisible("Route Card"))
                                            {
                                                <td>@item.RouteCardNo</td>
                                            }

                                            @if (IsColumnVisible("PO No"))
                                            {
                                                <td>@item.PONo</td>
                                            }

                                            @if (IsColumnVisible("PO Line No"))
                                            {
                                                <td>@item.POLineNo</td>
                                            }

                                            @if (IsColumnVisible("PO Date"))
                                            {
                                                <td>@FormatDate(item.PODate)</td>
                                            }

                                            @if (IsColumnVisible("Item Code"))
                                            {
                                                <td>@item.ItemCode</td>
                                            }

                                            @if (IsColumnVisible("Trans Type"))
                                            {
                                                <td>

                                                    @if (item.TransType == "In")
                                                    {
                                                        <span class="badge bg-success">
                                                            In
                                                        </span>
                                                    }
                                                    else if (item.TransType == "Out")
                                                    {
                                                        <span class="badge bg-danger">
                                                            Out
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @item.TransType
                                                    }

                                                </td>
                                            }

                                            @if (IsColumnVisible("Process"))
                                            {
                                                <td>@item.Process</td>
                                            }

                                            @if (IsColumnVisible("Machine"))
                                            {
                                                <td>@item.Machine</td>
                                            }

                                            @if (IsColumnVisible("Issued Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.IssuedQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("GRN No"))
                                            {
                                                <td>@item.GRNNo</td>
                                            }

                                            @if (IsColumnVisible("Produceable Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.ProduceableQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("SCN No"))
                                            {
                                                <td>@item.SCNNo</td>
                                            }

                                            @if (IsColumnVisible("Accepted Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.AcceptedQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Rejected Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.RejectedQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Rework Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.ReworkQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Bal Qty"))
                                            {
                                                <td class="text-end">
                                                    @item.BalQty.ToString("0.00")
                                                </td>
                                            }

                                            @if (IsColumnVisible("Remarks"))
                                            {
                                                <td>@item.LogDetail</td>
                                            }

                                            @if (IsColumnVisible("Status"))
                                            {
                                                <td>

                                                    @if (item.Status == "Cancelled")
                                                    {
                                                        <span class="badge bg-danger">
                                                            Cancelled
                                                        </span>
                                                    }
                                                    else if (item.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            Pending
                                                        </span>
                                                    }
                                                    else if (item.Status == "Complete")
                                                    {
                                                        <span class="badge bg-success">
                                                            Complete
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @item.Status
                                                    }

                                                </td>
                                            }

                                        </tr>

                                        displaySlNo++;
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-4">
                            No Production Component records found.
                        </div>
                    }
                }


                <!-- ===================================================== -->
                <!-- CHART TYPE + EXPORT -->
                <!-- ===================================================== -->
                @if (!isProcessing && FilteredProductionDetails.Any())
                {
                    <div class="chart-export-row mt-2 mb-2">

                        <div class="chart-type-section">

                            <label class="fw-bold mb-2 d-block">
                                Chart Type
                            </label>

                            <select class="form-select chart-type-select"
                                    value="@selectedChartType"
                                    @onchange="ChartTypeChanged">

                                <option value="PIE">
                                    Pie Chart
                                </option>

                                <option value="BAR">
                                    Bar Chart
                                </option>

                                <option value="LINE">
                                    Line Chart
                                </option>

                                <option value="FINANCIAL">
                                    Financial Chart
                                </option>

                            </select>

                        </div>


                        <div class="export-section">

                            <button type="button"
                                    class="btn btn-primary export-button"
                                    @onclick="OnPrintPendingTrack"
                                    disabled="@isProcessing">

                                <i class="bi bi-file-earmark-excel-fill me-1"></i>
                                Export Excel

                            </button>

                        </div>

                    </div>
                }


                <!-- ===================================================== -->
                <!-- SUMMARY -->
                <!-- ===================================================== -->
                @if (!isProcessing && FilteredProductionDetails.Any())
                {
                    <div class="row mt-4 g-3">

                        <div class="col-12 col-md-4">

                            <div class="summary-card accepted-card">

                                <div class="summary-icon">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>

                                <div>

                                    <div class="summary-title">
                                        Total Accepted Qty
                                    </div>

                                    <div class="summary-value">
                                        @TotalAcceptedQty.ToString("0.00")
                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="col-12 col-md-4">

                            <div class="summary-card rejected-card">

                                <div class="summary-icon">
                                    <i class="bi bi-x-circle-fill"></i>
                                </div>

                                <div>

                                    <div class="summary-title">
                                        Total Rejected Qty
                                    </div>

                                    <div class="summary-value">
                                        @TotalRejectedQty.ToString("0.00")
                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="col-12 col-md-4">

                            <div class="summary-card rework-card">

                                <div class="summary-icon">
                                    <i class="bi bi-arrow-repeat"></i>
                                </div>

                                <div>

                                    <div class="summary-title">
                                        Total Rework Qty
                                    </div>

                                    <div class="summary-value">
                                        @TotalReworkQty.ToString("0.00")
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- CHART -->
                    <!-- ================================================= -->

