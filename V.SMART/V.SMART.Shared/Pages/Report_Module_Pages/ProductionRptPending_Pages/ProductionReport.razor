    // =============================================================
    // DRAW CHART
    // =============================================================

    private async Task DrawSelectedChart()
    {
        try
        {
            if (selectedChartType ==
                "PIE")
            {
                return;
            }


            var data =
                FilteredProductionDetails
                    .ToList();


            if (!data.Any())
            {
                return;
            }


            await Task.Yield();


            bool created =
                await JS.InvokeAsync<bool>(
                    "createProductionChart",

                    selectedChartType,

                    (double)TotalAcceptedQty,

                    (double)TotalRejectedQty,

                    (double)TotalReworkQty
                );


            if (!created)
            {
                await JS.ToastrError(
                    "Unable to create the selected chart.");
            }
        }
        catch (Exception ex)
        {
            await JS.ToastrError(
                $"Unable to display chart: {ex.Message}");
        }
    }


    // =============================================================
    // LOAD DATA
    // =============================================================

    private async Task LoadData()
    {
        try
        {
            isProcessing = true;

            chartRenderPending =false;

            ProductionDetails.Clear();

            if (!FromDate.HasValue ||  !ToDate.HasValue)
            {
                return;
            }


            if (FromDate.Value.Date > ToDate.Value.Date)
            {
                await JS.ToastrWarning("From Date cannot be greater than To Date.");

                return;
            }


            var result =await ProductionReportService.GetProductionReport(FromDate,ToDate,selectedReportType);

            ProductionDetails = result ??new List<ProductionReportVM>();

           @*  if (selectedChartType != "PIE" && ProductionDetails.Any())
            {
                chartRenderPending = true;
            } *@


            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ProductionDetails = new List<ProductionReportVM>();

            chartRenderPending =false;

            await JS.ToastrError($"Error loading report: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    // =============================================================
    // FORMAT DATE
    // =============================================================

    private string FormatDate(object? value)
    {
        if (value == null)
        {
            return "";
        }


        if (value is DateTime date)
        {
            return date.ToString(
                "dd/MM/yyyy");
        }


        return value.ToString() ?? "";
    }


    // =============================================================
    // FORMAT TIME
    // =============================================================

    private string FormatTime(TimeSpan value)
    {
        return value.ToString(
            @"hh\:mm\:ss");
    }


    // =============================================================
    // EXCEL EXPORT
    // =============================================================

    private async Task OnPrintPendingTrack()
    {
        try
        {
            isProcessing = true;


            await InvokeAsync(
                StateHasChanged);


            var data =
                FilteredProductionDetails
                    .ToList();


            if (!data.Any())
            {
                await JS.ToastrWarning(
                    "No records available to export.");

                return;
            }


            string fileName;


            if (selectedReportType == "DAILY")
            {
                fileName =
                    "DailyProductionLog.xlsx";

                await ExportToExcel(
                    data,
                    DailyColumns,
                    fileName,
                    "Daily Production Log");
            }
            else if (selectedReportType == "SUBCONTRACT")
            {
                fileName =
                    "SubContract.xlsx";

                await ExportToExcel(
                    data,
                    SubContractColumns,
                    fileName,
                    "Sub Contract");
            }
            else
            {
                fileName =
                    "ProductionComponent.xlsx";

                await ExportToExcel(
                    data,
                    ProductionIssueColumns,
                    fileName,
                    "Production Component");
            }
        }
        catch (Exception ex)
        {
            await JS.ToastrError(
                $"Excel export error: {ex.Message}");
        }
        finally
        {
            isProcessing =
                false;


            await InvokeAsync(
                StateHasChanged);
        }
    }


    // =============================================================
    // COMMON EXCEL EXPORT
    // =============================================================

    private async Task ExportToExcel(
        List<ProductionReportVM> data,
        Dictionary<string, bool> columns,
        string fileName,
        string sheetName)
    {
        try
        {
            var selectedColumns =
                columns
                    .Where(x => x.Value)
                    .Select(x => x.Key)
                    .ToList();


            if (!selectedColumns.Any())
            {
                await JS.ToastrWarning(
                    "Please select at least one column.");

                return;
            }


            using var workbook =
                new XLWorkbook();


            var worksheet =
                workbook.Worksheets.Add(
                    sheetName);


            for (int i = 0;
                 i < selectedColumns.Count;
                 i++)
            {
                var cell =
                    worksheet.Cell(
                        1,
                        i + 1);


                cell.Value =
                    selectedColumns[i];


                cell.Style.Font.Bold =
                    true;


                cell.Style.Alignment.Horizontal =
                    XLAlignmentHorizontalValues.Center;


                cell.Style.Alignment.Vertical =
                    XLAlignmentVerticalValues.Center;


                cell.Style.Fill.BackgroundColor =
                    XLColor.FromHtml(
                        "#2382b8");


                cell.Style.Font.FontColor =
                    XLColor.White;
            }


            int rowNumber = 2;

            int slNo = 1;


            foreach (var item in data)
            {
                for (int col = 0;
                     col < selectedColumns.Count;
                     col++)
                {
                    string column =
                        selectedColumns[col];


                    var cell =
                        worksheet.Cell(
                            rowNumber,
                            col + 1);


                    SetExcelCellValue(
                        cell,
                        column,
                        item,
                        slNo);
                }


                rowNumber++;

                slNo++;
            }


            worksheet.Row(1).Height =
                25;


            worksheet.SheetView.FreezeRows(
                1);


            if (rowNumber > 1 &&
                selectedColumns.Count > 0)
            {
                var usedRange =
                    worksheet.Range(
                        1,
                        1,
                        rowNumber - 1,
                        selectedColumns.Count);


                usedRange.Style.Border.OutsideBorder =
                    XLBorderStyleValues.Thin;


                usedRange.Style.Border.InsideBorder =
                    XLBorderStyleValues.Thin;
            }


            worksheet.Columns()
                .AdjustToContents();


            foreach (var column in
                     worksheet.Columns())
            {
                if (column.Width > 40)
                {
                    column.Width =
                        40;
                }
            }


            using var stream =
                new MemoryStream();


            workbook.SaveAs(stream);


            byte[] fileBytes =
                stream.ToArray();


            if (fileBytes.Length == 0)
            {
                await JS.ToastrError("Excel file was generated empty.");

                return;
            }


            string base64 = Convert.ToBase64String(fileBytes);


            await JS.InvokeVoidAsync("downloadExcelFile", base64, fileName);
        }
        catch (Exception ex)
        {
            await JS.ToastrError(
                $"Excel generation failed: {ex.Message}");
        }
    }


    // =============================================================
    // SET EXCEL CELL VALUE
    // =============================================================

    private void SetExcelCellValue( IXLCell cell, string column,  ProductionReportVM x, int slNo)
    {
        switch (column)
        {
            case "Sl No":

                cell.Value =
                    slNo;

                break;


            case "Production Date":

            case "DC Date":

            case "Issue Date":

                cell.Value =
                    x.ProductionDate;

                cell.Style.DateFormat.Format =
                    "dd/MM/yyyy";

                break;


            case "Production No":

            case "DC No":

            case "Issue No":

                cell.Value =
                    x.ProductionNo ?? "";

                break;


            case "Customer":

            case "Vendor":

                cell.Value =
                    x.Customer ?? "";

                break;


            case "Route Card":

            case "Route Card No":

                cell.Value =
                    x.RouteCardNo ?? "";

                break;


            case "PO No":

                cell.Value =
                    x.PONo ?? "";

                break;


            case "PO Line No":

                cell.Value =
                    x.POLineNo;

                break;


            case "PO Date":

                if (DateTime.TryParse(
                    x.PODate,
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.None,
                    out DateTime poDate))
                {
                    cell.Value =
                        poDate;

                    cell.Style.DateFormat.Format =
                        "dd/MM/yyyy";
                }
                else
                {
                    cell.Value =
                        x.PODate ?? "";
                }

                break;


            case "Mfg / Labour":

                cell.Value =
                    x.MfgOrLab ?? "";

                break;


            case "Entry Type":

                cell.Value =
                    x.EntryType ?? "";

                break;


            case "Item Code":

                cell.Value =
                    x.ItemCode ?? "";

                break;


            case "Process":

                cell.Value =
                    x.Process ?? "";

                break;


            case "Shift":

                cell.Value =
                    x.Shift ?? "";

                break;


            case "Machine":

                cell.Value =
                    x.Machine ?? "";

                break;


            case "From Time":

                cell.Value =
                    x.ProductionDate.Date
                        .Add(x.FromTime);

                cell.Style.DateFormat.Format =
                    "dd/MM/yyyy hh:mm AM/PM";

                break;


            case "To Time":

                cell.Value =
                    x.ProductionDate.Date
                        .Add(x.ToTime);

                cell.Style.DateFormat.Format =
                    "dd/MM/yyyy hh:mm AM/PM";

                break;


            case "Worked Hrs":

                cell.Value =
                    (double)x.WorkedHours;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Operator":

                cell.Value =
                    x.Operator ?? "";

                break;


            case "Target Qty":

                cell.Value =
                    (double)x.TargetQty;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Expected Qty":

                cell.Value =
                    (double)x.ExpectedTargetQty;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Issued Qty":

                cell.Value =
                    (double)x.IssuedQty;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Produceable Qty":

                cell.Value =
                    (double)x.ProduceableQty;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Accepted Qty":

                cell.Value =
                    (double)x.AcceptedQty;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Rejected Qty":

                cell.Value =
                    (double)x.RejectedQty;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Rework Qty":

                cell.Value =
                    (double)x.ReworkQty;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Bal Qty":

                cell.Value =
                    (double)x.BalQty;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Remarks":

                cell.Value =
                    x.LogDetail ?? "";

                break;


            case "Idle Time":

                cell.Value =
                    (double)x.MachineIdleTime;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Operator Efficiency":

                cell.Value =
                    (double)x.OperatorEfficiency;

                cell.Style.NumberFormat.Format =
                    "0.00";

                break;


            case "Trans Type":

                cell.Value =
                    x.TransType ?? "";

                break;


            case "GRN No":

                cell.Value =
                    x.GRNNo ?? "";

                break;


            case "SCN No":

                cell.Value =
                    x.SCNNo ?? "";

                break;


            case "Status":

                cell.Value =
                    x.Status ?? "";

                break;


            default:

                cell.Value =
                    "";

                break;
        }
    }


