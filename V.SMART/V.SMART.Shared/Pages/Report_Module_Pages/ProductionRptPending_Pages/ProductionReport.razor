    // =============================================================
    // COLUMN PERSISTENCE
    // =============================================================

    private async Task LoadColumnSettings()
    {
        try
        {
            string? json =
                await JS.InvokeAsync<string?>(
                    "loadProductionColumnSettings",
                    ColumnStorageKey);


            if (string.IsNullOrWhiteSpace(json))
            {
                columnSettingsLoaded = true;
                return;
            }


            var savedSettings =
                JsonSerializer.Deserialize<
                    Dictionary<string,
                    Dictionary<string, bool>>
                >(json);


            if (savedSettings == null)
            {
                columnSettingsLoaded = true;
                return;
            }


            ApplySavedColumns(
                "DAILY",
                DailyColumns,
                savedSettings);


            ApplySavedColumns(
                "SUBCONTRACT",
                SubContractColumns,
                savedSettings);


            ApplySavedColumns(
                "PRODUCTIONISSUE",
                ProductionIssueColumns,
                savedSettings);


            columnSettingsLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Column settings load error: {ex.Message}");

            columnSettingsLoaded = true;
        }
    }


    private void ApplySavedColumns(
        string reportType,
        Dictionary<string, bool> columns,
        Dictionary<string, Dictionary<string, bool>> savedSettings)
    {
        if (!savedSettings.TryGetValue(
                reportType,
                out var savedColumns))
        {
            return;
        }


        foreach (var column in columns.Keys.ToList())
        {
            if (savedColumns.TryGetValue(
                    column,
                    out bool visible))
            {
                columns[column] = visible;
            }
        }
    }


    private async Task SaveColumnSettings()
    {
        try
        {
            var allSettings =
                new Dictionary<string,
                    Dictionary<string, bool>>
                {
                    ["DAILY"] =
                        new Dictionary<string, bool>(
                            DailyColumns),

                    ["SUBCONTRACT"] =
                        new Dictionary<string, bool>(
                            SubContractColumns),

                    ["PRODUCTIONISSUE"] =
                        new Dictionary<string, bool>(
                            ProductionIssueColumns)
                };


            string json =
                JsonSerializer.Serialize(
                    allSettings);


            await JS.InvokeVoidAsync(
                "saveProductionColumnSettings",
                ColumnStorageKey,
                json);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Column settings save error: {ex.Message}");
        }
    }


