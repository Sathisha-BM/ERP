    // =============================================================
    // CHART TYPE
    // =============================================================

    private async Task ChartTypeChanged(ChangeEventArgs e)
    {
        try
        {
            selectedChartType =
                e.Value?.ToString()
                ?? "PIE";


            await JS.InvokeVoidAsync(
                "destroyProductionChart");


            if (selectedChartType ==
                "PIE")
