<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

<script>

    /* =============================================================
       PRODUCTION CHART
       ============================================================= */

    window.productionChart = null;


    window.destroyProductionChart = function () {

        try {

            if (window.productionChart !== null) {

                window.productionChart.destroy();

                window.productionChart = null;
            }

        }
        catch (error) {

            console.error(
                "Error destroying production chart:",
                error
            );

            window.productionChart = null;
        }

    };


    window.createProductionChart = function (
        chartType,
        accepted,
        rejected,
        rework
    ) {

        try {

            if (typeof Chart === "undefined") {

                console.error(
                    "Chart.js is not loaded."
                );

                return false;
            }


            const canvas =
                document.getElementById(
                    "productionChartCanvas"
                );


            if (!canvas) {

                console.error(
                    "productionChartCanvas not found."
                );

                return false;
            }


            if (window.productionChart !== null) {

                try {

                    window.productionChart.destroy();

                }
                catch (error) {

                    console.warn(
                        "Old chart destroy error:",
                        error
                    );

                }

                window.productionChart = null;
            }


            accepted = Number(accepted) || 0;
            rejected = Number(rejected) || 0;
            rework = Number(rework) || 0;


            let type = "bar";
            let indexAxis = "x";
            let title = "Production Quantity";


            switch (chartType) {

                case "BAR":

                    type = "bar";
                    indexAxis = "x";
                    title = "Production Quantity";

                    break;


                case "LINE":

                    type = "line";
                    indexAxis = "x";
                    title = "Production Trend";

                    break;


                case "FINANCIAL":

                    type = "bar";
                    indexAxis = "y";
                    title = "Production Financial Chart";

                    break;


                default:

                    return false;
            }


            const dataset =
            {
                label: title,

                data:
                [
                    accepted,
                    rejected,
                    rework
                ],

                backgroundColor:
                [
                    "rgba(25, 135, 84, 0.75)",
                    "rgba(220, 53, 69, 0.75)",
                    "rgba(255, 193, 7, 0.75)"
                ],

                borderColor:
                [
                    "#198754",
                    "#dc3545",
                    "#ffc107"
                ],

                borderWidth: 2,

                borderRadius:
                    type === "bar"
                        ? 6
                        : 0,

                tension:
                    type === "line"
                        ? 0.35
                        : 0,

                pointRadius:
                    type === "line"
                        ? 6
                        : 0,

                pointHoverRadius:
                    type === "line"
                        ? 8
                        : 0,

                fill: false
            };


            const config =
            {
                type: type,

                data:
                {
                    labels:
                    [
                        "Accepted",
                        "Rejected",
                        "Rework"
                    ],

                    datasets:
                    [
                        dataset
                    ]
                },

                options:
                {
                    responsive: true,

                    maintainAspectRatio: false,

                    animation:
                    {
                        duration: 600
                    },

                    indexAxis: indexAxis,

                    interaction:
                    {
                        intersect: false,
                        mode: "index"
                    },

                    plugins:
                    {
                        legend:
                        {
                            display: true,
                            position: "top"
                        },

                        tooltip:
                        {
                            enabled: true,

                            callbacks:
                            {
                                label:
                                    function (context) {

                                        const value =
                                            Number(
                                                context.raw
                                            ) || 0;

                                        return (
                                            context.dataset.label +
                                            ": " +
                                            value.toFixed(2)
                                        );
                                    }
                            }
                        }
                    },

                    scales:
                    {
                        x:
                        {
                            beginAtZero: true,

                            ticks:
                            {
                                precision: 0
                            }
                        },

                        y:
                        {
                            beginAtZero: true,

                            ticks:
                            {
                                precision: 0
                            }
                        }
                    }
                }
            };


            const context =
                canvas.getContext("2d");


            if (!context) {

                return false;
            }


            window.productionChart =
                new Chart(
                    context,
                    config
                );


            return true;

        }
        catch (error) {

            console.error(
                "Production chart creation failed:",
                error
            );

            window.productionChart = null;

            return false;
        }

    };


    /* =============================================================
       EXCEL DOWNLOAD
       ============================================================= */

    window.downloadExcelFile = function (
        base64,
        fileName
    ) {

        try {

            const link =
                document.createElement("a");


            link.href =
                "data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,"
                + base64;


            link.download =
                fileName;


            document.body.appendChild(link);

            link.click();

            document.body.removeChild(link);

        }
        catch (error) {

            console.error(
                "Excel download error:",
                error
            );

        }

    };


    /* =============================================================
       COLUMN SETTINGS - LOCAL STORAGE
       ============================================================= */

    window.saveProductionColumnSettings = function (
        key,
        json
    ) {

        try {

            localStorage.setItem(
                key,
                json
            );

            return true;

        }
        catch (error) {

            console.error(
                "Unable to save column settings:",
                error
            );

            return false;
        }

    };


    window.loadProductionColumnSettings = function (
        key
    ) {

        try {

            return localStorage.getItem(
                key
            );

        }
        catch (error) {

            console.error(
                "Unable to load column settings:",
                error
            );

            return null;
        }

    };


    window.clearProductionColumnSettings = function (
        key
    ) {

        try {

            localStorage.removeItem(
                key
            );

            return true;

        }
        catch (error) {

            console.error(
                "Unable to clear column settings:",
                error
            );

            return false;
        }

    };

</script>


