    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            // Clear old section data before loading new section
            ReportList.Clear();

            StateHasChanged();

            // Load data based on CURRENT selected section
            ReportList = await GSTR1Service.GetGSTR1Async(
                FromDate,
                ToDate,
                Section);

            isLoading = false;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            isLoading = false;

            await LoggingService.LogDeveloperError(
                ex,
                "Error in LoadData (GSTR1)");

            throw;
        }
    }



    private async Task ExportJson()
    {
        try
        {
            var jsonBytes = await GSTR1Service.ExportGSTR1JsonAsync(FromDate, ToDate, Section);

            await JS.DownloadJsonFileAsync(Convert.ToBase64String(jsonBytes), $"GSTR1_{Section}.json");
        }
        catch (Exception ex)
        {
            throw;
        }
    }

    private bool chkB2B;
    private bool chkB2CL;
    private bool chkB2CS;
    private bool chkCDNR;
    private bool chkHSN;
    private bool chkEXEMP;
    private bool chkDOCS;


    private void SectionChanged()
    {
        // IMPORTANT:
        // Clear previously loaded data when changing section.
        // Otherwise B2B data will remain visible while Section is B2CL.
        ReportList.Clear();

        // Reset all checkboxes
        chkB2B = false;
        chkB2CL = false;
        chkB2CS = false;
        chkCDNR = false;
        chkHSN = false;
        chkEXEMP = false;
        chkDOCS = false;

        // Select checkbox according to current Section
        switch (Section)
        {
            case "B2B":
                chkB2B = true;
                break;

            case "B2CL":
                chkB2CL = true;
                break;

            case "B2CS":
                chkB2CS = true;
                break;

            case "CDNRC":
                chkCDNR = true;
                break;

            case "HSN":
                chkHSN = true;
                break;

            case "EXEMP":
                chkEXEMP = true;
                break;

            case "DOCS":
                chkDOCS = true;
                break;
        }

        // Refresh UI immediately
        StateHasChanged();
    }



    private async Task PrintExcel()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            List<string> sections = new();

            if (chkB2B) sections.Add("B2B");
            if (chkB2CL) sections.Add("B2CL");
            if (chkB2CS) sections.Add("B2CS");
            if (chkCDNR) sections.Add("CDNRC");
            if (chkHSN) sections.Add("HSN");
            if (chkEXEMP) sections.Add("EXEMP");
            if (chkDOCS) sections.Add("DOCS");

            if (sections.Count == 0)
            {
                await JS.InvokeVoidAsync("alert", "Please select at least one report.");
                return;
            }

            var fileBytes = await GSTR1Service.ExportExcelAsync(
                FromDate,
                ToDate,
                sections);

            string fileName = $"GSTR1_{DateTime.Now:yyyyMMddHHmmss}.xlsx";

            await JS.InvokeVoidAsync(
                "downloadExcelFile",
                Convert.ToBase64String(fileBytes),
                fileName);
        }
        finally
        {
            isLoading = false;
        }
    }

