@page "/gstr1"

@using V.SMART.Shared.ViewModels.ReportViewModel.GSTITCVM
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.IGSTITC

@inject ILoggingService LoggingService
@inject IJSRuntime JS
@inject IGSTR1Service GSTR1Service
@inherits BaseUserRightsComponent
@inject NavigationManager _navigation

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <PageHeader TitleText="GSTR1"
                TitleIcon="bi bi-receipt-cutoff"
                Breadcrumbs="@PoBreadcrumbs" />

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="row align-items-end">

                <!-- From Date -->
                <div class="col-lg-2 col-md-3">
                    <label class="form-label fw-bold">From Date</label>
                    <InputDate class="form-control"
                               @bind-Value="FromDate" />
                </div>

                <!-- To Date -->
                <div class="col-lg-2 col-md-3">
                    <label class="form-label fw-bold">To Date</label>
                    <InputDate class="form-control"
                               @bind-Value="ToDate" />
                </div>


                <!-- Section -->
                <div class="col-lg-3 col-md-4">
                    <label class="form-label fw-bold">Section</label>

                    <InputSelect class="form-select"
                                 @bind-Value="Section"
                                 @bind-Value:after="SectionChanged">

                        <option value="B2B">Business To Business</option>
                        <option value="B2CL">Business To Consumer Large</option>
                        <option value="B2CS">Business To Consumer Small</option>
                        <option value="CDNRC">Credit Note</option>
                        <option value="HSN">HSN</option>
                        <option value="EXEMP">Export</option>
                        <option value="DOCS">Documents</option>

                    </InputSelect>
                </div>



                <!-- Select Reports -->
                <div class="col-lg-3 col-md-8">

                    <label class="form-label fw-bold">
                        Select Reports
                    </label>

                    <div class="d-flex flex-wrap gap-2">

                        <label><InputCheckbox @bind-Value="chkB2B" /> B2B</label>

                        <label><InputCheckbox @bind-Value="chkB2CL" /> B2CL</label>

                        <label><InputCheckbox @bind-Value="chkB2CS" /> B2CS</label>

                        <label><InputCheckbox @bind-Value="chkCDNR" /> CDNR</label>

                        <label><InputCheckbox @bind-Value="chkHSN" /> HSN</label>

                        <label><InputCheckbox @bind-Value="chkEXEMP" /> EXEMP</label>

                        <label><InputCheckbox @bind-Value="chkDOCS" /> DOCS</label>

                    </div>

                </div>

                <!-- Buttons -->
                <div class="col-lg-2 col-md-4">

                    <label class="form-label fw-bold">&nbsp;</label>

                    <div class="d-flex gap-2">

                        <!-- View - Blue -->
                        <button class="btn btn-primary flex-fill"
                                @onclick="LoadData">
                            <i class="bi bi-eye me-1"></i>
                            View
                        </button>

                        <!-- JSON - Dark / Secondary -->
                        <button class="btn btn-secondary flex-fill"
                                @onclick="ExportJson">
                            <i class="bi bi-filetype-json me-1"></i>
                            JSON
                        </button>

                        <!-- Print - Green -->
                        <button class="btn btn-success flex-fill"
                                @onclick="PrintExcel">
                            <i class="bi bi-printer me-1"></i>
                            Print
                        </button>

                    </div>

                </div>

            </div>

        </div>
    </div>

}

