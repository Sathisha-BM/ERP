@code
{
    protected override string ScreenName => "GSTR1";

    private bool isProcessing = true;

    private DateTime FromDate = DateTime.Today.AddMonths(-1);

    private DateTime ToDate = DateTime.Today;

    private string Section = "B2B";

    private bool isLoading;

    private List<GSTR1VM> ReportList = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;

            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            await LoadData();

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
        }
        finally
        {
            isProcessing = false;
        }
    }

