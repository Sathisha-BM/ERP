                                <i class="bi bi-shop fs-2 text-success"></i>

                            </div>

                            <div class="ms-3">

                                <h5 class="fw-bold mb-1">
                                    Vendor / Supplier Rating
                                </h5>

                                <div class="text-success fw-semibold">
                                    Performance Overview
                                </div>

                                <small class="text-muted">
                                    Financial Year
                                </small>

                                <br />

                                <span class="badge bg-success rounded-pill px-3 py-2 mt-1">
                                    @FinancialYear
                                </span>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label fw-bold text-dark">
                            <i class="bi bi-calendar2-week-fill text-primary me-2"></i>
                            Financial Year
                        </label>

                        <select class="form-select shadow-sm"
                                value="@SelectedFinancialYear"
                                @onchange="OnFinancialYearChanged">
                            @foreach (var fy in FinancialYears)
                            {
                                <option value="@fy.Year">@fy.DisplayText</option>
                            }
                        </select>
                    </div>


                    <!-- Type -->
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-bold text-primary">
                            <i class="bi bi-tags-fill me-1"></i> Type
                        </label>


                        <InputSelect class="form-select shadow-sm"
                                     Value="@SelectedType"
                                     ValueChanged="@(async (string value) => await OnTypeChanged(value))"
                                     ValueExpression="() => SelectedType">

                            <option value="">Select Type</option>
                            <option value="Purchase">Purchase</option>
                            <option value="Subcontract">Subcontract</option>

                        </InputSelect>
                    </div>

                    <!-- Center -->
                    <div class="col-lg-3">

                        <label class="form-label fw-bold text-success mb-2">
                            <i class="bi bi-person-badge-fill me-2"></i>
                            Select Vendor / Supplier
                        </label>

                        @* <MudAutocomplete T="int"
                                         Class="w-100"
                                         Dense="true"
                                         Margin="Margin.Dense"
                                         Variant="Variant.Outlined"
                                         Placeholder="All Vendors (Search to filter)"
                                         Value="@SelectedPartyVM"
                                         ValueChanged="@OnPartyChanged"
                                         SearchFunc="@SearchCustomers"
                                         ToStringFunc="@(x => x?.PartyName ?? string.Empty)"
                                         Clearable="true"
                                         ShowProgressIndicator="true"
                                         MinCharacters="0"
                                         OpenOnFocus="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false" /> *@


                        <MudAutocomplete T="int"
                                         Label="Select Party"
                                         Value="@SelectedPartyCode"
                                         ValueChanged="@OnPartyChanged"
                                         SearchFunc="@SearchCustomers"
                                         ToStringFunc="@(s => Parties.FirstOrDefault(x => x.PartyCode == s)?.PartyName ?? "")"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         Margin="Margin.Dense"
                                         OpenIcon="@Icons.Material.Filled.ArrowDropDown"
                                         CloseIcon="@Icons.Material.Filled.ArrowDropUp"
                                         ShowProgressIndicator="true"
                                         MinCharacters="0"
                                         OpenOnFocus="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         Placeholder="Select Party"
                                         Style="width:100%;" />

                    </div>




                    @* 
                <div class="btn-group mb-3">

                    <MudBlazor.MudAutocomplete T="string"
                     Class="w-100"
                     Dense="true"
                     Variant="MudBlazor.Variant.Outlined"
                     Placeholder="Select Chart Type..."
                      Value="@SelectedChart.ToString()"
                     ValueChanged="@OnChartChanged"
                     SearchFunc="@SearchChartTypes"
                     ToStringFunc="@(x => x ?? string.Empty)"
                     Clearable="true"
                     MinCharacters="0"
                     OpenOnFocus="true"
                     ResetValueOnEmptyText="true" />

                </div> *@





                </div>

            </div>


            @if (ShowRatings)
            {
                <div class="card shadow mt-3">

                    <!-- Header -->
                    <div class="card-header bg-success text-white py-2">
                        <div class="row align-items-center g-2">

                            <div class="col-12 col-lg-3">
                                <h5 class="mb-0">
                                    <i class="bi bi-table me-2"></i>
                                    Vendor Performance Details
                                </h5>
                            </div>




                            <div class="col-lg-8 col-md-7 col-12">
                                <div class="d-flex justify-content-lg-end justify-content-center gap-2">

                                    <button type="button"
                                            class="btn btn-light text-primary fw-semibold me-2 shadow-sm"
                                            @onclick="OpenCalculationModal">
                                        <i class="bi bi-calculator me-1"></i>
                                        Calculation
                                    </button>

                                    <button class="btn btn-primary"
                                            @onclick="ToggleChart">
                                        <i class="bi bi-bar-chart-fill me-2"></i>
                                        @(ShowChart ? "Hide Chart" : "Show Chart")
                                    </button>

                                </div>
                            </div>


                            <div class="col-12 col-md-3 col-lg-3 ms-auto text-end">
                                <button class="btn btn-primary w-100"
                                        @onclick="OnPrintPendingTrack">
                                    <i class="bi bi-download me-2"></i>
                                    Export Excel
                                </button>
                            </div>

                        </div>
                    </div>


                    <div class="card border-0 shadow-sm">

                        <div class="card-body p-2">

                            <div class="chart-toolbar">

                                <button class="btn btn-primary chart-btn"
                                        @onclick="() => ChangeChart(ChartType.Overall)">
                                    <i class="bi bi-speedometer2 me-1"></i> Overall
                                </button>

                                <button class="btn btn-success chart-btn"
                                        @onclick="() => ChangeChart(ChartType.Monthly)">
                                    <i class="bi bi-calendar3 me-1"></i> Monthly
                                </button>

                                <button class="btn btn-secondary chart-btn"
                                        @onclick="() => ChangeChart(ChartType.Bar)">
                                    <i class="bi bi-bar-chart-fill me-1"></i> Bar
                                </button>

                                <button class="btn btn-info text-white chart-btn"
                                        @onclick="() => ChangeChart(ChartType.Line)">
                                    <i class="bi bi-graph-up me-1"></i> Trend
                                </button>

                                <button class="btn btn-warning text-dark chart-btn"
                                        @onclick="() => ChangeChart(ChartType.Area)">
                                    <i class="bi bi-graph-up-arrow me-1"></i> Area
                                </button>

                                <button class="btn btn-primary chart-btn"
                                        @onclick="() => ChangeChart(ChartType.Radar)">
                                    <i class="bi bi-bullseye me-1"></i> Radar
                                </button>

                                <button class="btn btn-secondary chart-btn"
                                        @onclick="() => ChangeChart(ChartType.RadialBar)">
                                    <i class="bi bi-speedometer me-1"></i> RadialBar
                                </button>

                                @if (SelectedParty == null)
                                {

                                    <button class="btn btn-danger chart-btn"
                                            @onclick="() => ChangeChart(ChartType.Pie)">
                                        <i class="bi bi-pie-chart-fill me-1"></i> Pie
                                    </button>

                                    <button class="btn btn-dark chart-btn"
                                            @onclick="() => ChangeChart(ChartType.Donut)">
                                        <i class="bi bi-circle-fill me-1"></i> Donut
                                    </button>
                                }

                            </div>

                        </div>

                    </div>

                    <!-- Report -->
                    <div class="card-body">

                        @if (VendorRatingVMs != null && VendorRatingVMs.Any())
                        {
                            <div class="table-responsive border rounded" style="max-height:600px; overflow-x:auto; overflow-y:auto;">

                                <table class="table table-bordered table-sm mb-0 align-middle" style="min-width:1500px; white-space:nowrap;">

                                    <thead class="custom-blue text-center align-middle sticky-top">
                                        <tr>
                                            <th>Sl No</th>
                                            @*  <th>Vendor Code</th> *@
                                            <th>Vendor Name</th>
                                            <th>Apr</th>
                                            <th>May</th>
                                            <th>Jun</th>
                                            <th>Jul</th>
                                            <th>Aug</th>
                                            <th>Sep</th>
                                            <th>Oct</th>
                                            <th>Nov</th>
                                            <th>Dec</th>
                                            <th>Jan</th>
                                            <th>Feb</th>
                                            <th>Mar</th>
                                            <th>Overall Rating</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var item in VendorRatingVMs.Select((x, i) => new { x, i }))
                                        {
                                            <tr>
                                                <td>@(item.i + 1)</td>
                                                @* <td>@item.x.VendorCode</td> *@
                                                <td>@item.x.VendorName</td>
                                                <td>@(item.x.Apr.HasValue ? $"{item.x.Apr.Value:0.00}%" : "")</td>
                                                <td>@(item.x.May.HasValue ? $"{item.x.May.Value:0.00}%" : "")</td>
                                                <td>@(item.x.Jun.HasValue ? $"{item.x.Jun.Value:0.00}%" : "")</td>
                                                <td>@(item.x.Jul.HasValue ? $"{item.x.Jul.Value:0.00}%" : "")</td>
                                                <td>@(item.x.Aug.HasValue ? $"{item.x.Aug.Value:0.00}%" : "")</td>
                                                <td>@(item.x.Sep.HasValue ? $"{item.x.Sep.Value:0.00}%" : "")</td>
                                                <td>@(item.x.Oct.HasValue ? $"{item.x.Oct.Value:0.00}%" : "")</td>
                                                <td>@(item.x.Nov.HasValue ? $"{item.x.Nov.Value:0.00}%" : "")</td>
                                                <td>@(item.x.Dec.HasValue ? $"{item.x.Dec.Value:0.00}%" : "")</td>
                                                <td>@(item.x.Jan.HasValue ? $"{item.x.Jan.Value:0.00}%" : "")</td>
                                                <td>@(item.x.Feb.HasValue ? $"{item.x.Feb.Value:0.00}%" : "")</td>
                                                <td>@(item.x.Mar.HasValue ? $"{item.x.Mar.Value:0.00}%" : "")</td>

                                                <td class="text-center">
                                                    <span class="badge bg-success">
                                                        @($"{item.x.OverallRating:0.00}%")
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>

                                </table>

                            </div>


                            @if (ShowChart)
                            {
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="card shadow-sm mb-3">

                                            <div class="card-header bg-primary text-white">
                                                <h5 class="mb-0 text-center text-md-start">
                                                    <i class="bi bi-bar-chart-fill me-2"></i>
                                                    Vendor Performance Overview
                                                </h5>
                                            </div>

                                            <div class="card-body p-2 p-md-3">

                                                <div class="w-100 overflow-auto">
                                                    <div class="chart-container">

                                                        @if (SelectedChart == ChartType.Overall)
                                                        {


                                                            <ApexChart TItem="VendorRatingVM"
                                                                       Title="Overall Vendor Rating"
                                                                       Options="ChartOptions">

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Items="VendorRatingVMs"
                                                                                 Name="Overall Rating"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 XValue="x=>x.VendorName"
                                                                                 YValue="x=>(decimal)x.OverallRating" />

                                                            </ApexChart>

                                                        }
                                                        @if (SelectedChart == ChartType.Monthly)
                                                        {

                                                            <ApexChart TItem="VendorRatingVM"
                                                                       Title="Vendor Monthly Performance"
                                                                       Options="ChartOptions">

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Apr"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Apr ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="May"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.May ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Jun"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Jun ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Jul"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Jul ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Aug"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Aug ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Sep"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Sep ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Oct"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Oct ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Nov"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Nov ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Dec"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Dec ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Jan"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Jan ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Feb"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Feb ?? 0" />

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Name="Mar"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 Items="VendorRatingVMs"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.Mar ?? 0" />

                                                            </ApexChart>

                                                        }

                                                        @if (SelectedChart == ChartType.Bar)
                                                        {


                                                            <ApexChart TItem="VendorRatingVM"
                                                                       Title="Vendor Rating - Bar Chart"
                                                                       Options="ChartOptions">

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Items="VendorRatingVMs"
                                                                                 Name="Overall Rating"
                                                                                 SeriesType="SeriesType.Bar"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => (decimal)x.OverallRating" />

                                                            </ApexChart>

                                                        }
                                                        @if (SelectedChart == ChartType.Area)
                                                        {

                                                            <ApexChart TItem="VendorRatingVM"
                                                                       Title="Vendor Rating - Area Chart"
                                                                       Options="ChartOptions">

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Items="VendorRatingVMs"
                                                                                 Name="Overall Rating"
                                                                                 SeriesType="SeriesType.Area"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => (decimal)x.OverallRating" />

                                                            </ApexChart>

                                                        }
                                                        @if (SelectedChart == ChartType.Pie)
                                                        {

                                                            <ApexChart TItem="VendorRatingVM"
                                                                       Title="Vendor Share"
                                                                       Options="PieOptions">

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Items="VendorRatingVMs"
                                                                                 Name="Overall"
                                                                                 SeriesType="SeriesType.Pie"
                                                                                 XValue="x=>x.VendorName"
                                                                                 YValue="x=>(decimal)x.OverallRating" />

                                                            </ApexChart>

                                                        }
                                                        @if (SelectedChart == ChartType.Line)
                                                        {

                                                            <ApexChart TItem="VendorRatingVM"
                                                                       Title="Vendor Rating Trend"
                                                                       Options="ChartOptions">

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Items="VendorRatingVMs"
                                                                                 Name="Overall"
                                                                                 SeriesType="SeriesType.Line"
                                                                                 XValue="x=>x.VendorName"
                                                                                 YValue="x=>(decimal)x.OverallRating" />

                                                            </ApexChart>

                                                        }
                                                        @if (SelectedChart == ChartType.Donut)
                                                        {

                                                            <ApexChart TItem="VendorRatingVM"
                                                                       Title="Vendor Rating Distribution"
                                                                       Options="DonutOptions">

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Items="VendorRatingVMs"
                                                                                 Name="Overall"
                                                                                 SeriesType="SeriesType.Donut"
                                                                                 XValue="x=>x.VendorName"
                                                                                 YValue="x=>(decimal)x.OverallRating" />

                                                            </ApexChart>

                                                        }
                                                        @if (SelectedChart == ChartType.Radar && VendorRatingVMs.Any())
                                                        {

                                                            <ApexChart TItem="VendorRatingVM"
                                                                       Title="Vendor Rating - Radar Chart"
                                                                       Options="ChartOptions1">

                                                                <ApexPointSeries TItem="VendorRatingVM"
                                                                                 Items="VendorRatingVMs"
                                                                                 Name="Overall Rating"
                                                                                 SeriesType="SeriesType.Radar"
                                                                                 XValue="x => x.VendorName"
                                                                                 YValue="x => x.OverallRating" />

                                                            </ApexChart>

                                                        }

                                                        @if (SelectedChart == ChartType.RadialBar)
                                                        {

                                                            <ApexChart TItem="GaugeVM" Title="Overall Rating"
                                                                       Options="ChartOptions2">

                                                                <ApexPointSeries TItem="GaugeVM"
                                                                                 Items="GaugeData"
                                                                                 Name="Overall"
                                                                                 SeriesType="SeriesType.RadialBar"
                                                                                 XValue="x => x.Label"
                                                                                 YValue="x => x.Value" />

                                                            </ApexChart>

                                                        }
                                                    </div>

                                                </div>

                                            </div>

                                        </div>


                                    </div>

                                </div>

                            }
                            @if (ShowCalculationModal)
                            {
                                <div class="modal fade show d-block"
                                     tabindex="-1"
                                     style="background-color: rgba(0,0,0,0.5);">

                                    <div class="modal-dialog modal-lg modal-dialog-centered">

                                        <div class="modal-content shadow-lg border-0">

                                            <!-- Modal Header -->
                                            <div class="modal-header bg-primary text-white">

                                                <h5 class="modal-title fw-bold">
                                                    <i class="bi bi-speedometer2 me-2"></i>
                                                    Vendor Performance Rating Methodology
                                                </h5>

                                                <button type="button"
                                                        class="btn-close btn-close-white"
                                                        @onclick="CloseCalculationModal">
                                                </button>

                                            </div>


                                            <!-- Modal Body -->
                                            <div class="modal-body">

                                                <!-- Information -->
                                                <div class="alert alert-primary d-flex align-items-start">

                                                    <i class="bi bi-info-circle-fill me-2 mt-1"></i>

                                                    <div>
                                                        <strong>Vendor Performance Evaluation</strong>
                                                        <div class="small mt-1">
                                                            Vendor performance is evaluated based on
                                                            <strong>Delivery Performance</strong> and
                                                            <strong>Quality Performance</strong>.
                                                        </div>
                                                    </div>

                                                </div>


                                                <!-- Rating Methodology -->
                                                <div class="table-responsive">

                                                    <table class="table table-bordered table-hover align-middle mb-0">

                                                        <thead class="table-light">

                                                            <tr>
                                                                <th style="width: 22%;">
                                                                    <i class="bi bi-list-check me-1"></i>
                                                                    Rating Criteria
                                                                </th>

                                                                <th style="width: 58%;">
                                                                    <i class="bi bi-calculator me-1"></i>
                                                                    Evaluation Method
                                                                </th>

                                                                <th class="text-center" style="width: 20%;">
                                                                    Maximum Score
                                                                </th>
                                                            </tr>

                                                        </thead>


                                                        <tbody>

                                                            <!-- Delivery Rating -->
                                                            <tr>

