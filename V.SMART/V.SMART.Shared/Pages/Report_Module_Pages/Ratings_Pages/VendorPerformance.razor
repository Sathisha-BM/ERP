    private async Task LoadVendorsAsync()
    {


        var vendors = await venderratingService.GetAllVendorsAsync(
        SelectedType,
        FromDate!.Value,
        ToDate!.Value);

        Parties = vendors
          .DistinctBy(x => x.VendorCode)
          .Select(x => new PartyVM
          {
              PartyCode = x.VendorCode,
              PartyName = x.VendorName
          })
          .OrderBy(x => x.PartyName)
