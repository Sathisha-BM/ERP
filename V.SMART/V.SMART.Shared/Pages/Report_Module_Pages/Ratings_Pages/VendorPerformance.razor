    private Task<IEnumerable<int>> SearchCustomers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(Parties.Select(x => x.PartyCode));

        var result = Parties
            .Where(x => x.PartyName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.PartyCode);

        return Task.FromResult(result);
    }



    private async Task OnPartyChanged(int value)
    {
        try
        {
            isProcessing = true;

