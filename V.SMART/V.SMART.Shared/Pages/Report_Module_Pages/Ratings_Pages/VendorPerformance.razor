    private async Task OnFinancialYearChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            if (e.Value == null)
                return;

            if (!int.TryParse(e.Value.ToString(), out int selectedYear))
                return;

            SelectedFinancialYear = selectedYear;

            // Set FY date range
            SetFinancialYearDates();

            // Clear selected vendor because FY changed
            SelectedPartyVM = null;


            // Clear existing vendor list
            Parties.Clear();

            SelectedType = null;
            VendorRatingVMs.Clear();

            // Load vendors only for selected FY and selected type
            if (!string.IsNullOrWhiteSpace(SelectedType))
            {
                await LoadVendorsAsync();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "Error occurred while changing Financial Year");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private void SetFinancialYearDates()
    {
        if (SelectedFinancialYear < 1)
            return;

        FromDate = new DateTime(
            SelectedFinancialYear,
            4,
            1);

        ToDate = new DateTime(
            SelectedFinancialYear + 1,
            3,
            31);
    }



    private string FinancialYear =>
    DateTime.Today.Month >= 4
        ? $"{DateTime.Today.Year}-{(DateTime.Today.Year + 1).ToString().Substring(2)}"
        : $"{DateTime.Today.Year - 1}-{DateTime.Today.Year.ToString().Substring(2)}";


    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;

            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            UserName = await CurrentUserService.GetUsernameAsync();

            // =====================================================
            // PURCHASE:
            // PurchPo
            // → PurchPoSub
            // → PurchaseGRNSub
            // → PurchaseSCNSub
            // → PurchaseSCN
            // =====================================================

            var purchasePoDates =
                from po in _unitOfWork.PurchPos.GetQueryable()

                join poSub in _unitOfWork.PurchPoSubs.GetQueryable()
                    on po.PoId equals poSub.PoId

                join grnSub in _unitOfWork.PurchaseGRNSubs.GetQueryable()
                    on poSub.PoSubId equals grnSub.RefPoSubId

                join scnSub in _unitOfWork.PurchaseSCNSubs.GetQueryable()
                    on grnSub.GRNSubId equals scnSub.RefGRNSubId

                join scn in _unitOfWork.PurchaseSCNs.GetQueryable()
                    on scnSub.SCNId equals scn.SCNId

                where po.PODate != default
                      && po.PurchORSubCon == true
                      && scn.SCNId > 0

                select po.PODate;


            // =====================================================
            // SUBCONTRACT:
            // PurchPo
            // → PurchPoSub
            // → SubConDcOutSub
            // → SubConGRNSub
            // → SubConSCNSub
            // → SubConSCN
            // =====================================================

            var subcontractPoDates =
                from po in _unitOfWork.PurchPos.GetQueryable()

                join poSub in _unitOfWork.PurchPoSubs.GetQueryable()
                    on po.PoId equals poSub.PoId

                join dcOutSub in _unitOfWork.SubConDCOutSubs.GetQueryable()
                    on poSub.PoSubId equals dcOutSub.RefPoSubId

                join grnSub in _unitOfWork.SubConGRNSubs.GetQueryable()
                    on dcOutSub.DcSubId equals grnSub.RefDcSubId

                join scnSub in _unitOfWork.SubConSCNSubs.GetQueryable()
                    on grnSub.GRNSubId equals scnSub.RefGRNSubId

                join scn in _unitOfWork.SubConSCNs.GetQueryable()
                    on scnSub.SCNId equals scn.SCNId

                where po.PODate != default
                      && po.PurchORSubCon == false
                      && scn.SCNId > 0

                select po.PODate;


            // =====================================================
            // COMBINE PURCHASE + SUBCONTRACT PO DATES
            // =====================================================

            var poDates = await purchasePoDates
                .Union(subcontractPoDates)
                .Distinct()
                .OrderByDescending(x => x)
                .ToListAsync();
            // Create unique Financial Years from PO dates
            FinancialYears = poDates
                .Select(d =>
                {
                    int year = d.Month >= 4
                        ? d.Year
                        : d.Year - 1;

                    return new FinancialYearVM
                    {
                        Year = year,
                        DisplayText = $"{year}-{(year + 1).ToString().Substring(2)}"
                    };
                })
                .GroupBy(x => x.Year)
                .Select(g => g.First())
                .OrderByDescending(x => x.Year)
                .ToList();

            // Select latest available Financial Year
            if (FinancialYears.Any())
            {
                SelectedFinancialYear = FinancialYears.First().Year;

                SetFinancialYearDates();

                // Load vendors for selected Financial Year
                // await LoadVendorsAsync();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "Error occurred while loading Vendor Performance Report");
        }
        finally
        {
            isProcessing = false;
        }
    }

