@page "/VendorPerformance"
@using System.Dynamic
@using System.Collections.Generic;
@using ApexCharts

@using MudBlazor
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.ITrackReportService

@using V.SMART.Shared.ViewModels.AccountsViewModel
@using V.SMART.Shared.ViewModels.ReportViewModel.VendorRaing
@using V.SMART.Shared.ViewModels.ReportViewModel.VendorRatingVM

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject IVenderratingService venderratingService
@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService


<style>
    .chart-toolbar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 8px;
        width: 100%;
    }

    .chart-btn {
        width: 100%;
        height: 50px;
        font-size: 14px;
        font-weight: 600;
        border-radius: 8px;
        white-space: nowrap;
        transition: all 0.25s ease;
    }

        .chart-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,.2);
        }


    /* Large screens */
    @@media (max-width: 1400px) {
        .chart-toolbar {
            grid-template-columns: repeat(5, 1fr);
        }
    }

    /* Tablet */
    @@media (max-width: 992px) {
        .chart-toolbar {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* Mobile */
    @@media (max-width: 576px) {
        .chart-toolbar {
            grid-template-columns: repeat(2, 1fr);
        }

        .chart-btn {
            height: 45px;
            font-size: 13px;
        }
    }

    .chart-container {
        width: 100%;
        min-height: 350px;
    }

    @@media (max-width: 768px) {
        .chart-container {
            min-height: 250px;
        }

        .card-header h5 {
            font-size: 1rem;
            text-align: center;
        }

        .table {
            font-size: 0.8rem;
        }
    }
</style>
@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing"
                       Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-4 mt-4">

        <!-- Page Header -->
        <PageHeader TitleText="Vendor Performance"
                    TitleIcon="bi bi-speedometer2"
                    Breadcrumbs="@VendorPerformanceBreadcrumbs" />

        <div class="card shadow-lg border-0">


            <!-- Top Banner -->
            <div class="card-body">

                <div class="rounded-3 p-4 text-white"
                     style="background: linear-gradient(90deg, #0d6efd, #198754);">

                    <div class="row align-items-center">

                        <div class="col-lg-8">

                            <h2 class="fw-bold mb-2">
                                <i class="bi bi-speedometer2 me-2"></i>
                                Vendor Performance Dashboard
                            </h2>

                            <p class="mb-0">
                                Monitor Vendor Performance | Delivery | Quality | Rating
                            </p>

                        </div>

                        <div class="col-lg-4 text-end">

                            <h4 class="fw-bold mb-1">
                                @FinancialYear
                            </h4>

                            <small>
                                <i class="bi bi-calendar-event me-1"></i>
                                @DateTime.Now.ToString("dd MMM yyyy")
                            </small>

                        </div>

                    </div>

                </div>

            </div>



            <!-- Filter -->
