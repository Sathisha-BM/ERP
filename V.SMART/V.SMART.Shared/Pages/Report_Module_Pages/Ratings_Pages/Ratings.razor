    }
    private void LoadDelayGraphData()
    {
        DelayData = new List<DelayDaysSummary>();

        if (RatingVMs == null || !RatingVMs.Any())
            return;

        var data = RatingVMs
            .Where(x => x.TotalDays >= 0 &&
                        !string.IsNullOrWhiteSpace(x.InvNo))
            .Select(x => new
            {
                InvoiceNo = x.InvNo,
                DelayDays = x.TotalDays
            })
            .ToList();

        if (!data.Any())
            return;

        long maxDelayDays = data.Max(x => x.DelayDays ?? 0);

        // -------------------------------------------------------
        // CASE 1: Small delay range
        // Show individual delay days
        // -------------------------------------------------------
        if (maxDelayDays <= 121)
        {
            DelayData = data
                .GroupBy(x => x.DelayDays)
                .Select(g => new DelayDaysSummary
                {
                    Label = g.Key.ToString(),

                    InvoiceCount = g
                        .Select(x => x.InvoiceNo)
                        .Distinct()
                        .Count()
                })
                .OrderBy(x => int.Parse(x.Label))
                .ToList();
        }

        // -------------------------------------------------------
        // CASE 2: Large delay range
        // Group into 10-day ranges
        // -------------------------------------------------------
        else
        {
            DelayData = data
                .GroupBy(x => new
                {
                    Start = (x.DelayDays / 10) * 10
                })
                .Select(g =>
                {
                    long start = g.Key.Start ?? 0;
                    long end = start + 9;

                    return new DelayDaysSummary
                    {
                        Label = $"{start}-{end}",

                        InvoiceCount = g
                            .Select(x => x.InvoiceNo)
                            .Distinct()
                            .Count()
                    };
                })
                .OrderBy(x => int.Parse(x.Label.Split('-')[0]))
                .ToList();
        }
    }

