@page "/Ratings"

@using System.Dynamic
@using System.Collections.Generic;
@using MudBlazor
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.ITrackReportService
@using V.SMART.Shared.ViewModels.ReportViewModel.RatingsVM
@using ApexCharts
@using SmartGridColumn = V.SMART.Shared.ViewModels.GridColumn

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject IRatingService ratingService
@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService



@* Sathish *@
@inject IDialogService DialogService


<style>
    .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
    }

        .table-responsive thead th {
            position: sticky;
            top: 0;
            z-index: 100;
            background: #0d6efd;
            color: #fff;
            border-bottom: 2px solid #0a58ca;
        }

    .small-autocomplete .mud-input-control {
        min-height: 32px;
    }

    .small-autocomplete .mud-input-slot {
        min-height: 32px;
        padding-top: 4px;
        padding-bottom: 4px;
    }

    .small-autocomplete input {
        padding: 4px 8px !important;
        font-size: 13px;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid mt-4">


        <PageHeader TitleText="Sales Track"
                    TitleIcon="bi bi-receipt-cutoff"
                    Breadcrumbs="@RatingBreadcrumbs" />

        <!-- Header -->
        <div class="card border-0 shadow-lg mb-4">

            <div class="card-header bg-light border-bottom">

                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-body bg-primary text-white rounded">

                        <div class="row align-items-center">

                            <div class="col-md-8">

                                <h4 class="fw-bold mb-1">
                                    <i class="bi bi-speedometer2 me-2"></i>
                                    Performance Ratings
                                </h4>

                                <small class="opacity-75">
                                    Rating Dashboard
                                </small>

                            </div>

                            <div class="col-md-4 text-md-end mt-3 mt-md-0">

                                <button type="button"
                                        class="btn btn-light text-primary fw-semibold me-2 shadow-sm"
                                        @onclick="OpenCalculationModal">
                                    <i class="bi bi-calculator me-1"></i>
                                    Calculation
                                </button>

                                <span class="badge bg-light text-primary fs-6 px-3 py-2 shadow-sm">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @DateTime.Today.ToString("dd MMM yyyy")
                                </span>

                            </div>

                        </div>

                    </div>
                </div>

            </div>


            <div class="card-body bg-light">

                <div class="row g-3">

                    <!-- From Date -->
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-bold text-dark">
                            From Date
                        </label>

                        <InputDate class="form-control shadow-sm"
                                   @bind-Value="FromDate" />
                    </div>

                    <!-- To Date -->
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-bold text-dark">
                            To Date
                        </label>

                        <InputDate class="form-control shadow-sm"
                                   @bind-Value="ToDate" />
                    </div>

                    <!-- Type -->
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-bold text-primary">
                            Type
                        </label>


                        <InputSelect class="form-select shadow-sm"
                                     Value="@SelectedType"
                                     ValueChanged="@(async (string value) => await OnTypeChanged(value))"
                                     ValueExpression="() => SelectedType">

                            <option value="">Select Type</option>
                            <option value="Sales">Sales</option>
                            <option value="Purchase">Purchase</option>
                            <option value="Labour">Labour</option>
                            <option value="Subcontract">Subcontract</option>

                        </InputSelect>
                    </div>


                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-bold text-success">
                            @PartyLabel
                        </label>

                        <MudBlazor.MudAutocomplete T="PartyVM"
                                                   Class="small-autocomplete"
                                                   Value="@SelectedPartyVM"
                                                   ValueChanged="@OnPartyChanged"
                                                   SearchFunc="@SearchCustomers"
                                                   ToStringFunc="@(new Func<PartyVM?, string>(x => x?.Name ?? string.Empty))"
                                                   Placeholder="Search or select party"
                                                   Variant="MudBlazor.Variant.Outlined"
                                                   Dense="true"
                                                   Clearable="true" />
                    </div>




                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-bold text-success">
                            Item
                        </label>

                        <MudBlazor.MudAutocomplete T="ItemVM"
                                                   Value="@SelectedItemVM"
                                                   ValueChanged="@OnItemChanged"
                                                   SearchFunc="@SearchItems"
                                                   ToStringFunc="@(x => x?.ItemCode ?? string.Empty)"
                                                   Placeholder="Search or select Item"
                                                   Variant="MudBlazor.Variant.Outlined"
                                                   Dense="true"
                                                   Clearable="true"
                                                   ResetValueOnEmptyText="true"
                                                   Class="w-100 small-autocomplete" />
                    </div>



                    <!-- Search -->
                    <div class="col-lg-2 col-md-12 d-flex align-items-end gap-2" ">
                        <button class="btn btn-success w-100 shadow-sm"
                                @onclick="GetRatings">

                            <i class="bi bi-search me-2"></i>
                            Ratings View

                        </button>

                        <button class="btn btn-secondary w-100 shadow-sm"
                                @onclick="GetFPYReport">

                            <i class="bi bi-search me-2"></i>
                            FPY View

                        </button>
                    </div>


                </div>

            </div>

        </div>


        <!-- Results -->
        @if ((ShowRatings && RatingVMs.Any()) || (ShowFPY && FPYReport.Any()))
        {
            <div class="card border-0 shadow-lg">

                <!-- Header -->
                @if (ShowRatings)
                {
                    <div class="card-header bg-success text-white py-2">

                        <div class="row align-items-center g-2">

                            <div class="col-12 col-lg-2">
                                <h5 class="mb-0">
                                    <i class="bi bi-table me-2"></i>
                                    Rating Details
                                </h5>
                            </div>

                            <div class="col-12 col-md-6 col-lg-2">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-search"></i>
                                    </span>

                                    <InputText class="form-control"
                                               placeholder="Search..."
                                               @bind-Value="searchText"
                                               @oninput="e => searchText = e.Value?.ToString()" />
                                </div>
                            </div>

                            <div class="col-12 col-md-3 col-lg-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@DetailsView"
                                       @onchange="OnDetailViewChanged" />

                                <label class="form-check-label ms-1">
                                    Detail View
                                </label>
                            </div>

                            <div class="col-12 col-md-3 col-lg-2">
                                <ColumnMenu Columns="Columns"
                                            ScreenName="@ScreenName"
                                            UserId="@UserName"
                                            MaxVisible="int.MaxValue"
                                            OnChanged="HandleColumnChange" />
                            </div>




                            <div class="col-12 col-md-3 col-lg-2">
                                <button class="btn btn-light w-100"
                                        @onclick="OnPrintPendingTrack">
                                    <i class="bi bi-download me-2"></i>
                                    Export Excel
                                </button>
                            </div>

                            @* Sathish *@
                            <div class="col-12 col-md-3 col-lg-2">
                                <button class="btn btn-light w-100"
                                        @onclick="ToggleDelayGraph">

                                    <i class="bi bi-bar-chart-fill me-2"></i>

                                    @(ShowDelayGraph ? "Hide Graph" : "View Graph")

                                </button>
                            </div>

                        </div>

                    </div>
                }
                else if (ShowFPY)
                {
                    <div class="card-header bg-success text-white py-2">

                        <div class="row align-items-center">

                            <div class="col-lg-4 col-md-4">
                                <h5 class="mb-0">
                                    <i class="bi bi-pie-chart me-2"></i>
                                    First Pass Yield (FPY) Report
                                </h5>
                            </div>



                            <div class="col-lg-3 col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-search"></i>
                                    </span>

                                    <InputText class="form-control"
                                               placeholder="Search..."
                                               @bind-Value="searchText1"
                                               @oninput="e => searchText1 = e.Value?.ToString()" />
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-4 text-end">
                                <button class="btn btn-light"
                                        @onclick="OnPrintPendingTrack1">
                                    <i class="bi bi-download me-2"></i>
                                    Export Excel
                                </button>
                            </div>

                            @* Sathish *@
                            <div class="col-12 col-md-3 col-lg-2">
                                <button class="btn btn-light w-100"
                                        @onclick="ToggleDelayGraph">

                                    <i class="bi bi-bar-chart-fill me-2"></i>

                                    @(ShowDelayGraph ? "Hide Graph" : "View Graph")

                                </button>
                            </div>

                        </div>

                    </div>
                }

                <!-- Body -->
                <div class="card-body">

                    @if (ShowRatings)
                    {
                        <!-- Put your existing Rating table here -->
                        @* <table class="table table-hover table-striped table-bordered align-middle"> *@

                        <div class="table-responsive border rounded" style="max-height:600px; overflow-x:auto; overflow-y:auto;">

                            <table class="table table-bordered table-sm mb-0 align-middle" style="min-width:1500px; white-space:nowrap;">


                                <thead class="custom-blue text-center align-middle sticky-top">
                                    <tr>
                                        @if (IsVisible("SlNo"))
                                        {
                                            <th>Sl No</th>
                                        }
                                        @if (IsVisible("CustName"))
                                        {
                                            <th>Customer Name</th>
                                        }
                                        @if (IsVisible("PONo"))
                                        {
                                            <th>PO No</th>
                                        }

                                        @if (IsVisible("PODate"))
                                        {
                                            <th>PO Date</th>
                                        }
                                        @if (IsVisible("LineNumber"))
                                        {
                                            <th>LineNumber</th>
                                        }
                                        @if (DetailsView && IsVisible("ItemCode"))
                                        {
                                            <th>Item Code</th>
                                        }

                                        @if (DetailsView && IsVisible("ItemName"))
                                        {
                                            <th>Item Name</th>
                                        }

                                        @if (IsVisible("Qty"))
                                        {
                                            <th>Qty</th>
                                        }

                                        @*   @if (DetailsView && IsVisible("WoNo"))
                                    {
                                        <th>WO No</th>
                                    } *@
                                        @if (IsVisible("PoDueDate"))
                                        {
                                            <th>Due Date</th>
                                        }

                                        @if (IsVisible("DcNo"))
                                        {
                                            <th>DC No</th>
                                        }
                                        @if (IsVisible("DCDate"))
                                        {
                                            <th>DC Date</th>
                                        }
                                        @if (IsVisible("DcQty"))
                                        {
                                            <th>DC Qty</th>
                                        }
                                        @if (IsVisible("RejectQty"))
                                        {
                                            <th>Reject Qty</th>
                                        }
                                        @if (IsVisible("ReworkQty"))
                                        {
                                            <th>R/W Qty</th>
                                        }
                                        @if (IsVisible("InvNo"))
                                        {
                                            <th>Inv No</th>
                                        }
                                        @if (IsVisible("InvDate"))
                                        {
                                            <th>Inv Date</th>
                                        }
                                        @if (IsVisible("INVQty"))
                                        {
                                            <th>Inv Qty</th>
                                        }
                                        @if (IsVisible("DepartmentCode"))
                                        {
                                            <th>DepartmentCode</th>
                                        }
                                        @if (IsVisible("JobNo"))
                                        {
                                            <th>JobNo</th>
                                        }
                                        @if (IsVisible("JobDate"))
                                        {
                                            <th>JobDate</th>
                                        }
                                        @if (IsVisible("TotalDays"))
                                        {
                                            <th>Delay Days</th>
                                        }
                                        @if (IsVisible("Perfarmence Rating"))
                                        {
                                            <th>Perfarmence Rating</th>
                                        }
                                        @if (IsVisible("DeliveryRating"))
                                        {
                                            <th>Delivery Rating</th>
                                        }
                                        @if (IsVisible("QualityRating"))
                                        {
                                            <th>Quality Rating</th>
                                        }
                                        @if (IsVisible("SalesRating"))
                                        {
                                            <th>Sales Rating</th>
                                        }
                                        @if (IsVisible("VendorRating"))
                                        {
                                            <th>Vendor Rating</th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in FilteredRatings.Select((x, i) => new { x, i }))
                                    {
                                        <tr>
                                            @if (IsVisible("SlNo"))
                                            {
                                                <td>@(item.i + 1)</td>
                                            }

                                            @if (IsVisible("CustName"))
                                            {
                                                <td class="fw-semibold">@item.x.CustName</td>
                                            }

                                            @if (IsVisible("PONo"))
                                            {
                                                <td>@item.x.PONo</td>
                                            }

                                            @if (IsVisible("PODate"))
                                            {
                                                <td>@item.x.PODate?.ToString("dd/MM/yyyy")</td>
                                            }
                                            @if (IsVisible("LineNumber"))
                                            {
                                                <td>@item.x.LineNumber</td>
                                            }

                                            @if (DetailsView && IsVisible("ItemCode"))
                                            {
                                                <td>@item.x.ItemCode</td>
                                            }

                                            @if (DetailsView && IsVisible("ItemName"))
                                            {
                                                <td>@item.x.ItemName</td>
                                            }

                                            @if (IsVisible("Qty"))
                                            {
                                                <td>@item.x.Qty</td>
                                            }

                                            @*  @if (DetailsView && IsVisible("WoNo"))
                                        {
                                            <td>@item.x.WoNo</td>
                                        } *@

                                            @if (IsVisible("PoDueDate"))
                                            {
                                                <td>@item.x.PoDueDate?.ToString("dd/MM/yyyy")</td>
                                            }

                                            @if (IsVisible("DcNo"))
                                            {
                                                <td>@item.x.DcNo</td>
                                            }

                                            @if (IsVisible("DCDate"))
                                            {
                                                <td>@item.x.DCDate?.ToString("dd/MM/yyyy")</td>
                                            }

                                            @if (IsVisible("DcQty"))
                                            {
                                                <td>@item.x.DcQty</td>
                                            }

                                            @if (IsVisible("RejectQty"))
                                            {
                                                <td>@item.x.RejectQty</td>
                                            }

                                            @if (IsVisible("ReworkQty"))
                                            {
                                                <td>@item.x.ReworkQty</td>
                                            }

                                            @if (IsVisible("InvNo"))
                                            {
                                                <td>@item.x.InvNo</td>
                                            }

                                            @if (IsVisible("InvDate"))
                                            {
                                                <td>@item.x.InvDate?.ToString("dd/MM/yyyy")</td>
                                            }

                                            @if (IsVisible("INVQty"))
                                            {
                                                <td>@item.x.INVQty</td>
                                            }

                                            @if (IsVisible("DepartmentCode"))
                                            {
                                                <td>@item.x.DepartmentCode</td>
                                            }

                                            @if (IsVisible("JobNo"))
                                            {
                                                <td>@item.x.JobNo</td>
                                            }

                                            @if (IsVisible("JobDate"))
                                            {
                                                <td>@item.x.JobDate?.ToString("dd/MM/yyyy")</td>
                                            }



                                            @if (IsVisible("TotalDays"))
                                            {
                                                <td>
                                                    <span class="badge bg-info">
                                                        📅 @item.x.TotalDays
                                                    </span>
                                                </td>
                                            }

                                            @if (IsVisible("Perfarmence Rating"))
                                            {
                                                <td>
                                                    <span class="badge bg-warning text-dark">
                                                        ⭐ @item.x.Rating
                                                    </span>
                                                </td>
                                            }

                                            @if (IsVisible("DeliveryRating"))
                                            {
                                                <td>
                                                    <span class="badge bg-primary">
                                                        ⭐ @item.x.DeliveryRating
                                                    </span>
                                                </td>
                                            }

                                            @if (IsVisible("QualityRating"))
                                            {
                                                <td>
                                                    <span class="badge bg-success">
                                                        ⭐  @item.x.QualityRating
                                                    </span>
                                                </td>
                                            }

                                            @if (IsVisible("SalesRating"))
                                            {
                                                <td>
                                                    <span class="badge bg-secondary">
                                                        ⭐ @item.x.SalesRating
                                                    </span>
                                                </td>
                                            }

                                            @if (IsVisible("VendorRating"))
                                            {
                                                <td>
                                                    <span class="badge bg-danger">
                                                        ⭐ @item.x.VendorRating
                                                    </span>
                                                </td>
                                            }


                                        </tr>
                                    }

                                </tbody>

                            </table>
                        </div>
                    }
                    @if (ShowCalculationModal)
                    {
                        <div class="modal fade show d-block"
                             tabindex="-1"
                             style="background-color: rgba(0,0,0,0.5);">

                            <div class="modal-dialog modal-lg modal-dialog-centered">

                                <div class="modal-content shadow-lg border-0">

                                    <!-- Modal Header -->
                                    <div class="modal-header bg-primary text-white">

                                        <h5 class="modal-title fw-bold">
                                            <i class="bi bi-speedometer2 me-2"></i>
                                            Performance Rating Methodology
                                        </h5>

                                        <button type="button"
                                                class="btn-close btn-close-white"
                                                @onclick="CloseCalculationModal">
                                        </button>

                                    </div>


                                    <!-- Modal Body -->
                                    <div class="modal-body">

                                        <!-- Information -->
                                        <div class="alert alert-primary d-flex align-items-start">

                                            <i class="bi bi-info-circle-fill me-2 mt-1"></i>

                                            <div>
                                                <strong>Performance Evaluation</strong>

                                                <div class="small mt-1">
                                                    Performance ratings are calculated based on
                                                    the applicable delivery, quality, sales and
                                                    transaction-related performance parameters.
                                                </div>
                                            </div>

                                        </div>


                                        <!-- Rating Methodology -->
                                        <div class="table-responsive">

                                            <table class="table table-bordered table-hover align-middle mb-0">

                                                <thead class="table-light">

                                                    <tr>

                                                        <th style="width: 22%;">
                                                            <i class="bi bi-list-check me-1"></i>
                                                            Rating Criteria
                                                        </th>

                                                        <th style="width: 58%;">
                                                            <i class="bi bi-calculator me-1"></i>
                                                            Evaluation Method
                                                        </th>

                                                        <th class="text-center" style="width: 20%;">
                                                            Maximum Score
                                                        </th>

                                                    </tr>

                                                </thead>


                                                <tbody>

                                                    <!-- Due Date -->
                                                    <tr>

                                                        <td>
                                                            <i class="bi bi-calendar-event me-2 text-primary"></i>
                                                            <strong>Due Date Compliance</strong>
                                                        </td>

                                                        <td>

                                                            <div>
                                                                Evaluated based on the difference
                                                                between the
                                                                <strong>Due Date</strong> and
                                                                <strong>Invoice Date</strong>.
                                                            </div>

                                                            <div class="small text-muted mt-2">

                                                                <i class="bi bi-info-circle me-1"></i>

                                                                If the Invoice Date is unavailable,
                                                                the <strong>DC Date</strong> is
                                                                considered for evaluation.

                                                            </div>

                                                        </td>

                                                        <td class="text-center">

                                                            <span class="badge bg-success fs-6 px-3 py-2">
                                                                100
                                                            </span>

                                                        </td>

                                                    </tr>


                                                    <!-- Performance Rating -->
                                                    <tr>

                                                        <td>

                                                            <i class="bi bi-speedometer2 me-2 text-primary"></i>
                                                            <strong>Performance Rating</strong>

                                                        </td>

                                                        <td>

                                                            <div class="mb-3">

                                                                Based on the difference between
                                                                <strong>Invoice Date</strong>
                                                                and
                                                                <strong>DC Date</strong>.

                                                            </div>


                                                            <div class="row g-2">

                                                                <div class="col-md-6">

                                                                    <span class="badge bg-success w-100 py-2">
                                                                        0–2 Days : 100 Points
                                                                    </span>

                                                                </div>

                                                                <div class="col-md-6">

                                                                    <span class="badge bg-success w-100 py-2">
                                                                        3–6 Days : 90 Points
                                                                    </span>

                                                                </div>

                                                                <div class="col-md-6">

                                                                    <span class="badge bg-warning text-dark w-100 py-2">
                                                                        7–10 Days : 75 Points
                                                                    </span>

                                                                </div>

                                                                <div class="col-md-6">

                                                                    <span class="badge bg-warning text-dark w-100 py-2">
                                                                        11–14 Days : 50 Points
                                                                    </span>

                                                                </div>

                                                                <div class="col-md-6">

                                                                    <span class="badge bg-danger w-100 py-2">
                                                                        Above 14 Days : 0 Points
                                                                    </span>

                                                                </div>

                                                            </div>

                                                        </td>

                                                        <td class="text-center">

                                                            <span class="badge bg-success fs-6 px-3 py-2">
                                                                100
                                                            </span>

                                                        </td>

                                                    </tr>


                                                    <!-- Delivery Rating -->
                                                    <tr>

                                                        <td>

                                                            <i class="bi bi-truck me-2 text-primary"></i>
                                                            <strong>Delivery Rating</strong>

                                                        </td>

                                                        <td>

                                                            <div class="mb-3">

                                                                Based on the difference between
                                                                <strong>PO Due Date</strong>
                                                                and
                                                                <strong>DC Date</strong>.

                                                            </div>


                                                            <div class="row g-2">

                                                                <div class="col-md-6">

                                                                    <span class="badge bg-success w-100 py-2">
                                                                        0–2 Days : 100 Points
                                                                    </span>

                                                                </div>

                                                                <div class="col-md-6">

                                                                    <span class="badge bg-success w-100 py-2">
                                                                        3–6 Days : 90 Points
                                                                    </span>

                                                                </div>

                                                                <div class="col-md-6">

                                                                    <span class="badge bg-warning text-dark w-100 py-2">
                                                                        7–10 Days : 75 Points
                                                                    </span>

                                                                </div>

                                                                <div class="col-md-6">

                                                                    <span class="badge bg-warning text-dark w-100 py-2">
                                                                        11–14 Days : 50 Points
                                                                    </span>

                                                                </div>

                                                                <div class="col-md-6">

                                                                    <span class="badge bg-danger w-100 py-2">
                                                                        Above 14 Days : 0 Points
                                                                    </span>

                                                                </div>

                                                            </div>

                                                        </td>

                                                        <td class="text-center">

                                                            <span class="badge bg-success fs-6 px-3 py-2">
                                                                100
                                                            </span>

                                                        </td>

                                                    </tr>


                                                    <!-- Quality Rating -->
                                                    <tr>

                                                        <td>

                                                            <i class="bi bi-box-seam me-2 text-primary"></i>
                                                            <strong>Quality Rating</strong>

                                                        </td>

                                                        <td>

                                                            <div>

                                                                Quality performance is evaluated
                                                                based on the
                                                                <strong>Received Quantity</strong>,
                                                                <strong>Rejected Quantity</strong>
                                                                and
                                                                <strong>Reworked Quantity</strong>.

                                                            </div>


                                                            <div class="alert alert-light border mt-3 mb-0">

                                                                <div class="text-center">

                                                                    <strong class="text-primary">
                                                                        Quality Rating
                                                                    </strong>

                                                                    <div class="fs-6 mt-2">

                                                                        (Received Qty − Reject Qty − Rework Qty)
                                                                        ÷ Received Qty × 100

                                                                    </div>

                                                                </div>

                                                            </div>

                                                        </td>

                                                        <td class="text-center">

