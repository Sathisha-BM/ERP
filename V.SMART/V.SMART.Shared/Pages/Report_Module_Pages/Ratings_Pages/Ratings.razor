                                </div>

                                <button class="btn btn-light btn-sm"
                                        @onclick="ToggleDelayGraph">

                                    <i class="bi bi-x-lg me-1"></i>
                                    Close

                                </button>

                            </div>

                            <div class="card-body">

                                @if (DelayData.Any())
                                {
                                    <ApexChart TItem="DelayDaysSummary"
                                               Title="Delay Days vs Invoice Count"
                                               Height="400">

                                        <ApexPointSeries TItem="DelayDaysSummary"
                                                         Items="DelayData"
                                                         Name="Invoice Count"
                                                         SeriesType="SeriesType.Bar"
                                                         XValue="x => x.Label"
                                                         YValue="x => x.InvoiceCount" />

                                    </ApexChart>
                                }
                                else
                                {
                                    <div class="text-center text-muted p-4">
                                        No delay days data available.
                                    </div>
                                }

                            </div>

                        </div>
                    }


                    @if (ShowFPY)
                    {
                        <div class="table-responsive table-scroll">

                            <table class="table table-bordered table-striped table-hover mb-0 py-2">

                                <thead class="table-success">

                                    <tr>
                                        <th>Party</th>
                                        <th>Item code</th>
                                        <th>Item Name</th>
                                        <th class="text-end">Production Qty</th>
                                        <th class="text-end">Reject Qty</th>
                                        <th class="text-end">Rework Qty</th>
                                        <th class="text-end">FPY Qty</th>
                                        <th class="text-end">FPY %</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in FilteredFPYReport)
                                    {
                                        <tr>

                                            <td>@item.PartyName</td>

                                            <td>@item.Itemcode</td>

                                            <td>@item.ItemName</td>

                                            <td class="text-end">
                                                @item.ProductionQty
                                            </td>

                                            <td class="text-end">
                                                @item.RejectionQty
                                            </td>

                                            <td class="text-end">
                                                @item.ReworkQty
                                            </td>

                                            <td class="text-end fw-bold text-success">
                                                @item.FPYQty
                                            </td>

                                            <td class="text-end fw-bold">
                                                @item.FPYPercentage.ToString("0.00") %
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                        <div class="row mt-4">

                            <div class="col-md-4">
                                <div class="card border-primary shadow">
                                    <div class="card-body text-center">
                                        <h6>Production Qty</h6>
                                        <h3 class="text-primary">
                                            @FilteredFPYReport.Sum(x => x.ProductionQty)
                                        </h3>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="card border-danger shadow">
                                    <div class="card-body text-center">
                                        <h6>Reject Qty</h6>
                                        <h3 class="text-danger">
                                            @FilteredFPYReport.Sum(x => x.RejectionQty)
                                        </h3>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="card border-warning shadow">
                                    <div class="card-body text-center">
                                        <h6>Rework Qty</h6>
                                        <h3 class="text-warning">
                                            @FilteredFPYReport.Sum(x => x.ReworkQty)
                                        </h3>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="card border-success shadow">
                                    <div class="card-body text-center">
                                        <h6>FPY Qty</h6>
                                        <h3 class="text-success">
                                            @FilteredFPYReport.Sum(x => x.FPYQty)
                                        </h3>
                                    </div>
                                </div>
                            </div>


                            <div class="col-md-2">
                                <div class="card border-info shadow">
                                    <div class="card-body text-center">
                                        <h6>FPY %</h6>
                                        <h3 class="text-info">
                                            @{
                                                var totalProduction = FilteredFPYReport.Sum(x => x.ProductionQty);
                                                var totalFPYQty = FilteredFPYReport.Sum(x => x.FPYQty);

                                                var overallFPY = totalProduction > 0
                                                ? Math.Round((totalFPYQty / totalProduction) * 100, 2)
                                                : 0;
                                            }

                                            @overallFPY.ToString("0.00")%
                                        </h3>
                                    </div>
                                </div>
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
        else
        {
            <div class="alert alert-warning mt-3">
                No data available.
            </div>
        }



    </div>
}



