    private async Task GetFPYReport()
    {
        ShowRatings = false;
        ShowFPY = true;

        FPYReport.Clear();

        int partyId = string.IsNullOrWhiteSpace(SelectedParty)
            ? 0
            : Convert.ToInt32(SelectedParty);

        int itemId = string.IsNullOrWhiteSpace(SelectedItem)
            ? 0
            : Convert.ToInt32(SelectedItem);

        var fromDate = FromDate.Value.Date;
        var toDate = ToDate.Value.Date.AddDays(1).AddTicks(-1);

        switch (SelectedType)
        {
            case "Sales":

                var sales = await _unitOfWork.MfgDcSubs
                    .GetQueryable()
                    .Where(x =>
                        (partyId == 0 || x.MfgDc.CustId == partyId) &&
                        (itemId == 0 || x.ItemId == itemId) &&
                        x.MfgDc.DcDate >= fromDate &&
                        x.MfgDc.DcDate <= toDate)
                    .GroupBy(x => new
                    {
                        x.ItemId,
                        x.Item.ItemCode,
                        x.Item.ItemName
                    })
                    .Select(g => new
                    {
                        g.Key.ItemId,
                        g.Key.ItemCode,
                        g.Key.ItemName,
                        ProductionQty = g.Sum(x => x.Qty),
                        RejectQty = g.Sum(x => x.RejectQty),
                        ReworkQty = g.Sum(x => x.ReworkQty)
                    })
                    .ToListAsync();

                foreach (var x in sales)
                {
                    AddFPYRow(partyId, x.ItemCode, x.ItemName, x.ProductionQty, x.RejectQty, x.ReworkQty);
                }

                break;

            case "Purchase":

                var purchase = await _unitOfWork.PurchaseGRNSubs
                    .GetQueryable()
                    .Where(x =>
                        (partyId == 0 || x.PurchaseGRN.VendorCode == partyId) &&
                        (itemId == 0 || x.ItemId == itemId) &&
                        x.PurchaseGRN.GRNDate >= fromDate &&
                        x.PurchaseGRN.GRNDate <= toDate)
                    .GroupBy(x => new
                    {
                        x.ItemId,
                        x.Item.ItemCode,
                        x.Item.ItemName
                    })
                    .Select(g => new
                    {
                        g.Key.ItemId,
                        g.Key.ItemCode,
                        g.Key.ItemName,
                        ProductionQty = g.Sum(x => x.Qty)
                    })
                    .ToListAsync();

                foreach (var p in purchase)
                {
                    decimal reject = await _unitOfWork.PurchaseSCNSubs
                        .GetQueryable()
                        .Where(x =>
                            (partyId == 0 || x.PurchaseSCN.VendorCode == partyId) &&
                            x.ItemId == p.ItemId &&
                            x.PurchaseSCN.SCNDate >= fromDate &&
                            x.PurchaseSCN.SCNDate <= toDate)
                        .SumAsync(x => (decimal?)x.RejectQty) ?? 0;

                    decimal rework = await _unitOfWork.PurchaseSCNSubs
                        .GetQueryable()
                        .Where(x =>
                            (partyId == 0 || x.PurchaseSCN.VendorCode == partyId) &&
                            x.ItemId == p.ItemId &&
                            x.PurchaseSCN.SCNDate >= fromDate &&
                            x.PurchaseSCN.SCNDate <= toDate)
                        .SumAsync(x => (decimal?)x.ReworkQty) ?? 0;

                    AddFPYRow(partyId, p.ItemCode, p.ItemCode, p.ProductionQty, reject, rework);
                }

                break;

            case "Subcontract":

                var subcontract = await _unitOfWork.SubConGRNSubs
                    .GetQueryable()
                    .Where(x =>
                       (partyId == 0 || x.SubConGRNs.VendorCode == partyId) &&
                        (itemId == 0 || x.ItemId == itemId) &&
                        x.SubConGRNs.GRNDate >= fromDate &&
                        x.SubConGRNs.GRNDate <= toDate)
                    .GroupBy(x => new
                    {
                        x.ItemId,
                        x.Item.ItemCode,
                        x.Item.ItemName
                    })
                    .Select(g => new
                    {
                        g.Key.ItemId,
                        g.Key.ItemCode,
                        g.Key.ItemName,
                        ProductionQty = g.Sum(x => x.Qty)
                    })
                    .ToListAsync();

                foreach (var s in subcontract)
                {
                    decimal reject = await _unitOfWork.SubConSCNSubs
                        .GetQueryable()
                        .Where(x =>
                            (partyId == 0 || x.SubConSCN.VendorCode == partyId) &&
                            x.ItemId == s.ItemId &&
                            x.SubConSCN.SCNDate >= fromDate &&
                            x.SubConSCN.SCNDate <= toDate)
                        .SumAsync(x => (decimal?)x.RejQty) ?? 0;

                    decimal rework = await _unitOfWork.SubConSCNSubs
                        .GetQueryable()
                        .Where(x =>
                            (partyId == 0 || x.SubConSCN.VendorCode == partyId) &&
                            x.ItemId == s.ItemId &&
                            x.SubConSCN.SCNDate >= fromDate &&
                            x.SubConSCN.SCNDate <= toDate)
                        .SumAsync(x => (decimal?)x.RewQty) ?? 0;

                    AddFPYRow(partyId, s.ItemCode, s.ItemName, s.ProductionQty ?? 0, reject, rework);
                }

                break;

            case "Labour":

                var labour = await _unitOfWork.LabourGRNSubs
                    .GetQueryable()
                    .Where(x =>
                        (partyId == 0 || x.LabourGRN.CustId == partyId) &&
                        (itemId == 0 || x.ItemId == itemId) &&
                        x.LabourGRN.GRNDate >= fromDate &&
                        x.LabourGRN.GRNDate <= toDate)
                    .GroupBy(x => new
                    {
                        x.ItemId,
                        x.Item.ItemCode,
                        x.Item.ItemName
                    })
                    .Select(g => new
                    {
                        g.Key.ItemId,
                        g.Key.ItemCode,
                        g.Key.ItemName,
                        ProductionQty = g.Sum(x => x.Qty)
                    })
                    .ToListAsync();

                foreach (var l in labour)
                {
                    decimal reject = await _unitOfWork.LabourSCNSubs
                        .GetQueryable()
                        .Where(x =>
                            (partyId == 0 || x.LabourSCN.CustId == partyId) &&
                            x.ItemId == l.ItemId &&
                            x.LabourSCN.SCNDate >= fromDate &&
                            x.LabourSCN.SCNDate <= toDate)
                        .SumAsync(x => (decimal?)x.RejectQty) ?? 0;

                    decimal rework = await _unitOfWork.LabourSCNSubs
                        .GetQueryable()
                        .Where(x =>
                            (partyId == 0 || x.LabourSCN.CustId == partyId) &&
                            x.ItemId == l.ItemId &&
                            x.LabourSCN.SCNDate >= fromDate &&
                            x.LabourSCN.SCNDate <= toDate)
                        .SumAsync(x => (decimal?)x.ReworkQty) ?? 0;

                    AddFPYRow(partyId, l.ItemCode, l.ItemName, l.ProductionQty, reject, rework);
                }

                break;
        }

        StateHasChanged();
    }

    private void AddFPYRow(
      int partyId,
      string itemCode,
      string itemName,
      decimal productionQty,
      decimal rejectionQty,
      decimal reworkQty)
    {
        decimal fpyQty = productionQty - rejectionQty - reworkQty;

        decimal fpyPercentage = productionQty > 0
            ? Math.Round((fpyQty / productionQty) * 100, 2)
            : 0;

        FPYReport.Add(new FPYVM
        {
            PartyName = partyId == 0
                ? "All Parties"
                : Parties.FirstOrDefault(x => x.Id == partyId)?.Name,

            Itemcode = itemCode,
            ItemName = itemName,
            ProductionQty = productionQty,
            RejectionQty = rejectionQty,
            ReworkQty = reworkQty,
            FPYQty = fpyQty,
            FPYPercentage = fpyPercentage
        });
        decimal totalProduction = FPYReport.Sum(x => x.ProductionQty);
        decimal totalReject = FPYReport.Sum(x => x.RejectionQty);
        decimal totalRework = FPYReport.Sum(x => x.ReworkQty);

        decimal totalFPYQty = totalProduction - totalReject - totalRework;

        OverallFPYPercentage = totalProduction > 0
            ? Math.Round((totalFPYQty / totalProduction) * 100, 2)
            : 0;
    }

   



