    private void CardClick(CustomScreenSettingVM item)
    {
        if (item.ScreenId > 0)
        {
            Nav.NavigateTo(item.Navigation);
            return;
        }

        if (item.Children.Any())
        {
            CurrentCards = item.Children;
        }
    }

    private async Task LoadLogoAsync()
    {
        try
        {
            LogoImageSource = string.Empty;

            _companyLogoPath = await _companyService.GetCompanyLogoPathAsync();
            // DESKTOP
            if (string.IsNullOrWhiteSpace(_companyLogoPath))
                return;

            if (!File.Exists(_companyLogoPath))
            {
                Console.WriteLine($"Logo file not found: {_companyLogoPath}");
                return;
            }

            var bytes = await File.ReadAllBytesAsync(_companyLogoPath);

            var extension = Path.GetExtension(_companyLogoPath)
                .ToLowerInvariant();

            var contentType = extension switch
            {
                ".png" => "image/png",
                ".jpg" => "image/jpeg",
                ".jpeg" => "image/jpeg",
                ".gif" => "image/gif",
                ".webp" => "image/webp",
                _ => "image/png"
            };

            LogoImageSource =$"data:{contentType};base64,{Convert.ToBase64String(bytes)}";

            Console.WriteLine($"Logo loaded successfully. Bytes: {bytes.Length}");
        }
        catch (Exception ex)
        {
            LogoImageSource = string.Empty;

            Console.WriteLine($"LOGO ERROR: {ex}");

        }
    }
