                                        <div class="bar-track">
                                            <div class="bar-fill @GetThemeClass()" style="width:@($"{displayPercent:0.##}%")">
                                                <span class="bar-value">@machine.Quantity</span>
                                            </div>
                                        </div>
                                        <div class="trend-value"><i class="fas fa-chart-line"></i> @machine.Quantity</div>
                                    </div>
                                }
