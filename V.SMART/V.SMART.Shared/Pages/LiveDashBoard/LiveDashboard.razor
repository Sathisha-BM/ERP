                            <div class="kpi-value">@dashboard.CompletedRouteCards</div>
                        </div>
                        <div class="kpi">
                            <i class="fas fa-hourglass-half kpi-icon"></i>
                            <div class="kpi-label">Pending Production</div>
                            <div class="kpi-value">@dashboard.PendingProduction</div>
                        </div>
                        <div class="kpi">
                            <i class="fas fa-rotate kpi-icon"></i>
