                    </div>

                    <!-- CHARTS -->
                    <div class="overview-grid">
                        <!-- Operator -->
                        <div class="panel">
                            <div class="panel-head">
                                <div class="panel-title"><i class="fas fa-users"></i> Production by Operator</div>
                                <span class="panel-badge">@GetThemeName()</span>
                            </div>
                            @if (dashboard.OperatorProductionToday != null && dashboard.OperatorProductionToday.Any())
                            {
                                var maxOp = dashboard.OperatorProductionToday.Max(x => x.Quantity);
                                <div class="bar-chart">
                                    @foreach (var op in dashboard.OperatorProductionToday)
                                    {
                                        var percent = maxOp > 0 ? (double)op.Quantity * 100d / (double)maxOp : 0;
                                        var displayPercent = Math.Max(percent, 5);
                                        <div class="bar-row">
                                            <div class="bar-label" title="@op.OperatorName">@op.OperatorName</div>
                                            <div class="bar-track">
                                                <div class="bar-fill @GetThemeClass()" style="width:@($"{displayPercent:0.##}%")">
                                                    <span class="bar-value">@op.Quantity</span>
                                                </div>
                                            </div>
                                            <div class="trend-value"><i class="fas fa-arrow-trend-up"></i> LIVE</div>
                                        </div>
                                    }
                                </div>
