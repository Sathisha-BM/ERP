                        @if (dashboard.MachineProductionToday != null && dashboard.MachineProductionToday.Any())
                        {
                            var maxMachine = dashboard.MachineProductionToday.Max(x => x.Quantity);
                            <div class="bar-chart">
                                @foreach (var machine in dashboard.MachineProductionToday)
                                {
                                    var percent = maxMachine > 0 ? (double)machine.Quantity * 100d / (double)maxMachine : 0;
