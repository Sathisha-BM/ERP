                        {
                            <div class="empty"><div><i class="fas fa-gears"></i>No machine production available</div></div>
                        }
                    </div>
                </section>
            }

            <!-- SLIDE 4 – LIVE ROUTE CARDS -->
            @if (currentSlide == 3)
            {
                <section class="dashboard-slide">
                    <div class="slide-heading">
                        <div class="slide-title">
                            <i class="fas fa-list-check"></i> LIVE ROUTECARD PRODUCTION
                            <span class="slide-caption">DAILY PRODUCTION LOG</span>
                        </div>
                        <div class="route-count">@(dashboard.TodayRouteCards?.Count ?? 0) ROUTE CARDS</div>
                    </div>
                    <div class="panel route-panel">
                        <div class="route-head">
                            <div class="route-title"><i class="fas fa-database"></i> LIVE ROUTECARD PRODUCTION DETAILS</div>
                            <div class="route-count">LIVE</div>
                        </div>
                        <div class="route-columns">
                            <div>ROUTE CARD</div>
                            <div>CUSTOMER</div>
                            <div>RC QTY</div>
                            <div>STATUS</div>
                            <div style="text-align:right;">TIME</div>
                        </div>
                        @if (dashboard.TodayRouteCards != null && dashboard.TodayRouteCards.Any())
                        {
                            <div class="route-list">
                                @foreach (var card in dashboard.TodayRouteCards.Take(30))
                                {
                                    var normalized = (card.Status ?? "").Trim().ToLowerInvariant();
                                    var statusClass = normalized == "completed" ? "completed" :
                                                      normalized == "pending" ? "pending" :
                                                      normalized.Contains("rework") || normalized.Contains("reject") ? "rework" :
                                                      "default-status";
                                    <div class="route-row">
                                        <div class="route-document" title="@card.DocumentNo">
                                            <i class="fas fa-file-lines"></i>@card.DocumentNo
                                        </div>
                                        <div class="route-customer" title="@card.CustomerName">
                                            <i class="fas fa-building"></i>@card.CustomerName
                                        </div>
                                        <div class="route-qty">@card.RouteCardQty</div>
                                        <div><span class="status @statusClass">@card.Status</span></div>
                                        <div class="route-time">@card.CreatedTime.ToString("HH:mm:ss")</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty"><div><i class="fas fa-inbox"></i>No route cards generated today</div></div>
                        }
                    </div>
                </section>
            }

        </div>
    </main>

    <!-- FOOTER -->
    <footer class="dashboard-footer">
        <div class="footer-status">
            <span class="status-dot"></span>
            <span><i class="fas fa-database" style="margin-right:6px;"></i>LIVE PRODUCTION DATA</span>
        </div>
        <div class="refresh-badge">
            <i class="fas fa-sync-alt"></i> Data: 30 sec
            <span style="margin:0 6px;color:var(--text-muted);opacity:0.4;">|</span>
            Slide: 8 sec
        </div>
    </footer>
</div>
}

@code {
   
    protected override string ScreenName => "Production Live View";
    private ErpDashboardVM dashboard = new();
    private DateTime currentTime = DateTime.Now;
    private CancellationTokenSource? cancellationTokenSource;
   
    private bool isProcessing=true;
    private bool preferencesLoaded = false;
    private int currentSlide = 0;
    private const int TotalSlides = 4;

    private int globalTheme = 0;
    
    protected override 
    async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            cancellationTokenSource = new CancellationTokenSource();

            await LoadDashboardAsync();

            _ = StartDataRefreshAsync();
            _ = StartClockAsync();
            _ = StartSlideAsync();
        
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }

       
    }

    private async Task LoadDashboardAsync()
    {
        if (isProcessing) return;
        isProcessing = true;

        try
        {
            var result = await DashboardService.GetDashboardAsync();
            if (result != null) dashboard = result;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard error: {ex}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task StartDataRefreshAsync()
    {
        try
        {
            while (cancellationTokenSource != null && !cancellationTokenSource.Token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(30), cancellationTokenSource.Token);
                if (cancellationTokenSource.Token.IsCancellationRequested) break;
                await LoadDashboardAsync();
            }
        }
        catch (TaskCanceledException) { }
        catch (Exception ex) { Console.WriteLine($"Data refresh error: {ex}"); }
    }

   
    private async Task StartClockAsync()
    {
        try
        {
            while (cancellationTokenSource != null && !cancellationTokenSource.Token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationTokenSource.Token);
                currentTime = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
        catch (Exception ex) { Console.WriteLine($"Clock error: {ex}"); }
    }

    private async Task StartSlideAsync()
    {
        try
        {
            while (cancellationTokenSource != null && !cancellationTokenSource.Token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(8), cancellationTokenSource.Token);
                if (cancellationTokenSource.Token.IsCancellationRequested) break;

                currentSlide++;
                if (currentSlide >= TotalSlides) currentSlide = 0;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
        catch (Exception ex) { Console.WriteLine($"Slide error: {ex}"); }
    }

  
    private void SetTheme(int theme)
    {
        globalTheme = theme;
        StateHasChanged();
    }

    private string GetThemeName()
    {
        return globalTheme switch
        {
            1 => "PURPLE",
            2 => "CYAN",
            3 => "LIGHT",
            _ => "DARK"
        };
    }

    private string GetThemeClass()
    {
        return globalTheme switch
        {
            1 => "purple",
            2 => "cyan",
            3 => "light",
            _ => ""
        };
    }

   
    public void Dispose()
    {
        try
        {
            cancellationTokenSource?.Cancel();
            cancellationTokenSource?.Dispose();
            cancellationTokenSource = null;
        }
        catch { }
        GC.SuppressFinalize(this);
    }
}