    <!-- CONTENT -->
    <main class="dashboard-content">
        <div class="dashboard-slider">

            <!-- SLIDE 1 – OVERVIEW -->
            @if (currentSlide == 0)
            {
                <section class="dashboard-slide">
                    <div class="slide-heading">
                        <div class="slide-title">
                            <i class="fas fa-chart-line"></i>
                            ROUTECARD PRODUCTION – TODAY
                            <span class="slide-caption">LIVE PRODUCTION OVERVIEW</span>
                        </div>
                      
                    </div>

                    <!-- KPI -->
                    <div class="kpi-grid">
                        <div class="kpi">
                            <i class="fas fa-route kpi-icon"></i>
                            <div class="kpi-label">Route Cards Generated</div>
