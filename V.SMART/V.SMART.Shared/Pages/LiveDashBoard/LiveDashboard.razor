                            {
                                <div class="empty"><div><i class="fas fa-user-slash"></i>No operator production today</div></div>
                            }
                        </div>

                        <!-- Hourly -->
                        <div class="panel">
                            <div class="panel-head">
                                <div class="panel-title"><i class="fas fa-chart-column"></i> Hourly Production</div>
