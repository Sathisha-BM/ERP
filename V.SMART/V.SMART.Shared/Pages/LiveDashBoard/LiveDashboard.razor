                            <div class="bar-chart">
                                @foreach (var op in dashboard.OperatorProductionToday)
                                {
                                    var percent = maxOperator > 0 ? (double)op.Quantity * 100d / (double)maxOperator : 0;
                                    var displayPercent = Math.Max(percent, 4);
                                    <div class="bar-row" style="grid-template-columns:180px minmax(0,1fr) 80px;">
                                        <div class="bar-label" title="@op.OperatorName">
                                            <i class="fas fa-user" style="color:var(--glow-color);margin-right:6px;"></i>@op.OperatorName
