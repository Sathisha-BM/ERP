}
else
{
<div class="live-dashboard" data-theme="@GetThemeClass()">
    <!-- HEADER -->
    <header class="dashboard-header">
        <div class="brand-group">
            <div class="brand-icon"><i class="fas fa-industry"></i></div>
            <div>
                    <div class="dashboard-title">PRODUCTION MONITOR</div>
                <div class="dashboard-subtitle">LIVE ROUTECARD & PRODUCTION MONITOR</div>
            </div>
        </div>
        <div class="header-controls">
            <!-- slide indicators -->
            <div class="slide-indicators">
                @for (var i = 0; i < TotalSlides; i++)
                {
                    <span class="slide-dot @(currentSlide == i ? "active" : "")"></span>
                }
            </div>
              
            <!-- 🔥 GLOBAL THEME SWITCHER – visible on every slide -->
            <div class="theme-switch">
                <button class="theme-btn @(globalTheme == 0 ? "active" : "")" @onclick="() => SetTheme(0)">DARK</button>
                <button class="theme-btn @(globalTheme == 1 ? "active" : "")" @onclick="() => SetTheme(1)">PURPLE</button>
                <button class="theme-btn @(globalTheme == 2 ? "active" : "")" @onclick="() => SetTheme(2)">CYAN</button>
