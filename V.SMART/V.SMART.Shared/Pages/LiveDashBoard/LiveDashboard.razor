                                    <div class="bar-row" style="grid-template-columns:180px minmax(0,1fr) 80px;">
                                        <div class="bar-label" title="@machine.MachineName">
                                            <i class="fas fa-cog" style="color:var(--glow-color);margin-right:6px;"></i>@machine.MachineName
