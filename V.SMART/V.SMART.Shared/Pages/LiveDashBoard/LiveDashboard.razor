                        }
                    </div>
                </section>
            }

            <!-- SLIDE 3 – MACHINE -->
            @if (currentSlide == 2)
            {
                <section class="dashboard-slide">
                    <div class="slide-heading">
                        <div class="slide-title">
                            <i class="fas fa-gears"></i> MACHINE-WISE PRODUCTION
                            <span class="slide-caption">LIVE SHOP FLOOR MONITOR</span>
                        </div>
                        <div class="panel-badge">LIVE MACHINE MONITOR</div>
                    </div>
                    <div class="panel full-panel">
