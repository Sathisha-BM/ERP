@page "/live-dashboard"

@using V.SMART.Shared.Services
@using V.SMART.Shared.ViewModels.LiveDashBoardVM
@inherits BaseUserRightsComponent
@inject ErpDashboardService DashboardService
@inject ILoggingService LoggingService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

@implements IDisposable

<PageTitle>V.SMART Live Production Dashboard</PageTitle>

<style>
 
    :root {
        /* Application shell dimensions */
        --app-sidebar-width: 54px;
        --app-header-height: 44px;

        /* ----- DARK (default) theme – deep navy with cool accents ----- */
        --bg-primary: #070b1a;
        --bg-gradient: radial-gradient(circle at 10% 10%, rgba(0,180,255,.12), transparent 40%),
                       radial-gradient(circle at 90% 30%, rgba(100,80,255,.08), transparent 35%),
                       radial-gradient(circle at 50% 90%, rgba(0,255,200,.05), transparent 30%),
                       linear-gradient(145deg, #0b1225 0%, #0d1a2d 50%, #0a1020 100%);
        --text-primary: #f0f8ff;
        --text-secondary: #8aa9c9;
        --text-muted: #5f7b96;
        --panel-bg: rgba(10, 20, 40, .85);
        --panel-border: rgba(100, 180, 255, .12);
        --header-bg: rgba(8, 15, 30, .92);
        --glow-color: #4fc3f7;
        --glow-rgb: 79, 195, 247;
        --card-accent: linear-gradient(135deg, #00b4d8, #4361ee, #7b2ffc);
        --bar-gradient: linear-gradient(90deg, #0288d1, #00b4d8 45%, #4fc3f7);
        --bar-shadow: 0 0 20px rgba(79, 195, 247, .25);
        --card-shadow: 0 12px 40px rgba(0,0,0,.45);
        --border-radius: 16px;
        --transition-speed: 0.3s;
    }

    /* ----- PURPLE theme – cosmic & rich ----- */
    [data-theme="purple"] {
        --bg-primary: #0b071a;
        --bg-gradient: radial-gradient(circle at 10% 10%, rgba(150,100,255,.12), transparent 40%),
                       radial-gradient(circle at 90% 30%, rgba(220,80,255,.08), transparent 35%),
                       radial-gradient(circle at 50% 90%, rgba(100,200,255,.05), transparent 30%),
                       linear-gradient(145deg, #120d24 0%, #1b1236 50%, #0f0a1e 100%);
        --text-primary: #f3efff;
        --text-secondary: #b09ad6;
        --text-muted: #7a64a2;
        --panel-bg: rgba(25, 15, 45, .85);
        --panel-border: rgba(180, 140, 255, .12);
        --header-bg: rgba(15, 8, 30, .92);
        --glow-color: #b388ff;
        --glow-rgb: 179, 136, 255;
        --card-accent: linear-gradient(135deg, #7c3aed, #b388ff, #d946ef);
        --bar-gradient: linear-gradient(90deg, #7c3aed, #a78bfa 45%, #d946ef);
        --bar-shadow: 0 0 20px rgba(179, 136, 255, .25);
        --card-shadow: 0 12px 40px rgba(0,0,0,.5);
    }

    /* ----- CYAN theme – fresh & techy ----- */
    [data-theme="cyan"] {
        --bg-primary: #041013;
        --bg-gradient: radial-gradient(circle at 10% 10%, rgba(0,200,200,.12), transparent 40%),
                       radial-gradient(circle at 90% 30%, rgba(20,180,200,.08), transparent 35%),
                       radial-gradient(circle at 50% 90%, rgba(0,255,180,.06), transparent 30%),
                       linear-gradient(145deg, #041a20 0%, #06242b 50%, #031014 100%);
        --text-primary: #e6fffe;
        --text-secondary: #6eb4b0;
        --text-muted: #4a8a86;
        --panel-bg: rgba(6, 30, 35, .85);
        --panel-border: rgba(60, 210, 200, .12);
        --header-bg: rgba(4, 18, 22, .92);
        --glow-color: #4dd0e1;
        --glow-rgb: 77, 208, 225;
        --card-accent: linear-gradient(135deg, #00897b, #26c6da, #00e5ff);
        --bar-gradient: linear-gradient(90deg, #00897b, #26c6da 45%, #4dd0e1);
        --bar-shadow: 0 0 20px rgba(77, 208, 225, .25);
        --card-shadow: 0 12px 40px rgba(0,0,0,.45);
    }

    /* ----- LIGHT theme – clean, bright, professional ----- */
    [data-theme="light"] {
        --bg-primary: #f5f9ff;
        --bg-gradient: radial-gradient(circle at 10% 10%, rgba(0,120,255,.04), transparent 40%), radial-gradient(circle at 90% 30%, rgba(100,80,255,.03), transparent 35%), radial-gradient(circle at 50% 90%, rgba(0,200,180,.03), transparent 30%), linear-gradient(145deg, #eef3fa 0%, #e2eaf5 50%, #f0f5fd 100%);
        --text-primary: #1e2a3a;
        --text-secondary: #4a5f7a;
        --text-muted: #7a8fa5;
        --panel-bg: rgba(255, 255, 255, .82);
        --panel-border: rgba(60, 100, 160, .15);
        --header-bg: rgba(240, 246, 255, .90);
        --glow-color: #3b82f6;
        --glow-rgb: 59, 130, 246;
        --card-accent: linear-gradient(135deg, #3b82f6, #6366f1, #8b5cf6);
        --bar-gradient: linear-gradient(90deg, #3b82f6, #60a5fa 45%, #818cf8);
        --bar-shadow: 0 0 20px rgba(59, 130, 246, .15);
        --card-shadow: 0 8px 30px rgba(0,0,0,.08);
        --border-radius: 16px;
    }

    /* =====================================================
           GLOBAL RESET & BASE
           ===================================================== */

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: var(--bg-primary);
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        transition: background 0.6s ease;
    }

    body {
        overflow: hidden !important;
    }

    /* =====================================================
           MAIN DASHBOARD CONTAINER
           ===================================================== */

    .live-dashboard {
        position: fixed;
        top: var(--app-header-height);
        left: var(--app-sidebar-width);
        right: 0;
        bottom: 0;
        width: auto;
        height: auto;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        color: var(--text-primary);
        background: var(--bg-gradient);
        transition: background 0.6s ease, color 0.6s ease;
        backdrop-filter: blur(2px);
    }

    .live-dashboard::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(rgba(255,255,255,.015) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,.015) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse at 50% 80%, black 20%, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse at 50% 80%, black 20%, transparent 80%);
    }

    /* =====================================================
           HEADER – sleek glassmorphism
           ===================================================== */

    .dashboard-header {
        position: relative;
        z-index: 20;
        height: 64px;
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        background: var(--header-bg);
        backdrop-filter: blur(20px) saturate(1.2);
        border-bottom: 1px solid var(--panel-border);
        box-shadow: 0 8px 32px rgba(0,0,0,.2);
        transition: all 0.4s ease;
    }

    .brand-group {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .brand-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        color: var(--glow-color);
        background: rgba(var(--glow-rgb), .12);
        border: 1px solid rgba(var(--glow-rgb), .25);
        box-shadow: 0 0 30px rgba(var(--glow-rgb), .08);
        font-size: 20px;
    }

    .dashboard-title {
        margin: 0;
        font-size: clamp(18px, 1.6vw, 26px);
        font-weight: 800;
        letter-spacing: -.02em;
        white-space: nowrap;
        background: linear-gradient(135deg, var(--text-primary) 20%, var(--glow-color) 80%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .dashboard-subtitle {
        margin-top: 2px;
        color: var(--text-secondary);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: .15em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .header-controls {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .live-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 40px;
        color: #86efac;
        background: rgba(16,185,129,.08);
        border: 1px solid rgba(16,185,129,.18);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .08em;
        backdrop-filter: blur(4px);
    }

    .live-dot,
    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #34d399;
        box-shadow: 0 0 8px #34d399, 0 0 20px rgba(52,211,153,.5);
        animation: livePulse 1.4s infinite;
    }

    .dashboard-clock {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 40px;
        color: var(--text-secondary);
        background: rgba(var(--glow-rgb), .06);
        border: 1px solid var(--panel-border);
        font-size: 11px;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        backdrop-filter: blur(4px);
    }

    .dashboard-clock i {
        color: var(--glow-color);
        font-size: 13px;
    }

    /* =====================================================
           CONTENT AREA
           ===================================================== */

    .dashboard-content {
        position: relative;
        z-index: 5;
        width: 100%;
        height: calc(100% - 96px);
        min-width: 0;
        min-height: 0;
        padding: 14px 20px 10px;
        overflow: hidden;
    }

    .dashboard-slider {
        position: relative;
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .dashboard-slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
        overflow: hidden;
        animation: slideIn 0.6s cubic-bezier(.22, .61, .36, 1);
    }

    /* =====================================================
           SLIDE HEADING
           ===================================================== */

    .slide-heading {
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-width: 0;
    }

    .slide-title {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        font-size: clamp(15px, 1.2vw, 20px);
        font-weight: 800;
        letter-spacing: -.01em;
        white-space: nowrap;
        color: var(--text-primary);
    }

    .slide-title i {
        color: var(--glow-color);
        filter: drop-shadow(0 0 12px rgba(var(--glow-rgb), .4));
    }

    .slide-caption {
        color: var(--text-secondary);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: .08em;
        white-space: nowrap;
        opacity: 0.8;
    }

    .slide-indicators {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .slide-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(var(--glow-rgb), .2);
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .slide-dot.active {
        width: 28px;
        border-radius: 12px;
        background: var(--glow-color);
        box-shadow: 0 0 12px rgba(var(--glow-rgb), .5);
    }

    /* =====================================================
           THEME SWITCH – modern pill buttons
           ===================================================== */

    .theme-switch {
        display: flex;
        gap: 4px;
        padding: 4px;
        border-radius: 40px;
        background: rgba(var(--glow-rgb), .06);
        border: 1px solid var(--panel-border);
        backdrop-filter: blur(4px);
    }

    .theme-btn {
        border: none;
        border-radius: 30px;
        padding: 5px 14px;
        color: var(--text-secondary);
        background: transparent;
        cursor: pointer;
        font-size: 9px;
        font-weight: 700;
        transition: all 0.25s ease;
        letter-spacing: .04em;
    }

    .theme-btn:hover {
        color: var(--text-primary);
        background: rgba(var(--glow-rgb), .05);
    }

    .theme-btn.active {
        color: var(--text-primary);
        background: rgba(var(--glow-rgb), .12);
        box-shadow: 0 0 16px rgba(var(--glow-rgb), .08);
    }

    /* =====================================================
           KPI CARDS – glass with subtle hover lift
           ===================================================== */

    .kpi-grid {
        flex: 0 0 88px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 12px;
        min-width: 0;
    }

    .kpi {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
        padding: 12px 20px;
        border-radius: var(--border-radius);
        background: var(--panel-bg);
        border: 1px solid var(--panel-border);
        box-shadow: var(--card-shadow);
        backdrop-filter: blur(6px);
        transition: all var(--transition-speed) ease;
        cursor: default;
    }

    .kpi:hover {
        transform: translateY(-3px);
        border-color: rgba(var(--glow-rgb), .3);
        box-shadow: 0 16px 48px rgba(0,0,0,.3);
    }

    .kpi::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--card-accent);
        border-radius: var(--border-radius) var(--border-radius) 0 0;
    }

    .kpi-icon {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 28px;
        color: var(--glow-color);
        opacity: 0.1;
        transition: opacity 0.3s ease;
    }

    .kpi:hover .kpi-icon {
        opacity: 0.2;
    }

    .kpi-label {
        color: var(--text-secondary);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .kpi-value {
        margin-top: 6px;
        font-size: clamp(26px, 2.2vw, 36px);
        line-height: 1;
        font-weight: 900;
        font-variant-numeric: tabular-nums;
        background: linear-gradient(135deg, var(--text-primary), var(--glow-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* =====================================================
           PANELS – elegant glass cards
           ===================================================== */

    .panel {
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border-radius: var(--border-radius);
        background: var(--panel-bg);
        border: 1px solid var(--panel-border);
        box-shadow: var(--card-shadow);
        backdrop-filter: blur(6px);
        transition: all var(--transition-speed) ease;
    }

    .panel:hover {
        border-color: rgba(var(--glow-rgb), .2);
        box-shadow: 0 16px 48px rgba(0,0,0,.25);
    }

    .panel-head {
        flex: 0 0 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 18px;
        border-bottom: 1px solid var(--panel-border);
        background: rgba(var(--glow-rgb), .03);
        backdrop-filter: blur(4px);
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-primary);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .02em;
        white-space: nowrap;
    }

    .panel-title i {
        color: var(--glow-color);
        font-size: 14px;
    }

    .panel-badge {
        padding: 4px 12px;
        border-radius: 40px;
        color: var(--glow-color);
        background: rgba(var(--glow-rgb), .08);
        border: 1px solid rgba(var(--glow-rgb), .15);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        backdrop-filter: blur(4px);
    }

    /* =====================================================
           BAR CHARTS – smooth, glowing bars
           ===================================================== */

    .bar-chart {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
        padding: 14px 18px;
    }

    .bar-chart::-webkit-scrollbar,
    .route-list::-webkit-scrollbar {
        width: 4px;
    }

    .bar-chart::-webkit-scrollbar-thumb,
    .route-list::-webkit-scrollbar-thumb {
        background: rgba(var(--glow-rgb), .25);
        border-radius: 10px;
    }

    .bar-row {
        display: grid;
        grid-template-columns: 140px minmax(0,1fr) 60px;
        align-items: center;
        gap: 14px;
        min-width: 0;
        transition: all 0.2s ease;
    }

    .bar-row:hover .bar-label {
        color: var(--text-primary);
    }

    .bar-label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: right;
        color: var(--text-secondary);
        font-size: 10px;
        font-weight: 600;
        transition: color 0.2s ease;
    }

    .bar-track {
        position: relative;
        height: 28px;
        overflow: hidden;
        border-radius: 40px;
        background: rgba(var(--glow-rgb), .06);
        border: 1px solid var(--panel-border);
        box-shadow: inset 0 2px 6px rgba(0,0,0,.2);
        transition: border-color 0.3s ease;
    }

    .bar-track::before {
        content: "";
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(90deg, transparent 0, transparent 24px, rgba(255,255,255,.03) 25px, transparent 26px);
        pointer-events: none;
        z-index: 1;
    }

    .bar-fill {
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-right: 10px;
        border-radius: 40px;
        background: var(--bar-gradient);
        box-shadow: var(--bar-shadow);
        transition: width 0.9s cubic-bezier(.22, .61, .36, 1), background 0.5s ease, box-shadow 0.5s ease;
        z-index: 2;
    }

    .bar-fill::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: -55px;
        width: 55px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,.3), transparent);
        transform: skewX(-20deg);
        animation: marketScan 2.5s linear infinite;
        pointer-events: none;
    }

    .bar-fill::before {
        content: "";
        position: absolute;
        top: 50%;
        right: 4px;
        width: 6px;
        height: 60%;
        transform: translateY(-50%);
        border-radius: 50%;
        background: white;
        box-shadow: 0 0 8px white, 0 0 20px rgba(255,255,255,.6);
        animation: endPulse 1.2s ease-in-out infinite;
        z-index: 4;
    }

    .bar-fill.purple {
        background: linear-gradient(90deg, #7c3aed, #a78bfa 45%, #d946ef);
        box-shadow: 0 0 20px rgba(179, 136, 255, .35);
    }

    .bar-fill.cyan {
        background: linear-gradient(90deg, #00897b, #26c6da 45%, #4dd0e1);
        box-shadow: 0 0 20px rgba(77, 208, 225, .35);
    }

    .bar-value {
        position: relative;
        z-index: 10;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        height: 20px;
        padding: 0 8px;
        border-radius: 30px;
        color: white;
        background: rgba(0,0,0,.4);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,.15);
        box-shadow: 0 2px 8px rgba(0,0,0,.3);
        font-size: 10px;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .trend-value {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 4px;
        color: var(--glow-color);
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
        opacity: 0.9;
    }

    .trend-value i {
        font-size: 8px;
        animation: trendBounce 1.2s infinite;
    }

    /* =====================================================
           OVERVIEW GRID
           ===================================================== */

    .overview-grid {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0,1fr) minmax(0,1fr);
        gap: 12px;
    }

    /* =====================================================
           FULL PANEL (operator / machine)
           ===================================================== */

    .full-panel {
        flex: 1;
        min-height: 0;
    }

    /* =====================================================
           ROUTE CARDS – clean table-like layout
           ===================================================== */

    .route-panel {
        flex: 1;
        min-height: 0;
    }

    .route-head {
        flex: 0 0 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 18px;
        border-bottom: 1px solid var(--panel-border);
        background: rgba(var(--glow-rgb), .04);
    }

    .route-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-primary);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .02em;
    }

    .route-title i {
        color: var(--glow-color);
    }

    .route-count {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 14px;
        border-radius: 40px;
        color: var(--glow-color);
        background: rgba(var(--glow-rgb), .08);
        border: 1px solid rgba(var(--glow-rgb), .15);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .route-count::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #34d399;
        box-shadow: 0 0 10px #34d399;
        animation: livePulse 1.2s infinite;
    }

    .route-columns,
    .route-row {
        display: grid;
        grid-template-columns: minmax(120px,1fr) minmax(160px,1.3fr) minmax(70px,.7fr) 90px 80px;
        align-items: center;
        gap: 12px;
        padding: 0 18px;
        min-width: 0;
    }

    .route-columns {
        flex: 0 0 32px;
        color: var(--text-secondary);
        background: rgba(var(--glow-rgb), .03);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        border-bottom: 1px solid var(--panel-border);
    }

    .route-list {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 2px 0;
    }

    .route-row {
        position: relative;
        min-height: 44px;
        border-bottom: 1px solid var(--panel-border);
        transition: background 0.15s ease;
        cursor: default;
    }

    .route-row:hover {
        background: rgba(var(--glow-rgb), .04);
    }

    .route-row::before {
        content: "";
        position: absolute;
        left: 0;
        top: 8px;
        bottom: 8px;
        width: 3px;
        border-radius: 4px;
        background: var(--glow-color);
        box-shadow: 0 0 12px var(--glow-color);
        opacity: 0.6;
    }

    .route-document {
        color: var(--text-primary);
        font-weight: 700;
        font-size: 10px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .route-document i {
        color: var(--glow-color);
        margin-right: 6px;
    }

    .route-customer {
        color: var(--text-secondary);
        font-size: 10px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .route-customer i {
        color: var(--text-muted);
        margin-right: 6px;
    }

    .route-qty {
        color: var(--glow-color);
        font-size: 10px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .route-time {
        color: var(--text-secondary);
        text-align: right;
        font-size: 9px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    /* =====================================================
           STATUS BADGES – consistent and readable
           ===================================================== */

    .status {
        width: fit-content;
        min-width: 76px;
        padding: 4px 12px;
        border-radius: 40px;
        text-align: center;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .04em;
        white-space: nowrap;
        text-transform: uppercase;
        backdrop-filter: blur(4px);
    }

    .completed {
        color: #86efac;
        background: rgba(34,197,94,.10);
        border: 1px solid rgba(34,197,94,.20);
    }

    .pending {
        color: #fcd34d;
        background: rgba(245,158,11,.10);
        border: 1px solid rgba(245,158,11,.20);
        animation: pendingGlow 1.8s infinite;
    }

    .rework {
        color: #fca5a5;
        background: rgba(244,63,94,.10);
        border: 1px solid rgba(244,63,94,.20);
    }

    .default-status {
        color: var(--glow-color);
        background: rgba(var(--glow-rgb), .08);
        border: 1px solid rgba(var(--glow-rgb), .15);
    }

    /* =====================================================
           EMPTY STATE
           ===================================================== */

    .empty {
        height: 100%;
        display: grid;
        place-items: center;
        color: var(--text-secondary);
        font-size: 11px;
        font-weight: 500;
        opacity: 0.7;
    }

    .empty i {
        font-size: 32px;
        display: block;
        margin-bottom: 10px;
        color: var(--text-muted);
        opacity: 0.5;
    }

    /* =====================================================
           FOOTER – minimal & elegant
           ===================================================== */

    .dashboard-footer {
        position: relative;
        z-index: 5;
        height: 32px;
        min-height: 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        color: var(--text-muted);
        background: rgba(var(--glow-rgb), .02);
        border-top: 1px solid var(--panel-border);
        font-size: 9px;
        font-weight: 500;
        backdrop-filter: blur(4px);
        transition: all 0.3s ease;
    }

    .footer-status {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .footer-status .status-dot {
        width: 6px;
        height: 6px;
    }

    .refresh-badge {
        padding: 4px 14px;
        border-radius: 40px;
        background: rgba(var(--glow-rgb), .04);
        border: 1px solid var(--panel-border);
        backdrop-filter: blur(4px);
    }

    .refresh-badge i {
        margin-right: 6px;
        color: var(--glow-color);
        opacity: 0.7;
    }

    /* =====================================================
           ANIMATIONS
           ===================================================== */

    @@keyframes livePulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%      { opacity: .3; transform: scale(.7); }
    }

    @@keyframes marketScan {
        0%   { left: -60px; }
        100% { left: 110%; }
    }

    @@keyframes endPulse {
        0%, 100% { opacity: .7; transform: translateY(-50%) scale(.9); }
        50%      { opacity: 1; transform: translateY(-50%) scale(1.2); }
    }

    @@keyframes trendBounce {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(-3px); }
    }

    @@keyframes pendingGlow {
        0%, 100% { box-shadow: 0 0 6px rgba(245,158,11,.05); }
        50%      { box-shadow: 0 0 18px rgba(245,158,11,.15); }
    }

    @@keyframes slideIn {
        from { opacity: 0; transform: translateX(40px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    /* =====================================================
           RESPONSIVE ADJUSTMENTS
           ===================================================== */

    @@media (min-width:1600px) {
        .dashboard-content { padding: 18px 28px 12px; }
        .dashboard-slide { max-width: 1900px; margin: 0 auto; }
        .bar-row { grid-template-columns: 180px minmax(0,1fr) 80px; }
    }

    @@media (max-width:1000px) {
        .dashboard-header { padding: 0 16px; }
        .dashboard-content { padding: 10px 12px; }
        .slide-caption { display: none; }
        .route-columns,
        .route-row { grid-template-columns: 1fr 1.2fr .7fr 70px 65px; gap: 8px; padding: 0 12px; }
    }

    @@media (max-width:700px) {
        :root { --app-sidebar-width: 0px; }
        .live-dashboard { left: 0; right: 0; top: var(--app-header-height); bottom: 0; }
        .dashboard-header { height: 54px; min-height: 54px; padding: 0 12px; }
        .brand-icon { width: 34px; height: 34px; font-size: 16px; }
        .dashboard-title { font-size: 16px; }
        .dashboard-subtitle,
        .live-pill,
        .slide-indicators { display: none; }
        .dashboard-content { height: calc(100% - 86px); padding: 8px; }
        .kpi-grid { flex-basis: 64px; gap: 6px; }
        .kpi { padding: 8px 12px; }
        .kpi-label { font-size: 7px; }
        .kpi-value { font-size: 20px; }
        .overview-grid { grid-template-columns: 1fr; gap: 8px; }
        .bar-row { grid-template-columns: 70px minmax(0,1fr) 42px; gap: 6px; }
        .bar-track { height: 22px; }
        .bar-fill { min-width: 32px; padding-right: 6px; }
        .bar-value { font-size: 8px; height: 16px; min-width: 20px; padding: 0 4px; }
        .route-columns,
        .route-row { grid-template-columns: 1fr 1fr 55px 60px 55px; gap: 4px; padding: 0 8px; }
        .route-columns { font-size: 6px; }
        .route-document, .route-customer, .route-qty { font-size: 8px; }
        .status { min-width: 54px; padding: 2px 6px; font-size: 6px; }
        .route-time { font-size: 7px; }
        .panel-head, .route-head { flex: 0 0 38px; padding: 0 12px; }
        .dashboard-footer { padding: 0 12px; font-size: 7px; }
    }

    @@media (max-height:700px) {
        .dashboard-header { height: 52px; min-height: 52px; }
        .dashboard-content { height: calc(100% - 84px); padding: 6px; }
        .dashboard-slide { gap: 6px; }
        .slide-heading { flex-basis: 30px; }
        .kpi-grid { flex-basis: 60px; }
        .panel-head, .route-head { flex: 0 0 34px; }
        .bar-chart { gap: 4px; padding: 8px 12px; }
        .bar-track { height: 20px; }
        .route-row { min-height: 34px; }
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
