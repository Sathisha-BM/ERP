@page "/labourDcoutgoingList"

@using System.Text.Json
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.LabourDc_VM
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.LabourSCN_VM
@using static V.SMART.Shared.Components.DetailsModal

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ILabourDcOutgoingService _dcService
@inject NavigationStateService NavigationState
@inject ExcelExportService ExcelExportService
@inject IStockManagerService _stockManagerService



<style>
    .pagination-fixed {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1030; /* keeps above table */
    }

    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">

    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch isModelVisible="true"
                       Screen="@ScreenName"
                       Filters="SearchFilters"
                       OnClose="CloseModal"
                       OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="confirmDelete_Click"
         ButtonBootstrapStyle="@(confirmation != "Export" ? "btn-danger" : btnColor)"
         ButtonText="@(confirmation != "Export" ? "Delete" : btnText)"
         Title="@(confirmation != "Export"
                               ? "Are you sure you want to delete this Labour Dc Outgoing?"
                               : ModalTitle)">
</BsModal>

<DetailsModal Title="@("Customer DC Details")"
              Columns="@( ModelColumns)"
              ColumnFields="@(ModelFields)"
              HiddenColumns="@(ModelHiddenColumns)"
              Data="@(ModelData)"
              IsVisible="@IsCustDCModalVisible"
              IsVisibleChanged="@((val) => IsCustDCModalVisible = val)"
              SelectionValidation="SelectionValidationType.Customer"
              OnSelectedItems="@(OnCutomerGRNDCSelectedAsync)">
</DetailsModal>

<DetailsModal Title="@(!LabourDcOutgoingVM.WithoutPoDc ? "PO Details" : "DC Details")"
              Columns="@(!LabourDcOutgoingVM.WithoutPoDc ? PoColumns:ScnGrnPoFields)"
              ColumnFields="@(!LabourDcOutgoingVM.WithoutPoDc ? PoFields:ScnGrnPoFields)"
              HiddenColumns="@(!LabourDcOutgoingVM.WithoutPoDc ? HidePoFields:ScnGrnHiddenColumns)"
              Data="@(!LabourDcOutgoingVM.WithoutPoDc ? getPos : ScnGrnData)"
              IsVisible="@IsPoModalVisible"
              IsVisibleChanged="@((val) => IsPoModalVisible = val)"
              OnSelectedItems="@(!LabourDcOutgoingVM.WithoutPoDc ? OnPoSelectedAsync:OnGRNDCSelectedAsync)">
</DetailsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
