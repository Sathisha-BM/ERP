    }

    private List<PageHeader.BreadcrumbItem> LabourDcBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Labour",Url="sales-home" },
        new PageHeader.BreadcrumbItem { Text = "Delivery challan", IsLast = true }
    };


    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            await InitializeColumns(IsHidden);
            UserName = await CurrentUserService.GetUsernameAsync();
            IsPoWiseLabDcOut = await _dcService.IsPOWiseLabDcOutEnabledAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }
            //Sathish
            if (currentPage < 1)
            {
                currentPage = 1;
            }
            await LoadAllLabourDcDetailsAsync();
            screenCode = await _dcService.GetScreenCodeByScreenNameAsync(ScreenName);


            var saved = await PreferenceService.LoadPreferencesAsync("LabourDcList", UserName);
            if (saved?.Any() == true)
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(s => s.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }

            isProcessing = false;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the LabourDcList OnInitializedAsync() method");

        }
        finally
        {
            isProcessing = false;
        }
    }

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {

            Columns = new List<GridColumn>
            {
                new() { Title = "Dc ID", Field = "DcId", IsVisible = false },
                new() { Title = "Prefix", Field = "Prefix", IsVisible = false },
                new() { Title = "Dc No.", Field = "DcNo", IsVisible = true },
                new() { Title = "Dc Date", Field = "DcDate", IsVisible = true },

                new() { Title = "No of Items", Field = "NoOfItems", IsVisible = false },
                new() { Title = "Remarks", Field = "Remarks", IsVisible = false },

                new() { Title = "Manual", Field = "Manual", IsVisible = false },

                new() { Title = "Non Return DC", Field = "NonReturnDc", IsVisible = false },

