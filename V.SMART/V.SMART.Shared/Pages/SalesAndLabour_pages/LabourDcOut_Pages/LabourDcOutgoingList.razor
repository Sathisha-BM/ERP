    private async Task HandleDelete(LabourDcOutgoingVM dc)
    {
        try
        {
            var totalQty = dc.LabourDcOutgoingSubVMs
               .Where(s => s.TransType == "Out")   // or enum
               .Sum(s => s.Qty);

            var totalBalQty = dc.LabourDcOutgoingSubVMs
                .Where(s => s.TransType == "Out")
                .Sum(s => s.BalQty);

            if ((totalQty != totalBalQty) || dc.DcTally)
            {
                await _JS.ToastrError("Oops! You can't delete this DC because some items have already been processed.");
                return;

            }
            bool hasAnyItemOrGRNCancel = await _dcService.HasAnyItemOrLabourDcCancelAsync(dc.DcId);
            if (hasAnyItemOrGRNCancel)
            {
                await _JS.ToastrWarning("Cannot delete this Labour Dc as it or one of its items has been cancelled.");
                return;
            }

            if (!string.IsNullOrEmpty(dc.EwayNo))
            {
                await _JS.ToastrWarning("This Dc cannot be delete because Eway transactions are done.");
                return;
            }

            var (canDelete, message) = await _dcService.CanDeleteLabourDcOutgoingAsync(dc.DcId, screenCode, dc.DcNo);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteDcID = dc.DcId;
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error while HandleDelete in LabourDcoutgooing List");
            await _JS.ToastrError("Failed to  HandleDelete data.");
        }
    }

    private async Task confirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (isConfirmed && DeleteDcID > 0 && confirmation=="")
            {

                isProcessing = true;
                bool success = false;
                if (IsPoWiseLabDcOut)
                {
                    success = await _dcService.DeleteLabourDcPoWiseByIdAsync(DeleteDcID, screenCode);
                }
                else
                {
                    success = await _dcService.DeleteLabourDcByIdAsync(DeleteDcID, screenCode);
                }

                //bool success = await _dcService.DeleteLabourDcByIdAsync(DeleteDcID, screenCode);
                if (success)
                {
                    await _JS.ToastrSuccess("DC Deleted successfully.");
                    await LoadAllLabourDcDetailsAsync();
                }
                else
                {
                    await _JS.ToastrWarning("Dc Delete failed.");


                }
                isProcessing = false;
                DeleteDcID = 0;
            }
            else if (isConfirmed && confirmation == "Export")
            {
                await ExportToExcel(isConfirmed);
                confirmation = "";
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the LabourDcList confirmDelete_Click() method");
            await _JS.ToastrError("An error occurred while handling the LabourDcList confirmDelete_Click() method");
        }
    }


