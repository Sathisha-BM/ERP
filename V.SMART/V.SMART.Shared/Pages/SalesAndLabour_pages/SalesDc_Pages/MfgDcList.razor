        try
        {
            isProcessing = true;
            await _js.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;


            var exportData = await _mfgDcService.GetMfgDCPendingList(selectedStatus);

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "MfgDcPending", "Manufacturing Dc Pending's Pending List");

            var base64 = Convert.ToBase64String(bytes);
            await _js.DownloadExcelAsync(base64, "ManufacturingDcPendingExport.xlsx");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex,
                "Error in ExportToExcel (ManufacturingDcExport)");
            await _js.ToastrError("Error while exporting MfgPo!");
        }
        finally
        {
            isProcessing = false;
        }
    }
