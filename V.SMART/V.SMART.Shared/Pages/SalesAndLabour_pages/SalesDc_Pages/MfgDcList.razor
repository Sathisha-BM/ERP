    private async Task HandleDelete(MfgDcVM dc)
    {
        try
        {

            if (dc.DcTally || dc.MfgDcSubVMs.Any(x => x.BalQty != x.Qty))
            {
                await _js.ToastrWarning("Deletion not allowed. some transaction already been processed for this Mfg Dc.");
                return;

            }
            bool hasInvTransMade = await _mfgDcService.HasAnyItemOrDcCancelAsync(dc.DcId);
            if (hasInvTransMade)
            {
                await _js.ToastrWarning("Cannot delete this dc. Dc or item already cancelled.");
                return;
            }

            if (!string.IsNullOrEmpty(dc.EwayBillNo))
            {
                await _js.ToastrWarning("This Dc cannot be delete because Eway transactions are done.");
                return;
            }

            ModalTitle = "Are you sure you want to delete this mfg dc?";
            btnColor = "btn-danger";
            btnText = "Yes, Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            DeleteDcId = dc.DcId;
            await _js.InvokeVoidAsync("ShowConfirmationModal");

        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error initiating delete for DcId: {dc.DcId}");
            await _js.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed) return;

            if (confirmation=="Delete" && isConfirmed)
            {

                var deleted = await _mfgDcService.DeleteMfgDcByDcIdAsync(DeleteDcId, screenCode);
                if (deleted)
                {
                    await _js.ToastrSuccess("Dc deleted successfully.");
                    await LoadAllDcDetailsAsync();
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    await _js.ToastrWarning("Dc could not be deleted. It may not exist or has dependencies.");
                }
            }
            else if (confirmation == "Export" && isConfirmed)
            {
                await ExportToExcel(isConfirmed);
            }

        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error deleting DcId: {DeleteDcId}");
            await _js.ToastrError("Failed to delete DC.");
        }
        finally
        {
            DeleteDcId = 0;
        }
    }

    private async Task OnPoSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (MfgDcVM.MfgDcSubVMs == null)
            MfgDcVM.MfgDcSubVMs = new List<MfgDcSubVM>();

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            MfgDcVM.CustId = selectedItems
                                  .Where(i => i.ContainsKey("CustId") && i["CustId"] != null)
                                  .Select(i => Convert.ToInt32(i["CustId"]))
                                  .FirstOrDefault(id => id > 0);

            var priceDict = await _mfgDcService.GetBulkLastUnitPricesAsync(itemIds, MfgDcVM.CustId ?? 0);
            //var priceDict = await MfgPoService.GetBulkLastUnitPricesAsync(itemIds, custId);

            var LabourCost = await _CostingService.GetBulkLabourCostsAsync(itemIds);

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? poSubId = item.ContainsKey("PoSubId") && item["PoSubId"] != null
                    ? Convert.ToInt32(item["PoSubId"])
                    : (int?)null;

                if (MfgDcVM.MfgDcSubVMs.Any(x => x.ItemId == itemId && x.RefPoSubId == poSubId))
                    continue;

                var subVm = new MfgDcSubVM
                {
                    RefPoSubId = poSubId,
                    RefPoNo = item.TryGetValue("PoNo", out var poNo) ? poNo?.ToString() : string.Empty,

                    RefPoDate = item.TryGetValue("PoDate", out var poDate) && DateTime.TryParse(poDate?.ToString(), out var parsedPoDate)
                        ? parsedPoDate
                        : (DateTime?)null,

                    LineId = item.TryGetValue("LineId", out var lineId) ? lineId?.ToString() : string.Empty,
                    ItemId = itemId,
                    ItemCode = item.TryGetValue("ItemCode", out var itemCode) ? itemCode?.ToString() : string.Empty,
                    ItemName = item.TryGetValue("ItemName", out var itemName) ? itemName?.ToString() : string.Empty,
                    MeasureUnit = item.TryGetValue("UOM", out var uom) ? uom?.ToString() : string.Empty,
                    HSNCode = item.TryGetValue("HSNCode", out var hsn) ? hsn?.ToString() : string.Empty,

                    Qty = item.TryGetValue("Qty", out var qtyVal) && decimal.TryParse(qtyVal?.ToString(), out var parsedQty)
                        ? parsedQty
                        : 0m,

                    BalQty = item.TryGetValue("BalQty", out var balQtyVal) && decimal.TryParse(balQtyVal?.ToString(), out var parsedBalQty)
                        ? parsedBalQty
                        : 0m,

                    PoBalQty = item.TryGetValue("BalQty", out var poBalQtyVal) && decimal.TryParse(poBalQtyVal?.ToString(), out var parsedPoBalQty)
                        ? parsedPoBalQty
                        : 0m,

                    UnitPrice = item.TryGetValue("UnitPrice", out var unitPrice) && decimal.TryParse(unitPrice?.ToString(), out var parsedPrice)
                        ? parsedPrice
                        : 0m,
                    LabourCost = LabourCost.TryGetValue(itemId, out var LabourCosts) ? LabourCosts : 0,

                    StockQty = item.TryGetValue("StockQty", out var StockQty) && decimal.TryParse(StockQty?.ToString(), out var parsedStockQty)
                        ? parsedStockQty
                        : 0m,

                    PoDueDate = item.TryGetValue("PoDuedate", out var dueDate) && DateTime.TryParse(dueDate?.ToString(), out var parsedDueDate)
                        ? parsedDueDate
                        : (DateTime?)null,

                    CostId = item.TryGetValue("CostCenterId", out var costId) && int.TryParse(costId?.ToString(), out var parsedCostId) && parsedCostId != 0
                        ? parsedCostId
                        : (int?)null,

                    ProjectNo = item.TryGetValue("ProjectNo", out var projectNo) ? projectNo?.ToString() : string.Empty,

                    RcSubIds = item.ContainsKey("RcSubId") ? item["RcSubId"]?.ToString() : "",

                    TypeOfPo = "General PO",

                    IsEditable = true
                };


                MfgDcVM.MfgDcSubVMs.Add(subVm);
            }

            int slNo = 1;
            foreach (var row in MfgDcVM.MfgDcSubVMs)
            {
                row.SlNo = slNo++;
            }
            if (IsLabourCost)
            {
                foreach (var row in MfgDcVM.MfgDcSubVMs)
                {

                    if (row.UnitPrice < row.LabourCost)
                    {
                        _js.ToastrWarning(
                            $"Unit Price ({row.UnitPrice:0.00}) Is less than Labour Cost ({row.LabourCost:0.00})."
                        );
                    }
                    else if (row.UnitPrice > row.LabourCost)
                    {
                        _js.ToastrWarning(
                        $"Unit Price ({row.UnitPrice:0.00}) Is  Greater than than Labour Cost ({row.LabourCost:0.00})."
                    );

                    }

                }
            }

            StateHasChanged();
            MfgDcVM.Prefix = await _mfgDcService.GetPrefixFromDb();
            MfgDcVM.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            MfgDcVM.DcNo = await _mfgDcService.GetDcOutgoingNoAsync(MfgDcVM.Suffix);

            NavigationState.Set("MfgDc", MfgDcVM);
            _navigation.NavigateTo(
                $"/MfgDc/create/{MfgDcVM.CustId}");

        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
            await _js.ToastrError("Error processing selected PoSelected items.");
        }
    }

