                                                                <small class="text-success mt-1 d-block">
                                                                    <i class="bi bi-check-circle-fill me-1"></i>
                                                                    @Document.FileName
                                                                </small>
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="mt-4 d-flex gap-2">
                                                    <button type="button" class="btn btn-qms-success" @onclick="SaveDocument">
                                                            <i class="bi bi-save"></i> Save Document
                                                        </button>
                                                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                                                            <i class="bi bi-x-circle"></i> Cancel
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <!-- ===== DEFAULT VIEW ===== -->
                                                    <div class="text-center text-muted py-5">
                                                        <i class="bi bi-folder2-open" style="font-size: 4rem; display: block; margin-bottom: 1rem; color: var(--border-color);"></i>
                                                        <h5>Welcome to ISO QMS Document Management</h5>
                                                        <p class="mb-0">Select a header or document from the tree to view its details.</p>
                                                        <div class="mt-3 d-flex justify-content-center gap-2">
                                                        <button type="button" class="btn btn-qms-primary btn-sm" @onclick="NewHeader">
                                                                <i class="bi bi-folder-plus"></i> Create Header
                                                            </button>
                                                        <button type="button" class="btn btn-qms-success btn-sm" @onclick="NewDocument">
                                                                <i class="bi bi-file-earmark-plus"></i> Create Document
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                    </EditForm>
                </div>
            </div>
        </div>

    }
}
@code {

    protected override string ScreenName => "Qmsdocuments";

    private bool isProcessing = true;
    private int screenCode { get; set; }

    private List<PageHeader.BreadcrumbItem> incomeBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master" },
        new PageHeader.BreadcrumbItem { Text = "QMS/ISO" },
        new PageHeader.BreadcrumbItem { Text = "QMS/ISO", IsLast = true } 
    };

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private string incomeIcon = "bi bi-graph-up-arrow";

    List<QmsDocumentHeaderVM> Headers = new();
    List<QmsDocumentVM> Documents = new();

    private QmsDocumentVM? rowToDelete;

    QmsDocumentHeaderVM Header = new();
    QmsDocumentVM Document = new();
    bool IsHeader = false;
    bool IsDocument = false;
    bool IsEditing = false;

    HashSet<int> ExpandedHeaders = new();
    int? SelectedHeaderId = null;
    int? SelectedDocumentId = null;


    QmsDocumentHeaderVM? SelectedHeader => SelectedHeaderId.HasValue ? Headers.FirstOrDefault(h => h.HeaderId == SelectedHeaderId.Value) : null;
    QmsDocumentVM? SelectedDocument => SelectedDocumentId.HasValue ? Documents.FirstOrDefault(d => d.DocumentId == SelectedDocumentId.Value) : null;
    IEnumerable<QmsDocumentVM> DocumentsUnderSelectedHeader => SelectedHeaderId.HasValue
        ? Documents.Where(d => d.HeaderId == SelectedHeaderId.Value)
        : Enumerable.Empty<QmsDocumentVM>();

    bool IsDocumentExpired(QmsDocumentVM doc) => doc.ExpiryDate.HasValue && doc.ExpiryDate < DateTime.Now;


  

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync(); 

            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            screenCode = await QimsService.GetScreenCodeByScreenNameAsync(ScreenName);
            await LoadData();

           
        }
        catch (Exception ex) 
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Income OnInitializedAsync() Method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadData()
    {
        try
        {
            Headers = await QimsService.GetAllHeadersAsync();
            Documents = await QimsService.GetAllDocumentsAsync();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the  LoadData() Method");
        }


    }

    RenderFragment DrawTree(QmsDocumentHeaderVM node, int level) => builder =>
{
    int seq = 0;

    bool isExpanded = ExpandedHeaders.Contains(node.HeaderId);
    bool isSelected = SelectedHeaderId == node.HeaderId;

    int docCount = Documents.Count(x => x.HeaderId == node.HeaderId);
    int expiredCount = Documents.Count(x => x.HeaderId == node.HeaderId && IsDocumentExpired(x));

    // Root Container
    builder.OpenElement(seq++, "div");
    builder.AddAttribute(seq++, "class", "tree-node");
    builder.AddAttribute(seq++, "style", $"margin-left:{level * 24}px;");

    //================ HEADER ==================

    builder.OpenElement(seq++, "div");
    builder.AddAttribute(seq++, "class", $"tree-item {(isSelected ? "active" : "")}");

    builder.AddAttribute(seq++, "onclick",
        EventCallback.Factory.Create(this,
            () => ToggleHeader(node.HeaderId)));

    // Folder Icon
    builder.OpenElement(seq++, "i");
    builder.AddAttribute(seq++, "class",
        isExpanded
            ? "bi bi-folder2-open folder-icon"
            : "bi bi-folder folder-icon");
    builder.CloseElement();

    builder.AddContent(seq++, " ");
    builder.AddContent(seq++, node.HeaderName);

    if (docCount > 0)
    {
        builder.OpenElement(seq++, "span");

        builder.AddAttribute(seq++, "class",
            expiredCount > 0
                ? "badge-doc-count danger"
                : "badge-doc-count");

        builder.AddContent(seq++,
            expiredCount > 0
                ? $"{docCount} ({expiredCount} ⚠)"
                : docCount.ToString());

        builder.CloseElement();
    }

    builder.CloseElement();

    //================ CHILDREN ==================

    if (isExpanded)
    {
        //================ CHILD HEADERS ==================

        foreach (var child in Headers
                     .Where(x => x.ParentHeaderId == node.HeaderId)
                     .OrderBy(x => x.HeaderName))
        {
            builder.AddContent(seq++, DrawTree(child, level + 1));
        }

        //================ DOCUMENTS ==================

        foreach (var doc in Documents
                     .Where(x => x.HeaderId == node.HeaderId)
                     .OrderBy(x => x.DocumentName))
        {
            bool isExpired = IsDocumentExpired(doc);
            bool isDocSelected = SelectedDocumentId == doc.DocumentId;

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class",
                $"tree-item {(isExpired ? "expired-doc" : "")}");

            builder.AddAttribute(seq++, "style",
                $"margin-left:{(level + 1) * 24}px;");

            // File Icon
            builder.OpenElement(seq++, "i");
            builder.AddAttribute(seq++, "class",
                isExpired
                    ? "bi bi-exclamation-triangle-fill expired-icon"
                    : "bi bi-file-earmark-text file-icon");
            builder.CloseElement();

            builder.AddContent(seq++, " ");

            // Document Link
            builder.OpenElement(seq++, "a");
            builder.AddAttribute(seq++, "href", "javascript:void(0)");
            builder.AddAttribute(seq++, "class",
                $"text-decoration-none {(isDocSelected ? "fw-bold" : "")}");

            builder.AddAttribute(seq++, "onclick",
                EventCallback.Factory.Create(this,
                    () => SelectDocument(doc.DocumentId)));

            builder.AddContent(seq++,
                $"{doc.DocumentName} ({doc.RevisionNo})");

            builder.CloseElement();

            // Expired Badge
            if (isExpired)
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "expired-badge");
                builder.AddContent(seq++, "Expired");
                builder.CloseElement();
            }

            // Download
            if (!string.IsNullOrWhiteSpace(doc.FileName))
            {
                builder.AddContent(seq++, " ");

                builder.OpenElement(seq++, "a");
                builder.AddAttribute(seq++, "href",
                    $"data:application/octet-stream;base64,{Convert.ToBase64String(doc.FileContent ?? Array.Empty<byte>())}");

                builder.AddAttribute(seq++, "download", doc.FileName);
                builder.AddAttribute(seq++, "class",
                    "btn btn-sm btn-outline-primary py-0 px-1 ms-2");

                builder.OpenElement(seq++, "i");
                builder.AddAttribute(seq++, "class", "bi bi-download");
                builder.CloseElement();

                builder.CloseElement();

                // Preview
                builder.OpenElement(seq++, "button");
                builder.AddAttribute(seq++, "type", "button");
                builder.AddAttribute(seq++, "class",
                    "btn btn-sm btn-outline-success py-0 px-1 ms-1");

                builder.AddAttribute(seq++, "onclick",
                    EventCallback.Factory.Create(this,
                        () => PreviewDocument(doc)));

                builder.OpenElement(seq++, "i");
                builder.AddAttribute(seq++, "class", "bi bi-eye");
                builder.CloseElement();

                builder.CloseElement();
            }

            builder.CloseElement();
        }
    }

    builder.CloseElement();
};
 


    public void ToggleHeader(int headerId)
    {

        if (ExpandedHeaders.Contains(headerId))
            ExpandedHeaders.Remove(headerId);
        else
            ExpandedHeaders.Add(headerId);

        SelectHeader(headerId);
    }

    public  void SelectHeader(int headerId)
    {
        SelectedHeaderId = headerId;
        SelectedDocumentId = null;
        IsHeader = false;
        IsDocument = false;
        IsEditing = false;
        StateHasChanged();
    }

    public  void SelectDocument(int documentId)
    {
        SelectedDocumentId = documentId;
        SelectedHeaderId = null;
        IsHeader = false;
        IsDocument = false;
        IsEditing = false;
        StateHasChanged();
    }

    public  void RefreshTree()
    {

        StateHasChanged();
    }

    public  void EditDocument()
    {
        if (SelectedDocument != null)
        {
            Document = new QmsDocumentVM
            {
                DocumentId = SelectedDocument.DocumentId,
                HeaderId = SelectedDocument.HeaderId,
                DocumentNo = SelectedDocument.DocumentNo,
                DocumentName = SelectedDocument.DocumentName,
                RevisionNo = SelectedDocument.RevisionNo,
                EffectiveDate = SelectedDocument.EffectiveDate,
                ReviewDueDate = SelectedDocument.ReviewDueDate,
                ExpiryDate = SelectedDocument.ExpiryDate,
                FileName = SelectedDocument.FileName,
                FileContent = SelectedDocument.FileContent
            };
            IsDocument = true;
            IsEditing = true;
            StateHasChanged();
        }
    }


    public void NewHeader()
    {
        Header = new QmsDocumentHeaderVM();
      
        IsHeader = true;
        IsDocument = false;
        IsEditing = false;
        SelectedHeaderId = null;
        SelectedDocumentId = null;
    }

    public  void NewDocument()
    {
        Document = new QmsDocumentVM();
        if (SelectedHeaderId.HasValue)
            Document.HeaderId = SelectedHeaderId.Value;
        IsDocument = true;
        IsHeader = false;
        IsEditing = false;
        SelectedHeaderId = null;
        SelectedDocumentId = null;
    }

    public  void CancelEdit()
    {
        IsHeader = false;
        IsDocument = false;
        IsEditing = false;
        if (SelectedHeaderId == null && SelectedDocumentId == null)
        {
            var firstRoot = Headers.FirstOrDefault(h => h.ParentHeaderId == null);
            if (firstRoot != null)
                SelectHeader(firstRoot.HeaderId);
        }
        StateHasChanged();
    }

    private async Task SaveHeader()
    {
        try
        {

            if (string.IsNullOrWhiteSpace(Header.HeaderName))
                return;

            Header = await QimsService.UpsertHeadersAsync(Header, screenCode);

            Headers = await QimsService.GetAllHeadersAsync();

            ExpandedHeaders.Add(Header.HeaderId);

            int savedId = Header.HeaderId;

            Header = new QmsDocumentHeaderVM();
            IsHeader = false;

            SelectHeader(savedId);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the SaveHeader Method");
        }
    }
    private async Task SaveDocument()
    {
        try
        {



            if (string.IsNullOrWhiteSpace(Document.DocumentName) || Document.HeaderId == 0)
                return;

            Document = await QimsService.UpsertQimsAsync(Document, screenCode);

            int savedId = Document.DocumentId;
            Documents = await QimsService.GetAllDocumentsAsync();

            Document = new QmsDocumentVM();

            IsDocument = false;
            IsEditing = false;

            SelectDocument(savedId);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the SaveDocument Method");
        }
    }


    public async Task Upload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            Document.FileName = file.Name;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            Document.FileContent = ms.ToArray();
            Document.FileType = file.ContentType;
            StateHasChanged();
        }
         
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Upload Method");
        }

    
    }

    public async Task PreviewDocument(QmsDocumentVM doc)
    {
        try
        {
            if (doc.FileContent == null || doc.FileContent.Length == 0)
            {
                await JSRuntime.ToastrWarning("No document found.");
                return;
            }

            var contentType = string.IsNullOrWhiteSpace(doc.FileType)
                ? GetContentType(doc.FileName)
                : doc.FileType;

            await fileOpener.OpenAsync(doc.FileContent, doc.FileName, contentType);
        }
        catch (Exception ex)
        {
            await JSRuntime.ToastrError("Failed to open file.");
        }
        finally
        {
            isProcessing = false;
        }
    }
    private string GetContentType(string fileName)
    {
        var ext = Path.GetExtension(fileName)?.ToLowerInvariant();

        return ext switch
        {
            ".pdf" => "application/pdf",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".bmp" => "image/bmp",
            ".txt" => "text/plain",
            ".csv" => "text/csv",
            ".doc" => "application/msword",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".xls" => "application/vnd.ms-excel",
            ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".ppt" => "application/vnd.ms-powerpoint",
            ".pptx" => "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            _ => "application/octet-stream"
        };
    }


    private async Task UpsertIncome()
    {
        try
        {
            isProcessing = true;
            foreach (var docs in Documents)
            {
                await QimsService.UpsertQimsAsync(docs, screenCode);
            }

            foreach (var docs in Headers)
            {
                await QimsService.UpsertHeadersAsync(docs, screenCode);
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Income UpsertIncome() Method");
        }

    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {

        try
        {
            await JSRuntime.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;
                case "RemoveHeader":
                    await CanRemove(true);
                    break;
                default:
                    await JSRuntime.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action in HandleModalConfirmation: {confirmation}");
            await JSRuntime.ToastrError("An error occurred while processing your action in HandleModalConfirmation. Please try again.");
        }


    }
    private async Task CanRemove(bool isConfirmed)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || SelectedHeader == null)
            {
                await JSRuntime.ToastrInfo("Action was not confirmed.");
                return;
            }

            if (SelectedHeader.HeaderId > 0)
            {
                // Delete from database
                await QimsService.DeleteHeaderAsync(SelectedHeader.HeaderId, screenCode);

                Headers = await QimsService.GetAllHeadersAsync();
            }
            else
            {
                // Remove only from UI
                Headers.Remove(SelectedHeader);
            }

            SelectedHeaderId = null;
            Header = new QmsDocumentHeaderVM();

            StateHasChanged();

            await JSRuntime.ToastrSuccess("Header deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,$"CanRemove failed for HeaderId: {SelectedHeader?.HeaderId}");

            await JSRuntime.ToastrError("An error occurred while deleting the header.");
        }
    }
    private async Task RemoveRow(QmsDocumentVM item)
    {
        try
        {

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";

            showCancelReasonBox = false;

            await JSRuntime.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for GRNSubId: {item?.DocumentId}");
            await JSRuntime.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await JSRuntime.ToastrInfo("Action was not confirmed.");
                return;
            }

            if (rowToDelete.DocumentId > 0)
            {
                await QimsService.DeleteAndResequenceAsync(rowToDelete,screenCode);

                Documents = await QimsService.GetAllDocumentsAsync();
            }
            else
            {
                Documents.Remove(rowToDelete);
                SelectedDocumentId = null;
                StateHasChanged();
            }

            await JSRuntime.ToastrSuccess($" deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for DocId:{Document.DocumentId}");
            await JSRuntime.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }
    private void EditHeader()
    {
        if (SelectedHeader == null)
            return;
       
       
        Header = new QmsDocumentHeaderVM
        {
            HeaderId = SelectedHeader.HeaderId,
            HeaderName = SelectedHeader.HeaderName,
            ParentHeaderId = SelectedHeader.ParentHeaderId
        };

        IsHeader = true;
        IsDocument = false;
        IsEditing = true;
    }

  
    private async Task DeleteHeader()
    {
        try
        {

            if (SelectedHeader == null)
                return;

            if (Documents.Any(x => x.HeaderId == SelectedHeader.HeaderId))
            {
                await JSRuntime.ToastrWarning("Please delete all documents under this header first.");
                return;
            }

            if (Headers.Any(x => x.ParentHeaderId == SelectedHeader.HeaderId))
            {
                await JSRuntime.ToastrWarning("Please delete all child headers first.");
                return;
            }

            ModalTitle = "Are you sure you want to Delete Header?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "RemoveHeader";
            showCancelReasonBox = false;


            await JSRuntime.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming DeleteHeader ");
            await JSRuntime.ToastrError("An error occurred during DeleteHeader. Please try again.");
        }

    }
}