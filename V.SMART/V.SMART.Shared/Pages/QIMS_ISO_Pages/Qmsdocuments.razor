                                                            <input class="form-control" @bind="Document.DocumentNo" placeholder="e.g., SOP-001" />
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label"><i class="bi bi-file-earmark-text"></i> Document Name <span class="text-danger">*</span></label>
                                                            <input class="form-control" @bind="Document.DocumentName" placeholder="Enter document name..." />
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label"><i class="bi bi-tag"></i> Revision</label>
                                                            <input class="form-control" @bind="Document.RevisionNo" placeholder="Rev-00" />
                                                        </div>
                                                        <div class="col-md-4">
