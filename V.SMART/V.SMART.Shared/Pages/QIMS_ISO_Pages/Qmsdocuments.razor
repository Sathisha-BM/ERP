                                                        <div class="col-md-4">
                                                            <label class="form-label"><i class="bi bi-calendar-event"></i> Review Due</label>
                                                            <input type="date" class="form-control" @bind="Document.ReviewDueDate" />
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label"><i class="bi bi-calendar-x"></i> Expiry Date</label>
                                                            <input type="date" class="form-control" @bind="Document.ExpiryDate" />
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label">
                                                                <i class="bi bi-upload"></i> File Attachment
                                                            </label>

                                                            <div class="input-group">

                                                                <InputFile class="form-control"
