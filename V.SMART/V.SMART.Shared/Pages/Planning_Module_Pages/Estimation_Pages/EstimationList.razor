        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting EstiamateId: {EstiamateId}");
            await _JS.ToastrError("Failed to delete Sales Estiamate.");
        }
        finally
        {
            EstiamateId = 0;
            isProcessing = false;
        }
    }
