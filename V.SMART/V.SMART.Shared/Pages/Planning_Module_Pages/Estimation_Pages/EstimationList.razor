    private async Task OnEnquirySelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        try
        {
            if (selectedItems == null || !selectedItems.Any())
            {
                await _JS.ToastrWarning("Please select one item.");
                return;
            }

            if (selectedItems.Count > 1)
            {
                await _JS.ToastrWarning("Please select only one item.");
                return;
            }
            var item = selectedItems.First();

            int custId = item.ContainsKey("CustId") && item["CustId"] != null
                ? Convert.ToInt32(item["CustId"])
                : 0;

            int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                ? Convert.ToInt32(item["ItemId"])
                : 0;

            int? refEnqSubId = item.ContainsKey("RefEnqSubId") && item["RefEnqSubId"] != null
                ? Convert.ToInt32(item["RefEnqSubId"])
                : (int?)null;

            var vm = new EstimateVM
                {
                    CustId = custId,
                    RefEnqSubId = refEnqSubId,
                    EnquiryNo = item["EnquiryNo"]?.ToString(),
                    ItemId = itemId,
                    ItemCode = item["ItemCode"]?.ToString(),
                    ItemName = item["ItemName"]?.ToString()
                };

            vm.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            vm.EstiamateNo = await _EstimateServiecs.GetEstimateNumberAsync(vm.Suffix);

            vm.EstimateSubVM = await _EstimateServiecs.GetItemProcessList(vm.ItemId ?? 0, 0);

            //Checking in MAster
            var tempitem = await _EstimateServiecs.GetItem(vm.ItemId??0);

            var Estimation = await _EstimateServiecs.GetEstimationByItemIdAsync(vm.ItemId??0);

            if (tempitem != null)
            {
                if (!string.IsNullOrWhiteSpace(tempitem.Shape))
                    vm.Shape = tempitem.Shape;

                if (tempitem.Density > 0)
                    vm.Density = tempitem.Density;

                if (tempitem.Length > 0)
                    vm.Length = tempitem.Length;

                if (tempitem.Width > 0)
                    vm.Width = tempitem.Width;

                if (tempitem.Height > 0)
                    vm.Height = tempitem.Height;

                if (tempitem.Thickness > 0)
                    vm.Thickness = tempitem.Thickness;

                if (tempitem.WallThickness > 0)
                    vm.WallThickness = tempitem.WallThickness;

                if (tempitem.OuterDia > 0)
                    vm.OuterDia = tempitem.OuterDia;

                if (tempitem.InnerDia > 0)
                    vm.InnerDia = tempitem.InnerDia;

                if (tempitem.Weight > 0)
                    vm.Weight = tempitem.Weight;
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(Estimation.Shape))
                    vm.Shape = Estimation.Shape;

                if (Estimation.Density > 0)
                    vm.Density = Estimation.Density;

                if (Estimation.Length > 0)
                    vm.Length = Estimation.Length;

                if (Estimation.Width > 0)
                    vm.Width = Estimation.Width;

                if (Estimation.Height > 0)
                    vm.Height = Estimation.Height;

                if (Estimation.Thickness > 0)
                    vm.Thickness = Estimation.Thickness;

                if (Estimation.WallThickness > 0)
                    vm.WallThickness = Estimation.WallThickness;

                if (Estimation.OuterDia > 0)
                    vm.OuterDia = Estimation.OuterDia;

                if (Estimation.InnerDia > 0)
                    vm.InnerDia = Estimation.InnerDia;

                if (Estimation.Weight > 0)
                    vm.Weight = Estimation.Weight;
            }


            NavigationState.Set("estimation", vm);

            _navigation.NavigateTo($"/estimation/create/{custId}");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnEnquirySelectedAsync");
            throw;
        }
    }



    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            SearchFilters = new();
            selectedStatus = e.Value?.ToString() ?? "";

            if (string.IsNullOrWhiteSpace(selectedStatus))
                SearchFilters.Remove("Status");
            else
                SearchFilters["Status"] = selectedStatus;


            currentPage = 1;
            await LoadAllEstimations();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error OnStatusChanged in SalesEnquiryList");
            await _JS.ToastrError("Failed to Load Sales Enquiry List filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllEstimations();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in SalesEnquiryList");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllEstimations();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing SalesEnquiryList page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }
    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the SalesEnquiryList HandleColumnChange() Method");
        }
    }

    //#endregion

    #region SEARCH FILTERS
    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllEstimations();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in SalesEnquiryList");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }
    #endregion

}
