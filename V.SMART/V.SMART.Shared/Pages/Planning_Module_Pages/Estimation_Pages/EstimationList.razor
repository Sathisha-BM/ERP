@page "/estimationList"

@using V.SMART.Shared.ViewModels.PlanningViewModel.EstimationViewModel
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IPlanningService

@inherits BaseUserRightsComponent

@inject IEstimateService _EstimateServiecs
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ExcelExportService ExcelExportService
@inject NavigationStateService NavigationState

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch isModelVisible="true"
        Screen="@ScreenName"
        Filters="SearchFilters"
        OnClose="CloseModal"
        OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
Title="@ModalTitle"
ButtonBootstrapStyle="@btnColor"
ButtonText="@btnText"
ShowReasonBox="@showCancelReasonBox"
Reason="@cancelReason"
OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="Enquiry Details"
Columns="@EnquiryColumns"
ColumnFields="@EnquiryFields"
HiddenColumns="@EnquiryHiddenColumns"
Data="@EnquiryData"
IsVisible="@IsEnquiryModalVisible"
IsVisibleChanged="@((val) => IsEnquiryModalVisible = val)"
OnSelectedItems="OnEnquirySelectedAsync">
</DetailsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Estimation List"
            TitleIcon="bi bi-receipt-cutoff"
            Breadcrumbs="@EstimateBreadcrumbs" />

            <div class="card-body p-4">

                <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                        ScreenName="@ScreenName"
                        UserId="@UserName"
                        MaxVisible=int.MaxValue
                        OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                        @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                        @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                        value="@pageSize"
                        @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    @*  Enquiry Pending Items OnStatusChanged *@
                    <div class="col-6 col-md-2">
                        <button type="button"
                                class="btn btn-sm btn-primary px-4" @onclick="ShowEnquiryDetails">
                            <i class="bi bi-list-ul me-1"></i> Enquiry Pending 
                        </button>
                    </div>

                    @if (CanCreate)
                    {
                        <div class="col-6 col-md-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                            @onclick="AddNewEstimation">
                                <i class="bi bi-plus-square me-1"></i> Add New
                            </button>
                        </div>
                    }

                </div>

                @if (EstimateVM.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="EstimateVM.AsQueryable()"
                        Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Any(c => c.IsVisible))
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            case "EstiamateId":
                                                <PropertyColumn Title="EstiamateId" Property="@(c => c.EstiamateId)" />
                                                break;

                                            @* case "Prefix":
                                                <PropertyColumn Title="Prefix" Property="@(c => c.Prefix)" />
                                                break; *@

                                            case "EstiamateNo":
                                                <PropertyColumn Title="Estiamate No"
                                                Property="@(c => $"{c.EstiamateNo}{c.Suffix ?? string.Empty}")"
                                                Sortable="true" />
                                                break;

                                            case "EstimateDate":
                                                <PropertyColumn Title="Estimate Date"
                                                Property="@(c => c.EstimateDate)"
                                                Format="dd/MM/yyyy"
                                                Sortable="true" />
                                                break;

                                            case "TypeofWork":
                                                <PropertyColumn Title="Type of Work"
                                                Property="@(c => c.TypeofWork)"
                                                Sortable="true" />
                                                break;
                                            case "CustId":
                                                <PropertyColumn Title="Customer ID" Property="@(c => c.CustId)" />
                                                break;

                                            case "CustomerName":
                                                <PropertyColumn Title="Customer Name"
                                                Property="@(c => c.Custname)"
                                                Sortable="true" />
                                                break;
                                            case "ContactPerson":
                                                <PropertyColumn Title="Kind Of Attention"
                                                Property="@(c => c.ContactPerson)" />
                                                break;

                                            case "ItemId":
                                                <PropertyColumn Title="Item Id"
                                                Property="@(c => c.ItemId)"
                                                Sortable="true" />
                                                break;
                                            case "ItemCode":
                                                <PropertyColumn Title="Item Code"
                                                Property="@(c => c.ItemCode)"
                                                Sortable="true" />
                                                break;
                                            case "ItemName":
                                                <PropertyColumn Title="Item Name"
                                                Property="@(c => c.ItemName)"
                                                Sortable="true" />
                                                break;
                                            case "Qty":
                                                <PropertyColumn Title="Qty"
                                                Property="@(c => c.Qty)"
                                                Sortable="true" />
                                                break;
                                            case "EnquiryNo":
                                                <PropertyColumn Title="Enquiry No"
                                                Property="@(c => c.EnquiryNo)"
                                                Sortable="true" />
                                                break;
                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By"
                                                Property="@(c => c.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date"
                                                Property="@(c => c.CreatedDate)"
                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By"
                                                Property="@(c => c.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date"
                                                Property="@(c => c.ModifiedDate)"
                                                Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }
                            }


                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"estimation/update/{c.EstiamateId}")"
                                        class="btn btn-sm btn-outline-primary"
                                        title="Edit Estimation">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }

                                    @if (CanView)
                                    {
                                        <a href="@($"estimationDetails/details/{c.EstiamateId}")"
                                        class="btn btn-sm btn-outline-info"
                                        title="View Estimation">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }

                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                        title="Delete Estimation"
                                        @onclick="() => HandleDelete(c.EstiamateId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>
                        </QuickGrid>
                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>
                            @*  <div class="col-12 col-sm-9 position-relative">
                                <button type="button"
                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center" @onclick="ShowEnquiryDetails">

                                    <i class="bi bi-list-ul me-1"></i> Enquiry Details
                                </button>
                            </div> *@

                        </div>



                    </div>

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}


