    private List<string> EnquiryFields = new() { "CustId", "CustName", "RefEnqSubId", "EnquiryNo", "EnquiryDate", "ItemId", "ItemCode", "ItemName", "UOM", "Qty", "BalQty", "CostCenterId", "ProjectNo" };
    private List<string> EnquiryHiddenColumns = new() { "CustId", "Ref EnqSub Id", "Item Id", "Cost-Center Id" };


    //#region === initilization ===
    protected override async Task OnInitializedAsync()
    {
        try
