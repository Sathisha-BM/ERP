    private async Task UpsertEstimate()
    {
        try
        {
            isProcessing = true;
            // Validate each line
            foreach (var line in EstimateVM.EstimateSubVM)
            {
                var invalidRow = EstimateVM.EstimateSubVM.FirstOrDefault(x => !x.ProcessId.HasValue || x.ProcessId.Value <= 0);

                if (invalidRow != null)
                {
                    await _js.ToastrWarning("Please select a process for all added rows before saving.");
                    isProcessing = false;
                    return;
                }

                if (line.EstiamateId > 0)
                {
                    if (await _EstimateServiecs.IsEstimateUsedAsync(line.EstiamateId))
                    {
                        await _js.ToastrWarning("This Estimatation is already used in a Quotation. Updating is not allowed.");
                        isProcessing = false;
                        return;
                    }
                }
            }




            // Save
            var isNewEstimate = EstimateVM.EstiamateId == 0;

            try
            {
                await _EstimateServiecs.UpsertEstimateAsync(EstimateVM);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewEstimate)
                await _js.ToastrSuccess("Estimation saved successfully.");
            else
                await _js.ToastrSuccess("Estimation updated successfully.");

            _navigationManager.NavigateTo("/estimationList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertEstimation failed.");
            await _js.ToastrError("Error saving Estimation.");
        }
        finally
        {
            isProcessing = false;
        }
    }

