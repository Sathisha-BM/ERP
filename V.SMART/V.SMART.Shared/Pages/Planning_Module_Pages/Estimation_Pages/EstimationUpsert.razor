    private async Task AddRow()
    {
        // Check for incomplete rows
        if (EstimateVM.EstimateSubVM.Any(x =>
            x.ProcessId == 0 || x.Amount == null || x.Amount <= 0))
        {
            await _js.ToastrWarning("Please complete the existing row before adding a new one.");
            return;
        }

        _process = await itemService.GetAllProcessAsync();
        processnotfound = true;

        EstimateVM.EstimateSubVM.Add(new EstimateSubVM
        {
            ProcessId = 0,
            ProcessName = string.Empty,
            HrlyRate = 0,
            Hrs = 0,
            Amount = 0,
            IsEditable = true
        });

        StateHasChanged();
    }

    private async Task OnProcessChanged(EstimateSubVM sub)
    {
        if (!sub.ProcessId.HasValue)
            return;

        int selectedProcessId = sub.ProcessId.Value;

        // Check if the selected process already exists in another row
        bool alreadyExists = EstimateVM.EstimateSubVM.Any(x =>
            x != sub &&
            x.ProcessId.HasValue &&
            x.ProcessId.Value == selectedProcessId);

        if (alreadyExists)
        {
            await _js.ToastrWarning("This process has already been selected.");

            sub.ProcessId = null;
            sub.ProcessName = string.Empty;
            sub.HrlyRate = 0;
            sub.Hrs = 0;
            sub.Amount = 0;

            StateHasChanged();
            return;
        }

        // Load process details
        var process = _process.FirstOrDefault(p => p.ProcessId == selectedProcessId);

        if (process != null)
        {
            sub.ProcessName = process.ProcessName;
            sub.HrlyRate = await _EstimateServiecs.ProcessRate(selectedProcessId);
        }

        StateHasChanged();
    }
