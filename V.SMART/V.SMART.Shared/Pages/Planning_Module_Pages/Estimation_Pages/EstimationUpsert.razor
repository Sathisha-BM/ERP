    private async Task OnAmounttextInput(EstimateSubVM row, ChangeEventArgs e)
    {
        row.Hrs = 0;
        if (decimal.TryParse(e.Value?.ToString(), out var amount))
        {
            await ProcessCalucalate(row, amount: amount);
        }
        StateHasChanged();
    }

    //Sathish
    private async Task ProcessCalucalate(EstimateSubVM row, decimal? hrs = null, decimal? hrlyRate = null, decimal? amount = null)
    {
        try
        {
            if (hrs.HasValue)
                row.Hrs = hrs.Value;

            if (hrlyRate.HasValue)
                row.HrlyRate = hrlyRate.Value;

            if (amount.HasValue)
            {
                row.Amount = amount.Value;
                // Calculate Hours from Amount
                if ((row.HrlyRate ?? 0) > 0)
                {
                    row.Hrs = Math.Round((row.Amount.Value / row.HrlyRate.Value) * 60m, 3);
                }
            }
            else
            {
                // Calculate Amount from Hours & Hourly Rate
                row.Amount = Math.Round(((row.Hrs ?? 0m) / 60m) * (row.HrlyRate ?? 0m), 3);
            }

            // Calculate Total Conversion Cost
            EstimateVM.Conv = EstimateVM.EstimateSubVM.Sum(x => x.Amount ?? 0);

            await Calculation(EstimateVM);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ProcessCalucalate failed.");
            await _js.ToastrError("Calculation failed.");
        }
    }

    private void OnAmountInput(EstimateSubVM row, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var amount))
            row.Amount = amount;

        EstimateVM.Conv = EstimateVM.EstimateSubVM.Sum(x => x.Amount ?? 0m);
        RawMaterialCalculation(EstimateVM);

    }
    private async Task OnConvChanged(ChangeEventArgs e)
    {
