    private async Task SaveEstimateSubRow(EstimateSubVM row)
    {
        try
        {
            if (!await ValidateEstimateSubRowAsync(row))
            {
                row.IsEditable = true;
                return;
            }

            // Lock the row after successful validation
            row.IsEditable = false;

            // Recalculate amount/hrs consistency before committing
            await ProcessCalucalate(row, hrs: row.Hrs, hrlyRate: row.HrlyRate, amount: row.Amount);

            // Ensure there is ALWAYS a trailing editable row for adding new process
            if (!EstimateVM.EstimateSubVM.Any(x => x.IsEditable))
            {
                // EstimateVM.EstimateSubVM.Add(new EstimateSubVM
                // 	{
                // 		ProcessId = 0,
                // 		ProcessName = string.Empty,
                // 		HrlyRate = 0,
                // 		Hrs = 0,
                // 		Amount = 0,
                // 		IsEditable = true
                // 	});
            }

            // Recalculate totals after row commit
            EstimateVM.Conv = EstimateVM.EstimateSubVM.Sum(x => x.Amount ?? 0m);
            await Calculation(EstimateVM);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveEstimateSubRow failed for ProcessId: {row?.ProcessId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private Task<bool> ValidateEstimateSubRowAsync(EstimateSubVM row)
    {
        if (row == null)
            return Task.FromResult(false);

        if (!row.ProcessId.HasValue || row.ProcessId.Value <= 0)
        {
            _js.ToastrWarning("Please select a process.");
            return Task.FromResult(false);
        }



        return Task.FromResult(true);
    }

    private async Task CancelEditEstimateSub(EstimateSubVM row)
    {
        try
        {
            if (row == null || EstimateVM == null) return;

            bool isInvalid = (row.ProcessId == null || row.ProcessId <= 0);

            if (isInvalid)
            {
                EstimateVM.EstimateSubVM.Remove(row);
            }
            else
            {
                row.IsEditable = false;
            }



            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEditEstimateSub failed for ProcessId: {row?.ProcessId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task EditEstimateSubRowAsync(EstimateSubVM row)
    {
        try
        {
            row.IsEditable = true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditEstimateSubRowAsync failed for ProcessId: {row?.ProcessId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task RemoveEstimateSubRow(EstimateSubVM row)
    {
        try
        {
            if (EstimateVM.EstimateSubVM.Count == 1 && row.EstiamateSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row is required.");
                return;
            }

            // if (row.ProcessId == null || row.ProcessId == 0)
            // {
            EstimateVM.EstimateSubVM.Remove(row);

            // Ensure at least one editable row remains
            if (!EstimateVM.EstimateSubVM.Any(x => x.IsEditable))
            {
                EstimateVM.EstimateSubVM.Add(new EstimateSubVM
                {
                    ProcessId = 0,
                    ProcessName = string.Empty,
                    HrlyRate = 0,
                    Hrs = 0,
                    Amount = 0,
                    IsEditable = true
                });
                // }

                await _js.ToastrSuccess("New process row removed successfully.");
                StateHasChanged();
                return;
            }


        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveEstimateSubRow failed for ProcessId: {row?.ProcessId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }


    private string GetFormula(string shape)
    {
        return shape switch
        {

            "Round" =>
                "Material Weight = (π × OD² / 4 × L × D) / 1000000",

            "Rectangle Plate" =>
                "Material Weight = (L × W × T × D) / 1000000",

            "Square Plate" =>
                "Material Weight = (L × W × T × D) / 1000000",

            "Round Tube" =>
                "Material Weight = (π × (OD² - (OD - (2WT))²) / 4 × L × D) / 1000000",

            "Square Tube" =>
                "Material Weight = ((W² - (W - 2WT)²) × L × D) / 1000000",

            "Rectangle Tube" =>
                "Material Weight = ((W × H - (W - 2WT) × (H - 2WT)) × L × D) / 1000000",

            "U or C Channel" =>
                "Material Weight = (((H - 2WT) × WT) + (2 × (W × WT))) × L × D / 1000000",

            "I or H Channel" =>
                "Material Weight = (((H - 2WT) × WT) + (2 × (W × WT))) × L × D / 1000000",

            "L Angle" =>
                "Material Weight = (L × ((W × WT) + (H × WT)) × D) / 1000000",

            "Hexagonal Plate" =>
                "Material Weight = (2.598 × OD² × T × D) / 1000000",

            "Sheet" =>
                "Material Weight = (L × W × T × D) / 1000000",

            "Octagonal" =>
                "Material Weight = (2 × (1 + √2) × OD² × T × L × D) / 1000000",

            "Ring" =>
                "Material Weight = (π × (OD² - ID²) / 4 × L × D) / 1000000",

            _ => ""

        };
    }


