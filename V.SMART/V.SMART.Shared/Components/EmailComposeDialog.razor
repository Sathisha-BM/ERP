@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using V.SMART.Shared.ViewModels.EmailserviceVM
@using V.SMART.Shared.ViewModels.Mail

@inject EmailService EmailService
@inject IJSRuntime JS

<!-- ========================================================= -->
<!-- HEADER -->
<!-- ========================================================= -->

<TitleContent>

    <div class="gmail-dialog-header">

        <div class="gmail-title">
            <MudIcon Icon="@Icons.Material.Filled.Email"
                     Size="Size.Small"
                     Style="color:#1a73e8;" />

            <span>New Message</span>
        </div>

        <div class="gmail-header-actions">



           <MudIconButton Icon="@Icons.Material.Filled.Close"
               Size="Size.Small"
               Disabled="@isSending"
               OnClick="Cancel"
               Style="
                   background:#dc3545;
                   color:white;
                   border-radius:50%;
                   width:32px;
                   height:32px;"
               Tooltip="Close" title="Close"/>

        </div>

    </div>

</TitleContent>


<!-- ========================================================= -->
<!-- CONTENT -->
<!-- ========================================================= -->

<DialogContent>

    <div class="gmail-compose-container">

        <!-- =============================================== -->
        <!-- FROM -->
        <!-- =============================================== -->

        <div class="gmail-input-row">

            <input class="gmail-input"
                   value="@Model.FromEmail"
                   disabled="@(Model.IsDefaultMail)" title="From Mail"/>

        </div>


        <!-- =============================================== -->
        <!-- TO -->
        <!-- =============================================== -->

        <div class="gmail-input-row">

            <input class="gmail-input"
                   @bind="Model.To"
                   placeholder="Recipients" title="To Mail"/>

        </div>


        <!-- =============================================== -->
        <!-- CC / BCC -->
        <!-- =============================================== -->

        <div class="gmail-recipient-options">

            <button type="button"
                    class="gmail-link-button"
                    @onclick="ShowCc" title="Add CC">

                Cc

            </button>

            <button type="button"
                    class="gmail-link-button"
                    @onclick="ShowBcc" title="Add BCC">

                Bcc

            </button>

        </div>


        @if (showCc)
        {
            <div class="gmail-input-row">

                <input class="gmail-input"
                       @bind="Model.CC"
                       placeholder="Cc" title="Enter CC Mail" />

            </div>
        }


        @if (showBcc)
        {
            <div class="gmail-input-row">

                <input class="gmail-input"
                       @bind="Model.BCC"
                       placeholder="Bcc" title="Enter BCC Mail" />

            </div>
        }


        <!-- =============================================== -->
        <!-- SUBJECT -->
        <!-- =============================================== -->

        <div class="gmail-input-row">

            <input class="gmail-input"
                   @bind="Model.Subject"
                   placeholder="Subject" title="Subject" Disabled="@isSending" />

        </div>


        <!-- =============================================== -->
        <!-- EMAIL BODY -->
        <!-- =============================================== -->
        <div id="emailEditor"
             @ref="editorElement"
             class="gmail-editor"
             contenteditable="true"
             spellcheck="true"
             @onmouseup="SaveEditorSelection"
             @onkeyup="SaveEditorSelection"
             @oninput="SaveEditorSelection"   style="
         margin:0 !important;
         padding:12px 16px !important;
         text-align:left !important;
         width:100%;
         box-sizing:border-box;" Disabled="@isSending">

            @((MarkupString)InitialBody)

        </div>

        <!-- =============================================== -->
        <!-- ATTACHMENTS -->
        <!-- =============================================== -->

        @if (attachments.Any())
        {
            <div class="gmail-attachments">

                @foreach (var attachment in attachments)
                {
                    <div class="gmail-attachment">

                        <MudIcon Icon="@GetFileIcon(attachment.FileName)"
                                 Size="Size.Small"
                                 Style="color:#5f6368;" />

                        <div class="gmail-attachment-info">

                            <div class="gmail-attachment-name">
                                @attachment.FileName
                            </div>

                            <div class="gmail-attachment-size">
                                @GetFileSize(attachment.FileSize)
                            </div>

                        </div>

                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       Disabled="@isSending"
                                       OnClick="@(() => RemoveAttachment(attachment))"
                                       Style="color:#5f6368;"
                                       Tooltip="Remove attachment" title="Remove attachment" />

                    </div>
                }

            </div>
        }


        <!-- =============================================== -->
        <!-- HIDDEN FILE INPUT -->
        <!-- =============================================== -->

        <InputFile id="emailFileInput"
                   OnChange="HandleFileUpload"
                   multiple
                   accept=".pdf,.doc,.docx,.xls,.xlsx,.xlsm,.jpg,.jpeg,.png,.gif,.txt,.zip,.rar,.7z"
                   style="display:none;" title="Attachment" Disabled="@isSending" />

    </div>

</DialogContent>


<!-- ========================================================= -->
<!-- FOOTER / GMAIL TOOLBAR -->
<!-- ========================================================= -->

<DialogActions>

    <div class="gmail-footer">

        <!-- =============================================== -->
        <!-- FORMATTING TOOLBAR -->
        <!-- =============================================== -->

        <div class="gmail-toolbar">

            <!-- UNDO -->

            <MudIconButton Icon="@Icons.Material.Filled.Undo"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("undo"))"
                           Tooltip="Undo" title="Undo" />


            <!-- REDO -->

            <MudIconButton Icon="@Icons.Material.Filled.Redo"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("redo"))"
                           Tooltip="Redo" title="Redo"  />


            <span class="gmail-divider"></span>


            <!-- FONT FAMILY -->

            <select class="gmail-font-select"
                    @onchange="ChangeFontFamily" title="Fonts" Disabled="@isSending">

                <!-- Sans Serif -->
                <option value="Arial">Sans Serif</option>
                <option value="Arial">Arial</option>
                <option value="Helvetica">Helvetica</option>
                <option value="Verdana">Verdana</option>
                <option value="Tahoma">Tahoma</option>
                <option value="Trebuchet MS">Trebuchet MS</option>
                <option value="Calibri">Calibri</option>
                <option value="Segoe UI">Segoe UI</option>
                <option value="Roboto">Roboto</option>

                <!-- Serif -->
                <option value="Georgia">Georgia</option>
                <option value="Times New Roman">Times New Roman</option>
                <option value="Cambria">Cambria</option>
                <option value="Garamond">Garamond</option>
                <option value="Palatino Linotype">Palatino Linotype</option>

                <!-- Monospace -->
                <option value="Courier New">Courier New</option>
                <option value="Consolas">Consolas</option>
                <option value="Lucida Console">Lucida Console</option>

                <!-- Other -->
                <option value="Impact">Impact</option>
                <option value="Arial Black">Arial Black</option>
                <option value="Comic Sans MS">Comic Sans MS</option>
                <option value="Franklin Gothic Medium">Franklin Gothic Medium</option>
                <option value="Century Gothic">Century Gothic</option>
                <option value="Book Antiqua">Book Antiqua</option>

            </select>


            <!-- FONT SIZE -->

            <select class="gmail-font-size"
                    @onchange="ChangeFontSize" title="FontSize" Disabled="@isSending">

                <option value="2">
                    Small
                </option>

                <option value="3" selected>
                    Normal
                </option>

                <option value="4">
                    Large
                </option>

                <option value="5">
                    Huge
                </option>

            </select>


            <span class="gmail-divider"></span>


            <!-- BOLD -->

            <MudIconButton Icon="@Icons.Material.Filled.FormatBold"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("bold"))"
                           Tooltip="Bold" title="Bold" />


            <!-- ITALIC -->

            <MudIconButton Icon="@Icons.Material.Filled.FormatItalic"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("italic"))"
                           Tooltip="Italic" title="Italic" />


            <!-- UNDERLINE -->

            <MudIconButton Icon="@Icons.Material.Filled.FormatUnderlined"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("underline"))"
                           Tooltip="Underline" title="Underline" />


            <!-- TEXT COLOR -->

            <label class="gmail-color-button"
                   title="Text color">

                <MudIcon Icon="@Icons.Material.Filled.FormatColorText"
                         Size="Size.Small" Tooltip="Text color" Title="Text color" />

                <input type="color"
                       value="#202124"
                       @onchange="ChangeTextColor" title="color" />

            </label>


            <span class="gmail-divider"></span>


            <!-- ALIGN -->

            <MudIconButton Icon="@Icons.Material.Filled.FormatAlignLeft"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("justifyLeft"))"
                           Tooltip="Align left" title="Align left" />


            <MudIconButton Icon="@Icons.Material.Filled.FormatAlignCenter"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("justifyCenter"))"
                           Tooltip="Align center" title="Align center" />


            <MudIconButton Icon="@Icons.Material.Filled.FormatAlignRight"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("justifyRight"))"
                           Tooltip="Align right" title="Align right" />


            <!-- BULLET -->

            <MudIconButton Icon="@Icons.Material.Filled.FormatListBulleted"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("insertUnorderedList"))"
                           Tooltip="Bulleted list" title="Bulleted list" />


            <!-- NUMBER -->

            <MudIconButton Icon="@Icons.Material.Filled.FormatListNumbered"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("insertOrderedList"))"
                           Tooltip="Numbered list" title="Numbered list" />


            <span class="gmail-divider"></span>


            <!-- LINK -->

            <MudIconButton Icon="@Icons.Material.Filled.Link"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="InsertLink"
                           Tooltip="Insert link" title="Insert link" />


            <!-- EMOJI -->

            <MudMenu Icon="@Icons.Material.Filled.EmojiEmotions"
                     Size="Size.Small"
                     Disabled="@isSending"
                     AnchorOrigin="Origin.BottomLeft"
                     TransformOrigin="Origin.TopLeft" Tooltip="Emojis">

                <MudPaper Class="gmail-emoji-panel" Tooltip="Emojis">

                    <div class="gmail-emoji-grid">

                        @foreach (var emoji in Emojis)
                        {
                            <button type="button"
                                    class="gmail-emoji"
                                    @onclick="(() => InsertEmoji(emoji))">

                                @emoji

                            </button>
                        }

                    </div>

                </MudPaper>

            </MudMenu>


            <!-- ATTACHMENT -->

            <label for="emailFileInput"  class="gmail-attach-button"  title="Attach files">

                <MudIcon Icon="@Icons.Material.Filled.AttachFile"
                         Size="Size.Small" />

            </label>


            <!-- CLEAR FORMAT -->

            <MudIconButton Icon="@Icons.Material.Filled.FormatClear"
                           Size="Size.Small"
                           Disabled="@isSending"
                           OnClick="@(() => ExecCommand("removeFormat"))"
                           Tooltip="Remove formatting" title="formatting files" />

        </div>


        <!-- =============================================== -->
        <!-- SEND SECTION -->
        <!-- =============================================== -->

        <div class="gmail-send-row">

            <MudButton Variant="Variant.Filled"
                       Disabled="@isSending"
                       OnClick="SendEmail"
                       Class="gmail-send-button" title="SendEmail">

                @if (isSending)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true"
                                         Style="color:white;"
                                         Class="me-2" />

                    <span>Please wait Sending...</span>
                }
                else
                {
                    <span>Send</span>

                    <span class="gmail-send-arrow">
                        ▾
                    </span>
                }

            </MudButton>


            <MudButton Variant="Variant.Text"
                       Disabled="@isSending"
                       OnClick="Cancel"
                       Class="gmail-discard-button">

                Discard

            </MudButton>

        </div>

    </div>

</DialogActions>


