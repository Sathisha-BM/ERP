    // =========================================================
    // LINK
    // =========================================================

    private async Task InsertLink()
    {
        var url =
            await JS.InvokeAsync<string?>(
                "prompt",
                "Enter URL:");

        if (string.IsNullOrWhiteSpace(url))
            return;


        await JS.InvokeVoidAsync(
            "emailEditor.createLink",
            editorElement,
            url);
    }


