@code {

    // =========================================================
    // PARAMETERS
    // =========================================================

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public EmailComposeVM Model { get; set; } = new();


    // =========================================================
    // VARIABLES
    // =========================================================

    private bool isSending;

    private bool showCc;

    private bool showBcc;

    private ElementReference editorElement;

    private string InitialBody = "";

    private List<EmailAttachment> attachments = new();


    protected override void OnInitialized()
    {
        InitialBody = Model.Body ?? "";
       //   var lines = (Model.Body ?? "")
       //  .Split(new[] { "\r\n", "\r", "\n" },
       //         StringSplitOptions.RemoveEmptyEntries)
       //  .Select(x => x.Trim())
       //  .Where(x => !string.IsNullOrWhiteSpace(x));

       // InitialBody = string.Join("<br>", lines);
        // Existing invoice PDF
        if (Model.AttachmentBytes != null &&
            Model.AttachmentBytes.Length > 0 &&
            !string.IsNullOrWhiteSpace(Model.AttachmentName))
        {
            attachments.Add(new EmailAttachment
            {
                FileName = Model.AttachmentName,
                FileBytes = Model.AttachmentBytes,
                FileSize = Model.AttachmentBytes.Length,
                ContentType = "application/pdf"
            });
        }

        if (!string.IsNullOrWhiteSpace(Model.CC))
            showCc = true;

        if (!string.IsNullOrWhiteSpace(Model.BCC))
            showBcc = true;
    }


    // =========================================================
    // CC / BCC
    // =========================================================

    private void ShowCc()
    {
        showCc = true;
    }

    private void ShowBcc()
    {
        showBcc = true;
    }


    // =========================================================
    // SEND EMAIL
    // =========================================================

    private async Task SendEmail()
    {
        try
        {
            Model.Body = await JS.InvokeAsync<string>(
                "emailEditor.getHtml",
                editorElement);


            if (string.IsNullOrWhiteSpace(Model.To))
            {
                await JS.ToastrError(
                    "Please enter recipient email.");

                return;
            }


            if (string.IsNullOrWhiteSpace(Model.Subject))
            {
                await JS.ToastrError(
                    "Please enter email subject.");

                return;
            }


            if (attachments.Count == 0)
            {
                await JS.ToastrError(
                    "Please attach at least one file.");

                return;
            }


            isSending = true;

            StateHasChanged();


            // =================================================
            // SEND MULTIPLE ATTACHMENTS
            // =================================================

            var emailAttachments =
                attachments.Select(x => new EmailAttachment
                {
                    FileName = x.FileName,
                    FileBytes = x.FileBytes,
                    ContentType = x.ContentType
                }).ToList();


            var result =
                await EmailService.SendEmailAsync(
                    Model.To,
                    Model.CC,
                    Model.BCC,
                    Model.Subject,
                    Model.Body,
                    emailAttachments);


            if (result.Success)
            {
                await JS.ToastrSuccess(
                    "Email sent successfully.");

                MudDialog.Close(
                    DialogResult.Ok(true));

                return;
            }


            await JS.ToastrError(
                string.IsNullOrWhiteSpace(result.Message)
                    ? "Failed to send email."
                    : result.Message);
        }
        catch (Exception ex)
        {
            await JS.ToastrError(
                "Email sending failed: " + ex.Message);
        }
        finally
        {
            isSending = false;

            StateHasChanged();
        }
    }


    // =========================================================
    // FILE UPLOAD - MULTIPLE
    // =========================================================

    private async Task HandleFileUpload(
        InputFileChangeEventArgs e)
    {
        try
        {
            const long maxFileSize =
                10 * 1024 * 1024;


            var files =
                e.GetMultipleFiles(20);


            foreach (var file in files)
            {
                // ---------------------------------------------
                // SIZE
                // ---------------------------------------------

                if (file.Size > maxFileSize)
                {
                    await JS.ToastrError(
                        $"'{file.Name}' exceeds the 10 MB limit.");

                    continue;
                }


                // ---------------------------------------------
                // DUPLICATE
                // ---------------------------------------------

                if (attachments.Any(x =>
                    x.FileName.Equals(
                        file.Name,
                        StringComparison.OrdinalIgnoreCase)))
                {
                    continue;
                }


                // ---------------------------------------------
                // READ
                // ---------------------------------------------

                using var stream =
                    file.OpenReadStream(maxFileSize);

                using var memory =
                    new MemoryStream();

                await stream.CopyToAsync(memory);


                // ---------------------------------------------
                // ADD
                // ---------------------------------------------

                attachments.Add(
                    new EmailAttachment
                    {
                        FileName = file.Name,

                        FileBytes =
                            memory.ToArray(),

                        FileSize =
                            file.Size,

                        ContentType =
                            string.IsNullOrWhiteSpace(
                                file.ContentType)
                                ? "application/octet-stream"
                                : file.ContentType
                    });
            }


            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.ToastrError(
                "Failed to attach file: " + ex.Message);
        }
    }


    // =========================================================
    // REMOVE ATTACHMENT
    // =========================================================

    private void RemoveAttachment(
        EmailAttachment attachment)
    {
        if (isSending)
            return;

        attachments.Remove(attachment);

        StateHasChanged();
    }


    // =========================================================
    // FILE ICON
    // =========================================================

    private string GetFileIcon(string fileName)
    {
        var extension =
            Path.GetExtension(fileName)
                .ToLowerInvariant();

        return extension switch
        {
            ".pdf" =>
                Icons.Material.Filled.PictureAsPdf,

            ".doc" or ".docx" =>
                Icons.Material.Filled.Description,

            ".xls" or ".xlsx" or ".xlsm" =>
                Icons.Material.Filled.TableChart,

            ".jpg" or ".jpeg" or
            ".png" or ".gif" =>
                Icons.Material.Filled.Image,

            ".zip" or ".rar" or ".7z" =>
                Icons.Material.Filled.FolderZip,

            ".txt" =>
                Icons.Material.Filled.Description,

            _ =>
                Icons.Material.Filled.AttachFile
        };
    }


    // =========================================================
    // FILE SIZE
    // =========================================================

    private string GetFileSize(long bytes)
    {
        string[] sizes =
        {
            "B",
            "KB",
            "MB",
            "GB"
        };

        double len = bytes;

        int order = 0;

        while (len >= 1024 &&
               order < sizes.Length - 1)
        {
            order++;

            len /= 1024;
        }

        return $"{len:0.##} {sizes[order]}";
    }


