@using MudBlazor
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.EmailserviceVM
@using V.SMART.Shared.ViewModels.Mail
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.ExpInv_VM

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IExpInvService _expInvService
@inject ILoggingService LoggingService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject EmailService EmailService
@inject IDialogService DialogService
@inject ReportService reportService


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    window.showUpdateConfirm = async function () {
        const result = await Swal.fire({
            title: 'Update Export Details?',
            text: "Do you want to continue?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Update!',
            cancelButtonText: 'Cancel'
        });

        return result.isConfirmed;
    }
</script>


<div class="container-fluid px-2 px-md-5 mt-3">

    <div class="card shadow-sm border">
        <div class="card-body p-3">
            <div class="row g-3 mb-2">

                <div class="col-12">

                    <!-- Country of Origin -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Country of Origin</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.CountryOfOrigin" />
                        </div>
                    </div>

                    <!-- Country of Destination -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Country of Destination</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.CountryOfDestination" />
                        </div>
                    </div>

                    <!-- Pre-Carriage -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Pre-Carriage By</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.PreCarriage" />
                        </div>
                    </div>

                    <!-- Place of Receipt -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Place of Receipt</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.PlaceOfReceipt" />
                        </div>
                    </div>

                    <!-- Vessel / Flight -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Flight / Vessel No</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.FlightOrVesselNo" />
                        </div>
                    </div>

                    <!-- Port of Loading -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Port of Loading</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.PortOfLoading" />
                        </div>
                    </div>

                    <!-- Port of Discharge -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Port of Discharge</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.PortOfDischarge" />
                        </div>
                    </div>

                    <!-- Final Destination -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Final Destination</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.FinalDestination" />
                        </div>
                    </div>

                    <!-- Net Weight -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Net Weight</small>
                        </label>
                        <div class="col-sm-8">
                            <InputNumber class="form-control form-control-sm rounded-3 w-100"
                                         @bind-Value="ExpInvVM.NetWeight" />
                        </div>
                    </div>

                    <!-- Gross Weight -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Gross Weight</small>
                        </label>
                        <div class="col-sm-8">
                            <InputNumber class="form-control form-control-sm rounded-3 w-100"
                                         @bind-Value="ExpInvVM.GrossWeight" />
                        </div>
                    </div>

                    <!-- Package Details -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Package Details</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.PackageDetails" />
                        </div>
                    </div>

                    <!-- Kind of Packing -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Kind of Packing</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.DocketNumber" />
                        </div>
                    </div>

                    <!-- Transporter Name -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Transporter Name</small>
                        </label>
                        <div class="col-sm-8">
                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                       @bind-Value="ExpInvVM.TransporterName" />
                        </div>
                    </div>

                    <!-- Transporter Address -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Transporter Address</small>
                        </label>
                        <div class="col-sm-8">
                            <InputTextArea class="form-control form-control-sm rounded-3 w-100" rows="1"
                                           @bind-Value="ExpInvVM.TransporterAddress" />
                        </div>
                    </div>

                    <!-- Component Type -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>Component Type</small>
                        </label>
                        <div class="col-sm-8">
                            <InputSelect class="form-control form-control-sm rounded-3 w-100"
                                         @bind-Value="ExpInvVM.CompanyType">
                                <option value="">-- Select --</option>
                                <option value="Auto Components">Auto Components</option>
                                <option value="Machinery">Machinery</option>
                            </InputSelect>
                        </div>
                    </div>

                    <!-- IncoTerms -->
                    <div class="row mb-1 align-items-center">
                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                            <small>IncoTerms</small>
                        </label>
                        <div class="col-sm-8">
                            <InputSelect class="form-control form-control-sm rounded-3 w-100"
                                         @bind-Value="ExpInvVM.Incoterm">
                                <option value="">-- Select --</option>
                                <option value="EXW">EXW </option>
                                <option value="FCA">FCA</option>
                                <option value="CPT">CPT</option>
                                <option value="CIP">CIP </option>
                                <option value="DAP">DAP </option>
                                <option value="DPU">DPU </option>
                                <option value="DDP">DDP </option>
                                <option value="FAS">FAS </option>
                                <option value="FOB">FOB </option>
                                <option value="CFR">CFR </option>
                                <option value="CIF">CIF </option>
                            </InputSelect>
                        </div>
                    </div>

                </div>



                <div class="col-12 col-md-3 mt-4">
                    <label class="text-danger">
                        <input class="form-check-input border border-2 border-danger" type="checkbox"
                               @bind="exportInvoice" @bind:after="OnExportChanged" /> Export Invoice
                    </label>
                </div>

                <div class="col-12 col-md-3 mt-4">
                    <label class="text-danger">
                        <input class="form-check-input border border-2 border-danger" type="checkbox"
                               @bind="packingSlip" @bind:after="OnPackingChanged" /> Packing Slip
                    </label>
                </div>

                <div class="col-12 col-md-3 mt-4">

                    <button type="button" class="btn btn-sm btn-primary w-100 rounded-3 rounded-3" @onclick='() => updateExport()'>
                        <i class="bi bi-person-add me-1"></i> Update
                    </button>

                </div>

                <div class="col-12 col-md-3 mt-4">

                    <button type="button" class="btn btn-sm btn-success w-100 rounded-3 rounded-3" @onclick='() => GenerateAndOpenPdf(packingSlip)'>
                        <i class="bi bi-person-add me-1"></i> Print
                    </button>

                </div>
                @if (emailSettings != null && emailSettings.IsDefaultMail)
                {
                    <div class="col-12 col-md-3 mt-4">

                        <button class="btn btn-outline-danger"
                                @onclick='() => GenerateAndOpenEmail(packingSlip)'>
                            <i class="bi bi-envelope-fill me-2"></i>
                            Email
                        </button>
                    </div>
                }


            </div>

        </div>
    </div>
</div>


@code
{
    protected override string ScreenName => "Export Invoice";

    [Parameter] public int ExpInvId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public bool isExportDetailsModelVisible { get; set; } = false;

    private bool isProcessing;
    private ExpInvVM ExpInvVM { get; set; } = new();

    private bool exportInvoice = true;
    private bool packingSlip = false;

    public EmailSettings emailSettings { get; set; } = new();
    private string? pdfBase64 { get; set; } = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            await LoadExistingInvoice(ExpInvId);
            emailSettings = await EmailService.GetCurrentUserEmailSettingsAsync();

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ExportInvModel Init Failed");
        }
    }

    private async Task LoadExistingInvoice(int expInvId)
    {
        try
        {
            var list = await _expInvService.GetPackingInvoiceDetailsAsync(expInvId);
            ExpInvVM = list.FirstOrDefault() ?? new ExpInvVM();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load Export Invoice details");
            await LoggingService.LogDeveloperError(ex, $"ExpInvId: {expInvId}");
        }
    }

    private void OnExportChanged()
    {
        if (exportInvoice)
            packingSlip = false;
    }

    private void OnPackingChanged()
    {
        if (packingSlip)
            exportInvoice = false;
    }

    public async Task updateDetailsAsync()
    {
        if (ExpInvVM == null)
            return;

        try
        {
            await _expInvService.UpdatePackingInvoiceDetailsAsync(ExpInvVM);
        }
        catch (Exception ex)
        {
            await _js.ToastrError(ex.Message);
            return;
        }
        await _js.ToastrSuccess("Export Details updated successfully.");



    }

    private async Task updateExport()
    {
        try
        {
            bool confirmed = await _js.InvokeAsync<bool>("showUpdateConfirm");

            if (!confirmed)
                return;

            await updateDetailsAsync();
            await CloseModal();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error while updating");
            await LoggingService.LogDeveloperError(ex, "updateExport error");
        }
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task GenerateAndOpenPdf(bool isPackList)
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(
                ExpInvId,
                isPackList ? "PackList.frx" : "ExportInvoice.frx",
                "ExpInvId",
                ExpInvVM.IsCancel,
                isPackList ? "Pack List" : "Export Invoice",
                isPackList ? "Sp_Print_PackList" : "Sp_ExportInv"
            );

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "Error while generating PDF"
            );

            await _js.ToastrError(
                "An unexpected error occurred while generating the PDF."
            );
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task GenerateAndOpenEmail(bool isPackList)
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;



            if (emailSettings == null)
            {
                await _js.ToastrError(
                    "Email settings are not configured for the current user.");

                return;
            }

            if (string.IsNullOrWhiteSpace(emailSettings.SenderEmail))
            {
                await _js.ToastrError(
                    "Sender email is not configured.");

                return;
            }
            if (string.IsNullOrWhiteSpace(emailSettings.SenderEmail))
            {

                await _js.ToastrError("Sender email is not configured.");

                return;

            }

            if (string.IsNullOrWhiteSpace(emailSettings.SmtpServer))
            {
                await _js.ToastrError("SMTP server is not configured.");

                return;
            }



            if (emailSettings.Port <= 0)
            {
                await _js.ToastrError("SMTP port is not configured.");

                return;

            }

            if (string.IsNullOrWhiteSpace(emailSettings.UserName))
            {
                await _js.ToastrError("SMTP username is not configured.");

                return;
            }


            if (string.IsNullOrWhiteSpace(emailSettings.Password))
            {
                await _js.ToastrError("SMTP password is not configured.");

                return;
            }


            if (string.IsNullOrWhiteSpace(ExpInvVM.Email))
            {
                await _js.ToastrError("Customer Email is not configured.");

                return;
            }


            var pdfBytes = await reportService.Generate_Report(ExpInvId,isPackList ? "PackList.frx" : "ExportInvoice.frx","ExpInvId",ExpInvVM.IsCancel,isPackList ? "Pack List" : "Export Invoice",isPackList ? "Sp_Print_PackList" : "Sp_ExportInv");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            string Subject = $"Export Invoice No: {(string.IsNullOrEmpty(ExpInvVM.Prefix) ? "" : ExpInvVM.Prefix + "/")}{ExpInvVM.ExpInvNo}{ExpInvVM.Suffix ?? ""}";

            var model = new EmailComposeVM
            {
                IsDefaultMail = emailSettings.IsDefaultMail,

                FromEmail = emailSettings.SenderEmail,

                To = ExpInvVM.Email,

                CC = "",

                BCC = "",

                // Subject
                Subject = Subject,


                Body = $"Dear {ExpInvVM.CustName}<br><br>" +
                $"Greetings!!<br><br>" +
                $"Please find attached Export Invoice.<br>" +
                $"Export Invoice No :{Subject}<br>" +
                $"Export Invoice Date : {ExpInvVM.ExpInvDate:dd/MM/yyyy}<br><br>" +
                $"Thank you.<br><br>" +
                $"Regards,<br>" +
                $"{emailSettings.SenderName}",


                // PDF
                AttachmentBytes = pdfBytes,

                AttachmentName = $"{Subject}.pdf"
            };


            var parameters = new DialogParameters
             {
                 {
                     nameof(EmailComposeDialog.Model),
                     model
                 }
             };

            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseButton = true,
                BackdropClick = false,
                NoHeader = true,
            };

            await DialogService.ShowAsync<EmailComposeDialog>(
                "New Message",
                parameters,
                options);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "Error in GenerateAndOpenEmail Export Invoice");

            await _js.ToastrError(
                "An unexpected error occurred while generating the email.");
        }
        finally
        {
            isProcessing = false;
        }
    }


}
