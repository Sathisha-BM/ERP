        }

            .backup-actions .btn {
                height: 38px;
                padding: 0 18px;
                border-radius: 7px;
                font-size: 13px;
                font-weight: 500;
            }

        .backup-btn-primary {
            background: #4d79a8;
            border: 1px solid #4d79a8;
            color: white;
        }

            .backup-btn-primary:hover {
                background: #3f668e;
                border-color: #3f668e;
                color: white;
            }

        .backup-btn-success {
            background: #2f8f5b;
            border: 1px solid #2f8f5b;
            color: white;
        }

            .backup-btn-success:hover {
                background: #267849;
                border-color: #267849;
                color: white;
            }

        .backup-btn-secondary {
            background: white;
            border: 1px solid #d4dae2;
            color: #5d6b7a;
