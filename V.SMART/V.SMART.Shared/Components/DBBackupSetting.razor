        }

            .backup-section:last-of-type {
                border-bottom: none;
            }

        .backup-section-title {
            margin-bottom: 15px;
            color: #34495e;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

