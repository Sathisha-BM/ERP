            }

        .backup-browse-button {
            height: 38px;
            background: #edf2f7;
            border: 1px solid #d3dae3;
            color: #42566d;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 500;
        }

            .backup-browse-button:hover {
                background: #e2e8f0;
                color: #26364a;
            }

        .backup-help-text {
            margin-top: 5px;
            color: #8793a1;
            font-size: 11px;
        }

            .backup-help-text i {
                margin-right: 4px;
            }

        .backup-enable-box {
            min-height: 72px;
