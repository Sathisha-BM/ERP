        }

        @@media (max-width: 768px) {

            .backup-page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .backup-card-body {
                padding: 16px;
            }

            .last-backup-panel {
                grid-template-columns: 1fr;
            }

            .backup-actions {
                flex-direction: column;
            }

                .backup-actions .btn {
                    width: 100%;
                }
        }

    </style>
    
}



@code {


    private bool isProcessing = true;
    private DBBackupSettingVM Model = new();

    private DBBackupSettingVM? OriginalModel;

    private bool IsSaving;

    private bool IsBackingUp;

    private string SystemName = Environment.MachineName;

    private string Message = string.Empty;

    private string MessageCss = "alert-info";

    private string MessageIcon = "bi bi-info-circle";


    // UI list only.
    // No extra Model/ViewModel.
    private List<string> BackupPaths = new();

    private string BackupTime = string.Empty;

    private void OnBackupTimeChanged(ChangeEventArgs e)
    {
        BackupTime = e.Value?.ToString() ?? string.Empty;

        if (TimeOnly.TryParseExact(
            BackupTime,
            "HH:mm",
            out var time))
        {
            Model.BackupTime = time;
        }
        else
        {
            Model.BackupTime = null;
        }
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadSettings();
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
        }

    }


    private async Task LoadSettings()
    {
        try
        {
            Message = string.Empty;

            // Replace with your actual SystemId
            int systemId = 2;

            var result =await DBBackupSettingService.GetBySystemIdAsync(systemId);

            if (result != null)
            {
                Model = result;

                await LoadBackupPaths();

                OriginalModel = new DBBackupSettingVM
                {
                    Id = result.Id,
                    SystemId = result.SystemId,
                    DatabaseName = result.DatabaseName,
                    BackupPath = result.BackupPath,
                    BackupType = result.BackupType,
                    Frequency = result.Frequency,
                    BackupTime = result.BackupTime,
                    RetentionDays = result.RetentionDays,
                    IsEnabled = result.IsEnabled,
                    LastBackupDate = result.LastBackupDate,
                    LastBackupFile = result.LastBackupFile,
                    LastBackupStatus = result.LastBackupStatus,
                    LastBackupMessage = result.LastBackupMessage
                };
            }
            else
            {
                Model = new DBBackupSettingVM
                {
                    SystemId = systemId,
                    DatabaseName = string.Empty,
                    BackupType = "FULL",
                    Frequency = "DAILY",
                    RetentionDays = 30,
                    IsEnabled = true
                };

                BackupPaths = new List<string>();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error while in LoadSettings method");
            await _js.ToastrError("Failed to load LoadSettings method()");
        }
    }


    private async Task LoadBackupPaths()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Model.BackupPath))
            {
                BackupPaths = new List<string>();
                return;
            }

            BackupPaths = Model.BackupPath
                .Split(
                    ';',
                    StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToList();

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error while in LoadBackupPaths method");
            await _js.ToastrError("Failed to load LoadBackupPaths method()");
        }
    }


    private void AddBackupPath()
    {
        BackupPaths.Add(string.Empty);
    }


    private void RemoveBackupPath(int index)
    {
        if (index >= 0 && index < BackupPaths.Count)
        {
            BackupPaths.RemoveAt(index);
        }
    }


    private void PrepareBackupPaths()
    {
        BackupPaths = BackupPaths
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        Model.BackupPath =string.Join(";", BackupPaths);
    }


    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(Model.DatabaseName))
        {
            await _js.ToastrWarning("Please enter database name.");
            return;
        }


        PrepareBackupPaths();


        if (BackupPaths.Count == 0)
        {
            await _js.ToastrWarning("Please enter at least one backup path.");
            return;
        }


        if (Model.RetentionDays <= 0)
        {
            await _js.ToastrWarning("Retention days must be greater than zero.");
            return;
        }


        try
        {
            isProcessing = true;

            Model =await DBBackupSettingService.SaveAsync(Model);

            await LoadBackupPaths();

            await _js.ToastrWarning("Backup settings saved successfully.");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error while in Save  method");
            await LoggingService.LogDeveloperError(ex, "Error while in Save method");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task BackupNow()
    {
         PrepareBackupPaths();
        if (BackupPaths.Count == 0)
        {
            await _js.ToastrError("Please configure at least one backup path first.");

            return;
        }

        if (string.IsNullOrWhiteSpace(Model.DatabaseName))
        {
            await _js.ToastrWarning("Please configure database name first.");

            return;
        }


        try
        {
            IsBackingUp = true;

            var sourceBackupPath = GetSourceBackupPath();
            await DBBackupSettingService.BackupDatabaseToClientPathsAsync(sourceBackupPath,Model.BackupPath,Model.RetentionDays);

            Model.LastBackupDate = DateTime.Now;
            Model.LastBackupStatus = "SUCCESS";
            Model.LastBackupFile = "Latest backup";
            Model.LastBackupMessage = "Backup copied successfully to all configured paths.";
           

            await Task.Delay(500);

            Model.LastBackupDate = DateTime.Now;

            Model.LastBackupStatus = "SUCCESS";

            Model.LastBackupMessage ="Backup completed successfully.";


            await _js.ToastrSuccess("Database backup completed successfully.");
        }
        catch (Exception ex)
        {
            Model.LastBackupDate = DateTime.Now;
            Model.LastBackupStatus = "FAILED";
            Model.LastBackupMessage = ex.Message;


            await _js.ToastrWarning($"Database backup failed: {ex.Message}");
        }
        finally
        {
            IsBackingUp = false;
        }
    }

    private string GetSourceBackupPath()
    {
        var configuredPath = _configuration["DatabaseBackup:BackupFolder"];

        if (string.IsNullOrWhiteSpace(configuredPath))
            throw new Exception("Database backup folder is not configured.");

        return Environment.ExpandEnvironmentVariables(configuredPath);
    }


    private async Task BrowseBackupFolder()
    {
        await Task.CompletedTask;
    }


    private async Task Reset()
    {
        try
        {
            if (OriginalModel != null)
            {
                Model = new DBBackupSettingVM
                {
                    Id = OriginalModel.Id,
                    SystemId = OriginalModel.SystemId,
                    DatabaseName = OriginalModel.DatabaseName,
                    BackupPath = OriginalModel.BackupPath,
                    BackupType = OriginalModel.BackupType,
                    Frequency = OriginalModel.Frequency,
                    BackupTime = OriginalModel.BackupTime,
                    RetentionDays = OriginalModel.RetentionDays,
                    IsEnabled = OriginalModel.IsEnabled,
                    LastBackupDate = OriginalModel.LastBackupDate,
                    LastBackupFile = OriginalModel.LastBackupFile,
                    LastBackupStatus = OriginalModel.LastBackupStatus,
                    LastBackupMessage = OriginalModel.LastBackupMessage
                };

                await LoadBackupPaths();
            }
            else
            {
                Model = new DBBackupSettingVM();

                BackupPaths = new List<string>();
            }

            Message = string.Empty;

        }
        catch (Exception ex)
        {
            
            await LoggingService.LogDeveloperError(ex, "Error while in Reset method");
            await _js.ToastrError("Failed to load Reset method()");
        }
    }



}