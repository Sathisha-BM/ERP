@page "/database-backup-settings"

@using Microsoft.Extensions.Configuration
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IDBBackupSetting_Service
@using V.SMART.Shared.ViewModels.BackupSettingVM
@using V.SMART.Shared.Services.Database_Backup

@inject ILoggingService LoggingService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject IDBBackupSettingService DBBackupSettingService
@inject IConfiguration _configuration

<PageTitle>Database Backup Settings</PageTitle>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    <div class="backup-page">

        <!-- ================= PAGE HEADER ================= -->

        <div class="backup-page-header">

            <div class="backup-title-section">

                <div class="backup-title-icon">
                    <i class="bi bi-database-fill-check"></i>
                </div>

                <div>
                    <h4>Database Backup Settings</h4>
                    <span>Configure client system database backup</span>
                </div>

            </div>

            <div class="backup-status">

                @if (Model.IsEnabled)
                {
                    <span class="backup-status-badge enabled">
                        <i class="bi bi-check-circle-fill"></i>
                        Backup Enabled
                    </span>
                }
                else
                {
                    <span class="backup-status-badge disabled">
                        <i class="bi bi-pause-circle-fill"></i>
                        Backup Disabled
                    </span>
                }

            </div>

        </div>


        <!-- ================= MAIN CARD ================= -->

        <div class="backup-card">

            <div class="backup-card-header">

                <div>
                    <i class="bi bi-gear-fill"></i>
                    Backup Configuration
                </div>

                <small>
                    Client System
                </small>

            </div>


            <div class="backup-card-body">

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="alert @MessageCss mb-4">
                        <i class="@MessageIcon"></i>
                        @Message
                    </div>
                }


                <!-- ================= DATABASE ================= -->

                <div class="backup-section">

                    <div class="backup-section-title">
                        <i class="bi bi-database"></i>
                        Database Information
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="backup-label">
                                System
                            </label>

                            <input type="text"
                                   class="form-control backup-input"
                                   value="@SystemName"
                                   readonly />

                        </div>


                        <div class="col-md-6">

                            <label class="backup-label">
                                Database Name
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   class="form-control backup-input"
                                   @bind="Model.DatabaseName"
                                   placeholder="Enter database name" />

                        </div>

                    </div>

                </div>


                <!-- ================= BACKUP LOCATION ================= -->

                <div class="backup-section">

                    <div class="backup-section-title">

                        <i class="bi bi-folder-fill"></i>

                        Backup Location

                    </div>


                    <div class="backup-help-text mb-3">

                        <i class="bi bi-info-circle"></i>

                        Add one or more backup locations.

                    </div>


                    <div class="table-responsive">

                        <table class="table table-bordered backup-path-table">

                            <thead>

                                <tr>

                                    <th style="width:70px;">
                                        SlNo
                                    </th>

                                    <th>
                                        Database Path
                                    </th>

                                    <th style="width:100px;">
                                        Action
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @if (BackupPaths.Count == 0)
                                {
                                    <tr>

                                        <td colspan="3"
                                            class="text-center text-muted">

                                            No backup path configured.

                                        </td>

                                    </tr>
                                }
                                else
                                {
                                    @for (int i = 0; i < BackupPaths.Count; i++)
                                    {
                                        int index = i;

                                        <tr>

                                            <td class="text-center">
                                                @(index + 1)
                                            </td>

                                            <td>

                                                <input type="text"
                                                       class="form-control backup-input"
                                                       @bind="BackupPaths[index]"
                                                       placeholder="Example: E:\" />

                                            </td>

                                            <td class="text-center">

                                                <button type="button"
                                                        class="btn btn-sm btn-danger"
                                                        @onclick="() => RemoveBackupPath(index)"
                                                        title="Remove">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>


                    <button type="button"
                            class="btn backup-browse-button"
                            @onclick="AddBackupPath">

                        <i class="bi bi-plus-circle"></i>

                        Add Backup Path

                    </button>


                    <div class="backup-help-text mt-2">

                        <i class="bi bi-info-circle"></i>

                        Example: E:\, D:\, F:\

                    </div>

                </div>


                <!-- ================= SCHEDULE ================= -->

                <div class="backup-section">

                    <div class="backup-section-title">

                        <i class="bi bi-calendar-check"></i>

                        Backup Schedule

                    </div>


                    <div class="row g-3">

                        <!-- Backup Type -->

                        <div class="col-md-4">

                            <label class="backup-label">
                                Backup Type
                            </label>

                            <select class="form-select backup-input"
                                    @bind="Model.BackupType">

                                <option value="FULL">
                                    Full Backup
                                </option>

                            </select>

                        </div>


                        <!-- Frequency -->

                        <div class="col-md-4">

                            <label class="backup-label">
                                Frequency
                            </label>

                            <select class="form-select backup-input"
                                    @bind="Model.Frequency">

                                <option value="DAILY">
                                    Daily
                                </option>

                                <option value="WEEKLY">
                                    Weekly
                                </option>

                                <option value="MONTHLY">
                                    Monthly
                                </option>

                            </select>

                        </div>


                        <!-- Backup Time -->

                        <div class="col-md-4">
                            <label class="backup-label">
                                <i class="bi bi-clock"></i>
                                Backup Time
                            </label>

                            <input type="time"
                                   class="form-control backup-input"
                                   value="@BackupTime"
                                   @onchange="OnBackupTimeChanged" />
                        </div>

                    </div>


                    <div class="row g-3 mt-1">

                        <!-- Enable Backup -->

                        <div class="col-md-8">

                            <div class="backup-enable-box">

                                <div class="backup-enable-icon">

                                    @if (Model.IsEnabled)
                                    {
                                        <i class="bi bi-check-circle-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-pause-circle-fill"></i>
                                    }

                                </div>


                                <div class="backup-enable-content">

                                    <strong>
                                        Automatic Backup
                                    </strong>

                                    <small>
                                        Enable automatic database backup on this client system.
                                    </small>

                                </div>


                                <div class="form-check form-switch">

                                    <input class="form-check-input backup-switch"
                                           type="checkbox"
                                           @bind="Model.IsEnabled" />

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ================= BUTTONS ================= -->

                <div class="backup-actions">

                    <button type="button"
                            class="btn backup-btn-secondary"
                            @onclick="Reset">

                        <i class="bi bi-arrow-counterclockwise"></i>

                        Reset

                    </button>


                    <button type="button"
                            class="btn backup-btn-primary"
                            disabled="@IsSaving"
                            @onclick="Save">

                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>

                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-1"></i>

                            <span>Save Settings</span>
                        }

                    </button>


                    <button type="button"
                            class="btn backup-btn-success"
                            disabled="@IsBackingUp"
                            @onclick="BackupNow">

                        @if (IsBackingUp)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>

                            <span>Backing Up...</span>
                        }
                        else
                        {
                            <i class="bi bi-database-fill-up me-1"></i>

                            <span>Backup Now</span>
                        }

                    </button>

                </div>

            </div>

        </div>

    </div>
     

    <style>

